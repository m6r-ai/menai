; Tests for pptx-decode.menai

(let ((pptx-decode (import "pptx-decode"))
      (pptx-encode (import "pptx-encode"))
      (zip-create (import "zip-create"))
      (t (import "menai-test")))
  (let* ((decode (:: pptx-decode decode))
        (encode (:: pptx-encode encode))
        (create (:: zip-create create))
        (assert-equal (:: t assert-equal))
        (expect-pass (:: t expect-pass))
        (expect-fail (:: t expect-fail))
        (main-ns "http://schemas.openxmlformats.org/presentationml/2006/main")
        (rels-ns "http://schemas.openxmlformats.org/package/2006/relationships")
        (slide-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide")
        (image-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/image")
        (presentation-xml
         (string->bytes
           (string-concat
             "<p:presentation xmlns:p=\""
             main-ns
             "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
             "<p:sldIdLst>"
             "<p:sldId id=\"256\" r:id=\"rId2\"/>"
             "<p:sldId id=\"257\" r:id=\"rId3\"/>"
             "</p:sldIdLst></p:presentation>")))
        (presentation-rels-xml
         (string->bytes
           (string-concat
             "<Relationships xmlns=\""
             rels-ns
             "\"><Relationship Id=\"rId2\" Type=\""
             slide-rel
             "\" Target=\"slides/slide1.xml\"/>"
             "<Relationship Id=\"rId3\" Type=\""
             slide-rel
             "\" Target=\"slides/slide2.xml\"/></Relationships>")))
        (slide-xml (string->bytes (string-concat "<p:sld xmlns:p=\"" main-ns "\"><p:cSld/></p:sld>")))
        (slide1-rels-xml
         (string->bytes
           (string-concat
             "<Relationships xmlns=\""
             rels-ns
             "\"><Relationship Id=\"rId1\" Type=\""
             image-rel
             "\" Target=\"../media/image1.png\"/></Relationships>")))
        (theme-xml (string->bytes (string-concat "<a:theme xmlns:a=\"" main-ns "\"/>")))
        (master-xml (string->bytes (string-concat "<p:sldMaster xmlns:p=\"" main-ns "\"/>")))
        (layout-xml (string->bytes (string-concat "<p:sldLayout xmlns:p=\"" main-ns "\"/>")))
        (media-bytes (string-hex->bytes "89504e470d0a1a0a"))
        (package-of
         (lambda (parts)
           (create (dict "entries"
                         (map-list (lambda (p) (dict "name" (list-first p) "content" (list-nth p 1)))
                                   parts)
                         "meta" (dict)))))
        (presentation-empty-xml
         (string->bytes (string-concat "<p:presentation xmlns:p=\"" main-ns "\"/>")))
        (presentation-one-slide-xml
         (string->bytes
           (string-concat
             "<p:presentation xmlns:p=\"" main-ns
             "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
             "<p:sldIdLst><p:sldId id=\"256\" r:id=\"rId2\"/></p:sldIdLst></p:presentation>")))
        (minimal (create (dict "entries"
                               (list (dict "name" "ppt/presentation.xml" "content" presentation-empty-xml))
                               "meta" (dict))))
        (full
         (create (dict "entries"
                       (list
                         (dict "name" "ppt/presentation.xml" "content" presentation-xml)
                         (dict "name" "ppt/_rels/presentation.xml.rels" "content" presentation-rels-xml)
                         (dict "name" "ppt/slides/slide1.xml" "content" slide-xml)
                         (dict "name" "ppt/slides/slide2.xml" "content" slide-xml)
                         (dict "name" "ppt/slides/_rels/slide1.xml.rels" "content" slide1-rels-xml)
                         (dict "name" "ppt/slideMasters/slideMaster1.xml" "content" master-xml)
                         (dict "name" "ppt/slideLayouts/slideLayout1.xml" "content" layout-xml)
                         (dict "name" "ppt/theme/theme1.xml" "content" theme-xml)
                         (dict "name" "ppt/media/image1.png" "content" media-bytes))
                       "meta" (dict))))
        (out-of-order
         (package-of
           (list
             (list "ppt/presentation.xml"
                   (string->bytes
                     (string-concat
                       "<p:presentation xmlns:p=\"" main-ns
                       "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
                       "<p:sldIdLst><p:sldId id=\"256\" r:id=\"rId2\"/></p:sldIdLst></p:presentation>")))
             (list "ppt/_rels/presentation.xml.rels"
                   (string->bytes
                     (string-concat
                       "<Relationships xmlns=\"" rels-ns "\"><Relationship Id=\"rId2\" Type=\""
                       slide-rel "\" Target=\"slides/slide2.xml\"/></Relationships>")))
             (list "ppt/slides/slide1.xml" slide-xml)
             (list "ppt/slides/slide2.xml" slide-xml))))
        (with-mode
         (package-of
           (list
             (list "ppt/presentation.xml" presentation-one-slide-xml)
             (list "ppt/_rels/presentation.xml.rels"
                   (string->bytes
                     (string-concat
                       "<Relationships xmlns=\"" rels-ns "\"><Relationship Id=\"rId2\" Type=\""
                     slide-rel "\" Target=\"slides/slide1.xml\" TargetMode=\"External\"/></Relationships>")))
           (list "ppt/slides/slide1.xml" slide-xml)))))
    (let ((tests
      (list
        (list "package"
          (list
            (expect-pass "presentation part is decoded"
                         (lambda ()
                           (assert-equal (dict-get (decode full) "presentation")
                                         (dict "tag" "p:presentation"
                                               "attrs" (dict "xmlns:p" main-ns
                                                             "xmlns:r" "http://schemas.openxmlformats.org/officeDocument/2006/relationships")
                                               "children" (list (dict "tag" "p:sldIdLst"
                                                                      "attrs" (dict)
                                                                      "children" (list (dict "tag" "p:sldId"
                                                                                             "attrs" (dict "id" "256" "r:id" "rId2")
                                                                                             "children" (list))
                                                                                       (dict "tag" "p:sldId"
                                                                                             "attrs" (dict "id" "257" "r:id" "rId3")
                                                                                             "children" (list)))))))))))
            (expect-pass "slides is empty when there is no slide list"
                         (lambda ()
                           (assert-equal (dict-get (decode minimal) "slides") (list))))
            (expect-pass "theme is #none when absent"
                         (lambda () (assert-equal (dict-get (decode minimal) "theme") #none)))
            (expect-pass "media is #none when absent"
                         (lambda () (assert-equal (dict-get (decode minimal) "media") #none)))
            (expect-pass "relationships is empty when absent"
                         (lambda () (assert-equal (dict-get (decode minimal) "relationships") (dict))))
            (expect-pass "slide-masters is empty when absent"
                         (lambda () (assert-equal (dict-get (decode minimal) "slide-masters") (list))))
            (expect-pass "slide-layouts is empty when absent"
                         (lambda () (assert-equal (dict-get (decode minimal) "slide-layouts") (list))))
        (list "slides"
          (list
            (expect-pass "slides are in presentation order"
                         (lambda ()
                           (assert-equal (map-list (lambda (s) (dict-get s "part"))
                                                   (dict-get (decode full) "slides"))
                                         (list "ppt/slides/slide1.xml" "ppt/slides/slide2.xml"))))
            (expect-pass "a slide carries its decoded element"
                         (lambda ()
                           (assert-equal (dict-get (dict-get (list-first (dict-get (decode full) "slides")) "element") "tag")
                                         "p:sld")))
            (expect-pass "a slide carries its own relationships"
                         (lambda ()
                           (assert-equal (dict-get (dict-get (list-first (dict-get (decode full) "slides")) "relationships") "rId1")
                                         (dict "type" image-rel "target" "../media/image1.png" "mode" #none))))
            (expect-pass "a slide with no relationships part has an empty map"
                         (lambda ()
                           (assert-equal (dict-get (list-nth (dict-get (decode full) "slides") 1) "relationships")
                                         (dict))))
            (expect-pass "slide order follows the slide list, not the part names"
                         (lambda ()
                           (assert-equal (map-list (lambda (s) (dict-get s "part"))
                                                   (dict-get (decode out-of-order) "slides"))
                                         (list "ppt/slides/slide2.xml"))))))
        (list "optional-parts"
          (list
            (expect-pass "theme is decoded when present"
                         (lambda () (assert-equal (dict-get (dict-get (decode full) "theme") "tag") "a:theme")))
            (expect-pass "slide masters are decoded"
                         (lambda () (assert-equal (dict-get (list-first (dict-get (decode full) "slide-masters")) "tag")
                                                   "p:sldMaster")))
            (expect-pass "slide layouts are decoded"
                         (lambda () (assert-equal (dict-get (list-first (dict-get (decode full) "slide-layouts")) "tag")
                                                   "p:sldLayout")))
            (expect-pass "media is decoded to a dict of bytes"
                         (lambda () (assert-equal (dict-get (dict-get (decode full) "media") "ppt/media/image1.png")
                                                  media-bytes)))))
        (list "relationships"
          (list
            (expect-pass "relationship id maps to a relationship dict"
                         (lambda ()
                           (assert-equal (dict-get (dict-get (decode full) "relationships") "rId2")
                                         (dict "type" slide-rel "target" "slides/slide1.xml" "mode" #none))))
            (expect-pass "relationship target mode is preserved"
                         (lambda ()
                           (assert-equal (dict-get (dict-get (dict-get (decode with-mode) "relationships") "rId2") "mode")
                                         "External")))))
        (list "round-trips"
          (list
            (expect-pass "minimal package"
                         (lambda () (assert-equal (decode (encode (decode minimal))) (decode minimal))))
            (expect-pass "package with all parts"
                         (lambda () (assert-equal (decode (encode (decode full))) (decode full))))))
        (list "errors"
          (list
            (expect-fail "rejects a non-bytes argument"
                         (lambda () (decode "not a package"))
                         "expects a bytes value")
            (expect-fail "rejects a package with no presentation part"
                         (lambda () (decode (package-of (list (list "[Content_Types].xml"
                                                                   (string->bytes "<Types/>"))))))
                         "package has no ppt/presentation.xml")
            (expect-fail "rejects a package whose presentation is not XML"
                         (lambda () (decode (package-of (list (list "ppt/presentation.xml"
                                                                   (string->bytes "not xml"))))))
                         "xml-decode"))))))
      (export tests))))
