; Tests for pptx-decode.menai

(letrec
  ((pptx-decode (import "pptx-decode"))
   (pptx-encode (import "pptx-encode"))
   (zip-create (import "zip-create"))
   (t (import "menai-test"))
   (decode (:: pptx-decode decode))
   (encode (:: pptx-encode encode))
   (create (:: zip-create create))
   (assert-equal (:: t assert-equal))
   (expect-pass (:: t expect-pass))
   (expect-fail (:: t expect-fail))

   (main-ns "http://schemas.openxmlformats.org/presentationml/2006/main")
   (rels-ns "http://schemas.openxmlformats.org/package/2006/relationships")
   (slide-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide")
   (image-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/image")

   (presentation-xml
    (string->bytes
      (string-concat
        "<p:presentation xmlns:p=\""
        main-ns
        "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
        "<p:sldIdLst>"
        "<p:sldId id=\"256\" r:id=\"rId2\"/>"
        "<p:sldId id=\"257\" r:id=\"rId3\"/>"
        "</p:sldIdLst></p:presentation>")))

   (presentation-rels-xml
    (string->bytes
      (string-concat
        "<Relationships xmlns=\""
        rels-ns
        "\"><Relationship Id=\"rId2\" Type=\""
        slide-rel
        "\" Target=\"slides/slide1.xml\"/>"
        "<Relationship Id=\"rId3\" Type=\""
        slide-rel
        "\" Target=\"slides/slide2.xml\"/></Relationships>")))

   (slide-xml (string->bytes (string-concat "<p:sld xmlns:p=\"" main-ns "\"><p:cSld/></p:sld>")))

   (slide1-rels-xml
    (string->bytes
      (string-concat
        "<Relationships xmlns=\""
        rels-ns
        "\"><Relationship Id=\"rId1\" Type=\""
        image-rel
        "\" Target=\"../media/image1.png\"/></Relationships>")))

   (theme-xml (string->bytes (string-concat "<a:theme xmlns:a=\"" main-ns "\"/>")))
   (master-xml (string->bytes (string-concat "<p:sldMaster xmlns:p=\"" main-ns "\"/>")))
   (layout-xml (string->bytes (string-concat "<p:sldLayout xmlns:p=\"" main-ns "\"/>")))
   (media-bytes (string-hex->bytes "89504e470d0a1a0a"))

   (presentation-empty-xml
    (string->bytes (string-concat "<p:presentation xmlns:p=\"" main-ns "\"/>")))

   (presentation-one-slide-xml
    (string->bytes
      (string-concat
        "<p:presentation xmlns:p=\"" main-ns
        "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
        "<p:sldIdLst><p:sldId id=\"256\" r:id=\"rId2\"/></p:sldIdLst></p:presentation>")))

   ; Build a package from a list of (part-name content) pairs, with no metadata.
   (package-of
    (lambda (parts)
      (create (dict "entries"
                    (map-list (lambda (p) (dict "name" (list-first p) "content" (list-nth p 1)))
                              parts)
                    "meta" (dict)))))

   (minimal (create (dict "entries"
                          (list (dict "name" "ppt/presentation.xml" "content" presentation-empty-xml))
                          "meta" (dict))))

   (full
    (create (dict "entries"
                  (list
                    (dict "name" "ppt/presentation.xml" "content" presentation-xml)
                    (dict "name" "ppt/_rels/presentation.xml.rels" "content" presentation-rels-xml)
                    (dict "name" "ppt/slides/slide1.xml" "content" slide-xml)
                    (dict "name" "ppt/slides/slide2.xml" "content" slide-xml)
                    (dict "name" "ppt/slides/_rels/slide1.xml.rels" "content" slide1-rels-xml)
                    (dict "name" "ppt/slideMasters/slideMaster1.xml" "content" master-xml)
                    (dict "name" "ppt/slideLayouts/slideLayout1.xml" "content" layout-xml)
                    (dict "name" "ppt/theme/theme1.xml" "content" theme-xml)
                    (dict "name" "ppt/media/image1.png" "content" media-bytes))
                  "meta" (dict))))

   (out-of-order
    (package-of
      (list
        (list "ppt/presentation.xml"
              (string->bytes
                (string-concat
                  "<p:presentation xmlns:p=\"" main-ns
                  "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
                  "<p:sldIdLst><p:sldId id=\"256\" r:id=\"rId2\"/></p:sldIdLst></p:presentation>")))
        (list "ppt/_rels/presentation.xml.rels"
              (string->bytes
                (string-concat
                  "<Relationships xmlns=\"" rels-ns "\"><Relationship Id=\"rId2\" Type=\""
                  slide-rel "\" Target=\"slides/slide2.xml\"/></Relationships>")))
        (list "ppt/slides/slide1.xml" slide-xml)
        (list "ppt/slides/slide2.xml" slide-xml))))

   (with-mode
    (package-of
      (list
        (list "ppt/presentation.xml" presentation-one-slide-xml)
        (list "ppt/_rels/presentation.xml.rels"
              (string->bytes
                (string-concat
                  "<Relationships xmlns=\"" rels-ns "\"><Relationship Id=\"rId2\" Type=\""
                  slide-rel "\" Target=\"slides/slide1.xml\" TargetMode=\"External\"/></Relationships>")))
        (list "ppt/slides/slide1.xml" slide-xml))))

   ; The presentation part is decoded as the xml-decode element tree of ppt/presentation.xml.
   (test-presentation-part
    (lambda ()
      (assert-equal (dict-get (decode full) "presentation")
                    (dict "tag" "p:presentation"
                          "attrs" (dict "xmlns:p" main-ns
                                        "xmlns:r" "http://schemas.openxmlformats.org/officeDocument/2006/relationships")
                          "children" (list (dict "tag" "p:sldIdLst"
                                                 "attrs" (dict)
                                                 "children" (list (dict "tag" "p:sldId"
                                                                        "attrs" (dict "id" "256" "r:id" "rId2")
                                                                        "children" (list))
                                                                  (dict "tag" "p:sldId"
                                                                        "attrs" (dict "id" "257" "r:id" "rId3")
                                                                        "children" (list)))))))))

   ; A presentation with no slide list yields an empty slides list.
   (test-slides-empty
    (lambda ()
      (assert-equal (dict-get (decode minimal) "slides") (list))))

   ; theme is #none when the package has no theme part.
   (test-theme-absent
    (lambda ()
      (assert-equal (dict-get (decode minimal) "theme") #none)))

   ; media is #none when the package has no media parts.
   (test-media-absent
    (lambda ()
      (assert-equal (dict-get (decode minimal) "media") #none)))

   ; relationships is an empty map when the package has no presentation relationships part.
   (test-relationships-absent
    (lambda ()
      (assert-equal (dict-get (decode minimal) "relationships") (dict))))

   ; slide-masters is empty when the package has no slide master parts.
   (test-slide-masters-absent
    (lambda ()
      (assert-equal (dict-get (decode minimal) "slide-masters") (list))))

   ; slide-layouts is empty when the package has no slide layout parts.
   (test-slide-layouts-absent
    (lambda ()
      (assert-equal (dict-get (decode minimal) "slide-layouts") (list))))

   ; Slides appear in presentation order, not part-name order.
   (test-slides-in-presentation-order
    (lambda ()
      (assert-equal (map-list (lambda (s) (dict-get s "part"))
                              (dict-get (decode full) "slides"))
                    (list "ppt/slides/slide1.xml" "ppt/slides/slide2.xml"))))

   ; Each slide carries its decoded slide element.
   (test-slide-carries-element
    (lambda ()
      (assert-equal (dict-get (dict-get (list-first (dict-get (decode full) "slides")) "element") "tag")
                    "p:sld")))

   ; A slide carries the relationships from its own rels part.
   (test-slide-carries-relationships
    (lambda ()
      (assert-equal (dict-get (dict-get (list-first (dict-get (decode full) "slides")) "relationships") "rId1")
                    (dict "type" image-rel "target" "../media/image1.png" "mode" #none))))

   ; A slide with no rels part has an empty relationship map.
   (test-slide-without-relationships
    (lambda ()
      (assert-equal (dict-get (list-nth (dict-get (decode full) "slides") 1) "relationships")
                    (dict))))

   ; Slide order follows the presentation slide list, not the slide part names.
   (test-slide-order-follows-list
    (lambda ()
      (assert-equal (map-list (lambda (s) (dict-get s "part"))
                              (dict-get (decode out-of-order) "slides"))
                    (list "ppt/slides/slide2.xml"))))

   ; theme is decoded as an element tree when present.
   (test-theme-decoded
    (lambda ()
      (assert-equal (dict-get (dict-get (decode full) "theme") "tag") "a:theme")))

   ; Slide masters are decoded in order.
   (test-slide-masters-decoded
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (decode full) "slide-masters")) "tag")
                    "p:sldMaster")))

   ; Slide layouts are decoded in order.
   (test-slide-layouts-decoded
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (decode full) "slide-layouts")) "tag")
                    "p:sldLayout")))

   ; media is decoded to a dict mapping each media part name to its bytes.
   (test-media-decoded
    (lambda ()
      (assert-equal (dict-get (dict-get (decode full) "media") "ppt/media/image1.png")
                    media-bytes)))

   ; Each relationship id maps to a dict carrying its type, target, and mode.
   (test-relationship-maps-to-dict
    (lambda ()
      (assert-equal (dict-get (dict-get (decode full) "relationships") "rId2")
                    (dict "type" slide-rel "target" "slides/slide1.xml" "mode" #none))))

   ; A relationship's target mode is preserved when present.
   (test-relationship-mode-preserved
    (lambda ()
      (assert-equal (dict-get (dict-get (dict-get (decode with-mode) "relationships") "rId2") "mode")
                    "External")))

   ; A minimal package round-trips through decode then encode then decode unchanged.
   (test-round-trip-minimal
    (lambda ()
      (assert-equal (decode (encode (decode minimal))) (decode minimal))))

   ; A package with every part round-trips through decode then encode then decode unchanged.
   (test-round-trip-full
    (lambda ()
      (assert-equal (decode (encode (decode full))) (decode full))))

   ; A non-bytes argument is rejected.
   (test-rejects-non-bytes
    (lambda ()
      (decode "not a package")))

   ; A package with no presentation part is rejected.
   (test-rejects-no-presentation
    (lambda ()
      (decode (package-of (list (list "[Content_Types].xml"
                                      (string->bytes "<Types/>")))))))

   ; A presentation part that is not valid XML is rejected.
   (test-rejects-non-xml-presentation
    (lambda ()
      (decode (package-of (list (list "ppt/presentation.xml"
                                      (string->bytes "not xml")))))))

   (tests
    (list
      (list "package"
        (list
          (expect-pass "presentation part is decoded" test-presentation-part)
          (expect-pass "slides is empty when there is no slide list" test-slides-empty)
          (expect-pass "theme is #none when absent" test-theme-absent)
          (expect-pass "media is #none when absent" test-media-absent)
          (expect-pass "relationships is empty when absent" test-relationships-absent)
          (expect-pass "slide-masters is empty when absent" test-slide-masters-absent)
          (expect-pass "slide-layouts is empty when absent" test-slide-layouts-absent)))

      (list "slides"
        (list
          (expect-pass "slides are in presentation order" test-slides-in-presentation-order)
          (expect-pass "a slide carries its decoded element" test-slide-carries-element)
          (expect-pass "a slide carries its own relationships" test-slide-carries-relationships)
          (expect-pass "a slide with no relationships part has an empty map" test-slide-without-relationships)
          (expect-pass "slide order follows the slide list, not the part names" test-slide-order-follows-list)))

      (list "optional-parts"
        (list
          (expect-pass "theme is decoded when present" test-theme-decoded)
          (expect-pass "slide masters are decoded" test-slide-masters-decoded)
          (expect-pass "slide layouts are decoded" test-slide-layouts-decoded)
          (expect-pass "media is decoded to a dict of bytes" test-media-decoded)))

      (list "relationships"
        (list
          (expect-pass "relationship id maps to a relationship dict" test-relationship-maps-to-dict)
          (expect-pass "relationship target mode is preserved" test-relationship-mode-preserved)))

      (list "round-trips"
        (list
          (expect-pass "minimal package" test-round-trip-minimal)
          (expect-pass "package with all parts" test-round-trip-full)))

      (list "errors"
        (list
          (expect-fail "rejects a non-bytes argument" test-rejects-non-bytes "expects a bytes value")
          (expect-fail "rejects a package with no presentation part" test-rejects-no-presentation "package has no ppt/presentation.xml")
          (expect-fail "rejects a package whose presentation is not XML" test-rejects-non-xml-presentation "xml-decode"))))))

  (export tests))
