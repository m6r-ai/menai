      (tests
         (list
           (list "decode"
                 (list
                   (expect-pass "fixture-grey-24x16" test-fixture-grey-24x16)
                   (expect-pass "fixture-grey-11x9" test-fixture-grey-11x9)
                   (expect-pass "fixture-grey-quant-4" test-fixture-grey-quant-4)
                   (expect-pass "fixture-colour-444-neutral" test-fixture-colour-444-neutral)
                   (expect-pass "fixture-colour-444" test-fixture-colour-444)
                   (expect-pass "fixture-colour-420" test-fixture-colour-420)
                   (expect-pass "fixture-gradient-444" test-fixture-gradient-444)
                   (expect-pass "fixture-gradient-420" test-fixture-gradient-420)))
           (list "rejects"
                 (list
                   (expect-fail
                     "fixture-progressive"
                     (lambda () (decode fixture-progressive))
                     "progressive")
                   (expect-fail
                     "fixture-arithmetic"
                     (lambda () (decode fixture-arithmetic))
                     "arithmetic-coded sequential")
                   (expect-fail
                     "fixture-twelve-bit"
                     (lambda () (decode fixture-twelve-bit))
                     "bits per sample is not supported"))))))

  (export tests))
