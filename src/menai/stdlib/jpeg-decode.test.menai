; Tests for jpeg-decode.menai
;
; Each image fixture is a baseline sequential file whose every block has only a DC
; coefficient, so a correct decode is a flat 8x8 block of sample value
; round(DC / (8 * quantisation)) + 128.  The expected pixels were taken from libjpeg
; (via Pillow) so that the suite is an independent specification.

(let ((jpeg (import "jpeg-decode"))
      (t (import "menai-test"))
      (decode (:: jpeg decode))
      (assert-equal (:: t assert-equal))
      (expect-pass (:: t expect-pass))
      (expect-fail (:: t expect-fail))
      (channels
       (lambda (pixels)
         (fold-vector
           list-concat
           (list)
           (map-vector
             (lambda (row) (fold-vector list-concat (list) (map-vector vector->list row)))
             pixels))))
      (assert-within
       (lambda (tolerance actual expected)
         (if (all-list?
               (lambda (pair)
                 (integer<=?
                   (integer-abs (integer- (list-nth pair 0) (list-nth pair 1)))
                   tolerance))
               (list-zip actual expected))
             #t
             (error "assert-within failed: a channel differs by more than the tolerance"))))


