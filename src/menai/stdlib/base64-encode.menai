; base64-encode — encodes a bytes value as Base64 text (RFC 4648).
;
; The input is a bytes value and the output is a string.  The output is a single
; unbroken line with no line breaks.
;
; The optional second argument is a `variant` enum value selecting the alphabet
; and the padding:
;
;   (variant 'standard)          — standard alphabet (+, /), padded with "="
;   (variant 'standard-unpadded) — standard alphabet, no padding
;   (variant 'url)               — URL-safe alphabet (-, _), padded with "="
;   (variant 'url-unpadded)      — URL-safe alphabet, no padding
;
; It defaults to (variant 'standard).  RFC 4648 defines these four forms: the
; standard alphabet in section 4 and the URL-safe alphabet in section 5, each of
; which may be padded or unpadded.
;
; It is the inverse of base64-decode's decode: for every bytes value b and every
; variant v, (decode (encode b v) v) reproduces b.
;
; The alphabet is held as bytes, so a character is looked up with `bytes-nth` and
; arrives as an integer; the encoded characters are accumulated as those integers
; and converted to text once, so no per-character string is built.
;
; The first argument must be a bytes value and the second, when present, must be
; a variant value; anything else raises a runtime error.

(let ((standard-alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
      (url-alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")

      ; The alphabet and padding to emit: the standard alphabet with or without
      ; padding, or the URL-safe alphabet with or without padding.
      (variant (enum (standard standard-unpadded url url-unpadded)))

      (standard-bytes (string->bytes standard-alphabet))
      (url-bytes (string->bytes url-alphabet))

      ; The code of the "=" padding character.
      (equals-code 61)

      ; The 64-character alphabet for a variant, as byte values.
      (alphabet-for
       (lambda (v)
         (match v
           ((: variant 'standard) standard-bytes)
           ((: variant 'standard-unpadded) standard-bytes)
           ((: variant 'url) url-bytes)
           ((: variant 'url-unpadded) url-bytes))))

      ; Whether a variant emits "=" padding.
      (padded?
       (lambda (v)
         (match v
           ((: variant 'standard) #t)
           ((: variant 'standard-unpadded) #f)
           ((: variant 'url) #t)
           ((: variant 'url-unpadded) #f))))

      ; Prepend one "=" padding character to a reversed accumulator when the
      ; variant pads; a variant that does not pad gets none.
      (prepend-equals
       (lambda (acc pad)
         (if pad
             (list-prepend acc equals-code)
             acc)))

      ; Prepend one 24-bit group (three input bytes) as four character codes:
      ; six bits from each byte, carried across the boundaries.
      (prepend-group
       (lambda (acc alphabet b0 b1 b2)
         (let ((c1 (bytes-nth alphabet (integer-bit-and (integer-bit-shift-right b0 2) #x3f)))

               (c2
                (bytes-nth
                  alphabet
                  (integer-bit-and (integer-bit-or (integer-bit-shift-left b0 4) (integer-bit-shift-right b1 4)) #x3f)))

               (c3
                (bytes-nth
                  alphabet
                  (integer-bit-and (integer-bit-or (integer-bit-shift-left b1 2) (integer-bit-shift-right b2 6)) #x3f)))

               (c4 (bytes-nth alphabet (integer-bit-and b2 #x3f))))
           (list-prepend (list-prepend (list-prepend (list-prepend acc c1) c2) c3) c4))))

      ; Prepend a trailing group of one byte as two character codes.
      (prepend-final-one
       (lambda (acc alphabet b0)
         (let ((c1 (bytes-nth alphabet (integer-bit-and (integer-bit-shift-right b0 2) #x3f)))
               (c2 (bytes-nth alphabet (integer-bit-and (integer-bit-shift-left b0 4) #x3f))))
           (list-prepend (list-prepend acc c1) c2))))

      ; Prepend a trailing group of two bytes as three character codes.
      (prepend-final-two
       (lambda (acc alphabet b0 b1)
         (let ((c1 (bytes-nth alphabet (integer-bit-and (integer-bit-shift-right b0 2) #x3f)))

               (c2
                (bytes-nth
                  alphabet
                  (integer-bit-and (integer-bit-or (integer-bit-shift-left b0 4) (integer-bit-shift-right b1 4)) #x3f)))

               (c3 (bytes-nth alphabet (integer-bit-and (integer-bit-shift-left b1 2) #x3f))))
           (list-prepend (list-prepend (list-prepend acc c1) c2) c3))))

      ; Encode a bytes value as Base64 text.  It is the inverse of
      ; base64-decode's decode.
      ;
      ; The optional second argument selects the alphabet and padding and defaults
      ; to (variant 'standard).
      (encode
       (lambda (b . rest)
         (let ((v
                (if (list-null? rest)
                    (variant 'standard)
                    (list-first rest)))

               (alphabet (alphabet-for v))
               (pad (padded? v))
               (n (bytes-length b)))
           (let ((loop
                  (lambda (i acc)
                    (if (integer>=? i n)
                        (bytes->string (list->bytes (list-reverse acc)))
                        (let ((remaining (integer- n i)))
                          (if (integer>=? remaining 3)
                              (loop
                                (integer+ i 3)
                                (prepend-group
                                  acc
                                  alphabet
                                  (bytes-nth b i)
                                  (bytes-nth b (integer+ i 1))
                                  (bytes-nth b (integer+ i 2))))
                              (if (integer=? remaining 2)
                                  (loop
                                    n
                                    (prepend-equals
                                      (prepend-final-two acc alphabet (bytes-nth b i) (bytes-nth b (integer+ i 1)))
                                      pad))
                                  (loop
                                    n
                                    (prepend-equals
                                      (prepend-equals (prepend-final-one acc alphabet (bytes-nth b i)) pad)
                                      pad)))))))))
             (loop 0 (list)))))))

  (export encode variant))
