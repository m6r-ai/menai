; Tests for json-decode.menai

(let ((json (import "json-decode"))
      (t (import "menai-test"))
      (decode (:: json decode))
      (assert-equal (:: t assert-equal))
      (expect-pass (:: t expect-pass))
      (expect-fail (:: t expect-fail))

      ; An empty object decodes to an empty dict.
      (test-empty-object
       (lambda ()
         (assert-equal (decode "{}") (dict))))

      ; An object with a single key decodes to a one-entry dict.
      (test-single-key
       (lambda ()
         (assert-equal (decode "{\"a\": 1}") (dict "a" 1))))

      ; A nested object decodes to a nested dict.
      (test-nested-object
       (lambda ()
         (assert-equal (decode "{\"a\": {\"b\": 2}}") (dict "a" (dict "b" 2)))))

      ; An empty array decodes to an empty list.
      (test-empty-array
       (lambda ()
         (assert-equal (decode "[]") (list))))

      ; An integer array decodes to a list of integers.
      (test-integer-array
       (lambda ()
         (assert-equal (decode "[1, 2, 3]") (list 1 2 3))))

      ; A nested array decodes to a nested list.
      (test-nested-array
       (lambda ()
         (assert-equal (decode "[[1, 2], [3, 4]]") (list (list 1 2) (list 3 4)))))

      ; An empty string decodes to the empty string.
      (test-empty-string
       (lambda ()
         (assert-equal (decode "\"\"") "")))

      ; A simple string decodes to itself.
      (test-simple-string
       (lambda ()
         (assert-equal (decode "\"hello\"") "hello")))

      ; A newline escape decodes to a newline.
      (test-escape-newline
       (lambda ()
         (assert-equal (decode "\"\\n\"") "\n")))

      ; A tab escape decodes to a tab.
      (test-escape-tab
       (lambda ()
         (assert-equal (decode "\"\\t\"") "\t")))

      ; A unicode escape decodes to the character it names.
      (test-escape-unicode
       (lambda ()
         (assert-equal (decode "\"\\u0041\"") "A")))

      ; A surrogate pair of unicode escapes decodes to the single character
      ; above U+FFFF that the pair encodes.
      (test-escape-surrogate-pair
       (lambda ()
         (assert-equal (decode "\"\\ud83d\\ude00\"") (integer-codepoint->string 128512))))

      ; A high surrogate that is not followed by a low surrogate escape is
      ; malformed and raises.
      (test-escape-unpaired-high-surrogate
       (lambda ()
         (decode "\"\\ud83d\"")))

      ; A high surrogate followed by a non-surrogate escape is malformed and raises.
      (test-escape-high-surrogate-then-bmp
       (lambda ()
         (decode "\"\\ud83d\\u0041\"")))

      ; A low surrogate that is not preceded by a high surrogate is malformed
      ; and raises.
      (test-escape-unpaired-low-surrogate
       (lambda ()
         (decode "\"\\ude00\"")))

      ; An integer decodes to an integer.
      (test-integer
       (lambda ()
         (assert-equal (decode "42") 42)))

      ; A negative integer decodes to a negative integer.
      (test-negative-integer
       (lambda ()
         (assert-equal (decode "-7") -7)))

      ; A float decodes to a float.
      (test-float
       (lambda ()
         (assert-equal (decode "3.14") 3.14)))

      ; true decodes to #t.
      (test-true
       (lambda ()
         (assert-equal (decode "true") #t)))

      ; false decodes to #f.
      (test-false
       (lambda ()
         (assert-equal (decode "false") #f)))

      ; null decodes to #none.
      (test-null
       (lambda ()
         (assert-equal (decode "null") #none)))

      ; An escape after literal text preserves both parts.
      (test-literal-then-escape
       (lambda ()
         (assert-equal (decode "\"abc\\n\"") "abc\n")))

      ; The single-character escapes other than newline, tab, and unicode.
      (test-escapes-simple
       (lambda ()
         (assert-equal
           (list
             (decode "\"\\\"\"")
             (decode "\"\\\\\"")
             (decode "\"\\/\"")
             (decode "\"\\b\"")
             (decode "\"\\f\"")
             (decode "\"\\r\""))
           (list "\"" "\\" "/" (integer-codepoint->string 8) (integer-codepoint->string 12) "\r"))))

      ; A string that ends before its closing quote is malformed.
      (test-unterminated-string
       (lambda ()
         (decode "\"abc")))

      ; A string that ends immediately after a unicode escape is malformed.
      (test-unterminated-after-unicode
       (lambda ()
         (decode (string-concat "\"" (integer-codepoint->string 92) "u0041"))))

      ; A string that ends immediately after a simple escape is malformed.
      (test-unterminated-after-escape
       (lambda ()
         (decode "\"abc\\n")))

      ; A string ending with a lone backslash is malformed.
      (test-unterminated-escape
       (lambda ()
         (decode "\"abc\\")))

      ; An unknown escape is malformed.
      (test-unknown-escape
       (lambda ()
         (decode "\"\\q\"")))

      ; Non-hex digits in a unicode escape are malformed.
      (test-invalid-unicode-hex
       (lambda ()
         (decode "\"\\u00zz\"")))

      ; A truncated unicode escape is malformed.
      (test-unterminated-unicode
       (lambda ()
         (decode "\"\\u00\"")))

      ; An object may have more than one key.
      (test-multi-key-object
       (lambda ()
         (assert-equal (decode "{\"a\": 1, \"b\": 2}") (dict "a" 1 "b" 2))))

      ; Whitespace around object keys, colons, commas, and braces is skipped.
      (test-object-whitespace
       (lambda ()
         (assert-equal (decode "{ \"a\" : 1 , \"b\" : 2 }") (dict "a" 1 "b" 2))))

      ; Whitespace around array elements, commas, and brackets is skipped.
      (test-array-whitespace
       (lambda ()
         (assert-equal (decode "[ 1 , 2 ]") (list 1 2))))

      ; Leading and trailing whitespace around a scalar is skipped.
      (test-scalar-whitespace
       (lambda ()
         (assert-equal (decode " \n 42 \t") 42)))

      ; A missing comma between object members is malformed.
      (test-object-missing-comma
       (lambda ()
         (decode "{\"a\": 1 \"b\": 2}")))

      ; An object that ends before its closing brace is malformed.
      (test-unterminated-object
       (lambda ()
         (decode "{\"a\": 1")))

      ; A trailing comma leaves an unterminated object.
      (test-object-trailing-comma
       (lambda ()
         (decode "{\"a\": 1,")))

      ; A key that is not followed by a colon is malformed.
      (test-object-key-without-colon
       (lambda ()
         (decode "{\"a\" 1}")))

      ; A key that is not a string is malformed.
      (test-object-non-string-key
       (lambda ()
         (decode "{1: 2}")))

      ; An array that ends before its closing bracket is malformed.
      (test-unterminated-array
       (lambda ()
         (decode "[1")))

      ; A missing comma between array elements is malformed.
      (test-array-missing-comma
       (lambda ()
         (decode "[1 2]")))

      ; An invalid character is malformed.
      (test-unexpected-character
       (lambda ()
         (decode "@")))

      ; A number literal that does not parse is malformed.
      (test-invalid-number
       (lambda ()
         (decode "1.2.3")))

      ; A truncated keyword is malformed.
      (test-truncated-keyword
       (lambda ()
         (decode "tru")))

      ; A keyword with a wrong suffix is malformed.
      (test-wrong-keyword
       (lambda ()
         (decode "trux")))

      ; An array opened at the end of input is malformed.
      (test-open-array
       (lambda ()
         (decode "[")))

      ; An object opened at the end of input is malformed.
      (test-open-object
       (lambda ()
         (decode "{")))

      ; An empty input is malformed.
      (test-empty-input
       (lambda ()
         (decode "")))

      (tests
       (list
         (list
           "objects"
           (list
             (expect-pass "empty object" test-empty-object)
             (expect-pass "single key" test-single-key)
             (expect-pass "nested object" test-nested-object)))

         (list
           "arrays"
           (list
             (expect-pass "empty array" test-empty-array)
             (expect-pass "integer array" test-integer-array)
             (expect-pass "nested array" test-nested-array)))

         (list
           "strings"
           (list
             (expect-pass "empty string" test-empty-string)
             (expect-pass "simple string" test-simple-string)
             (list
               "escapes"
               (list
                 (expect-pass "newline" test-escape-newline)
                 (expect-pass "tab" test-escape-tab)
                 (expect-pass "unicode" test-escape-unicode)
                 (expect-pass "surrogate pair" test-escape-surrogate-pair)
                 (expect-fail "unpaired high surrogate" test-escape-unpaired-high-surrogate "Unpaired high surrogate")
                 (expect-fail "high surrogate then bmp escape"
                              test-escape-high-surrogate-then-bmp
                              "Unpaired high surrogate")
                 (expect-fail "unpaired low surrogate" test-escape-unpaired-low-surrogate "Unpaired low surrogate")))))

         (list
           "numbers"
           (list
             (expect-pass "integer" test-integer)
             (expect-pass "negative integer" test-negative-integer)
             (expect-pass "float" test-float)))

         (list
           "literals"
           (list (expect-pass "true" test-true) (expect-pass "false" test-false) (expect-pass "null" test-null)))

         (list
           "edge cases"
           (list
             (expect-pass "literal text before an escape" test-literal-then-escape)
             (expect-pass "single-character escapes" test-escapes-simple)
             (expect-pass "multiple object keys" test-multi-key-object)
             (expect-pass "object whitespace" test-object-whitespace)
             (expect-pass "array whitespace" test-array-whitespace)
             (expect-pass "scalar whitespace" test-scalar-whitespace)
             (expect-fail "unterminated string" test-unterminated-string "Unterminated string literal")
             (expect-fail "unterminated after unicode" test-unterminated-after-unicode "Unterminated string literal")
             (expect-fail "unterminated after escape" test-unterminated-after-escape "Unterminated string literal")
             (expect-fail "unterminated escape" test-unterminated-escape "Unterminated escape sequence")
             (expect-fail "unknown escape" test-unknown-escape "Unknown escape sequence")
             (expect-fail "invalid unicode hex" test-invalid-unicode-hex "Invalid hex digits")
             (expect-fail "unterminated unicode" test-unterminated-unicode "Unterminated \\u escape sequence")
             (expect-fail "object missing comma" test-object-missing-comma "Expected , or } in object")
             (expect-fail "unterminated object" test-unterminated-object "Unterminated object")
             (expect-fail "object trailing comma" test-object-trailing-comma "Unterminated object")
             (expect-fail "object key without colon" test-object-key-without-colon "Expected : after object key")
             (expect-fail "object non-string key" test-object-non-string-key "Expected string key in object")
             (expect-fail "unterminated array" test-unterminated-array "Unterminated array")
             (expect-fail "array missing comma" test-array-missing-comma "Expected , or ] in array")
             (expect-fail "unexpected character" test-unexpected-character "Unexpected character in JSON")
             (expect-fail "invalid number" test-invalid-number "Invalid number literal in JSON")
             (expect-fail "truncated keyword" test-truncated-keyword "Unexpected end of input reading keyword")
             (expect-fail "wrong keyword" test-wrong-keyword "Unrecognized keyword in JSON")
             (expect-fail "open array" test-open-array "Unterminated array")
             (expect-fail "open object" test-open-object "Unterminated object")
             (expect-fail "empty input" test-empty-input "Unexpected end of JSON input"))))))

  (export tests))
