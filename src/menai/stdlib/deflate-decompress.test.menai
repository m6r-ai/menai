; Tests for deflate-decompress.menai

(let
  ((deflate-mod (import "deflate-decompress"))
   (t (import "menai-test"))
   (decompress (:: deflate-mod decompress))
   (assert-equal (:: t assert-equal))
   (expect-pass (:: t expect-pass))
   (expect-fail (:: t expect-fail))

   ; An empty stored stream decompresses to the empty bytes value.
   (test-stored-empty
    (lambda ()
      (assert-equal (decompress (string-hex->bytes "010000ffff")) (string->bytes ""))))

   ; A single-byte stored stream decompresses to that byte.
   (test-stored-single-byte
    (lambda ()
      (assert-equal (decompress (string-hex->bytes "010100feff41")) (string->bytes "A"))))

   ; A stored stream decompresses to its text.
   (test-stored-hello
    (lambda ()
      (assert-equal (decompress (string-hex->bytes "010500faff68656c6c6f")) (string->bytes "hello"))))

   ; A stored stream decompresses to "abc".
   (test-stored-abc
    (lambda ()
      (assert-equal (decompress (string-hex->bytes "010300fcff616263")) (string->bytes "abc"))))

   ; A stored stream of repeated bytes decompresses correctly.
   (test-stored-repeated-bytes
    (lambda ()
      (assert-equal (decompress (string-hex->bytes "010a00f5ff61616161616161616161")) (string->bytes "aaaaaaaaaa"))))

   ; Multiple stored blocks with an empty sync-flush block decompress correctly.
   (test-stored-multiple-blocks
    (lambda ()
      (assert-equal
        (decompress (string-hex->bytes "000500faff68656c6c6f000000ffff010500faff776f726c64"))
        (string->bytes "helloworld"))))

   ; A fixed-Huffman stream with a single literal decompresses correctly.
   (test-fixed-single-literal
    (lambda ()
      (assert-equal (decompress (string-hex->bytes "730400")) (string->bytes "A"))))

   ; A fixed-Huffman stream with a literal run and a back-reference decompresses correctly.
   (test-fixed-literal-run
    (lambda ()
      (assert-equal (decompress (string-hex->bytes "cb48cdc9c957c8409000")) (string->bytes "hello hello hello"))))

   ; A fixed-Huffman stream of a repeated pattern decompresses correctly.
   (test-fixed-repeated-pattern
    (lambda ()
      (assert-equal (decompress (string-hex->bytes "4b4c4a4e042300")) (string->bytes "abcabcabc"))))

   ; An overlapping back-reference replicates a single-byte run.
   (test-fixed-overlapping-run
    (lambda ()
      (assert-equal
        (decompress (string-hex->bytes "abaaa23d0000"))
        (string->bytes
          "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"))))

   ; An overlapping back-reference replicates a two-byte pattern.
   (test-fixed-overlapping-two-byte
    (lambda ()
      (assert-equal
        (decompress (string-hex->bytes "4b4c4aa4390400"))
        (string->bytes
          "abababababababababababababababababababababababababababababababababababababababababababababababababab"))))

   ; A fixed-Huffman stream with several back-references decompresses correctly.
   (test-fixed-several-back-references
    (lambda ()
      (assert-equal
        (decompress
          (string-hex->bytes
            "2bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a70300"))
        (string->bytes "the quick brown fox jumps over the lazy dog"))))

   ; A dynamic-Huffman stream with a skewed alphabet decompresses correctly.
   (test-dynamic-skewed-alphabet
    (lambda ()
      (assert-equal
        (decompress
          (string-hex->bytes
            "0dcc090e80200c04c0b76eb70710a18209515faff38011a307d0455eed1a88b456d09c48ad59170fbd1290ad4123dd6759e329187b7a95ee82f1e050484b042af3b69770c87f21b94faa7d"))
        (string->bytes
          "becfgaambbzdmdgagoejhajfcaodioircldsoaabvdgceccffqhrnyhanvqfibmfbanyaldabjoagaicoxezcafabdgaaocvpcde"))))

   ; A dynamic-Huffman stream with zero runs exercises the repeat codes.
   (test-dynamic-zero-runs
    (lambda ()
      (assert-equal
        (decompress
          (string-hex->bytes
            ""))
        (string-hex->bytes
          ""))))

   ; A non-bytes argument is rejected.
   (test-rejects-non-bytes
    (lambda ()
      (decompress "not bytes")))

   ; Truncated input is rejected.
   (test-rejects-truncated
    (lambda ()
      (decompress (string-hex->bytes "000500faff6865"))))

   ; A stored block with mismatched LEN and NLEN is rejected.
   (test-rejects-len-mismatch
    (lambda ()
      (decompress (string-hex->bytes "010500000068656c6c6f"))))

   ; An invalid block type is rejected.
   (test-rejects-invalid-block-type
    (lambda ()
      (decompress (string-hex->bytes "07"))))

   (tests
    (list
      (list
        "stored blocks"
        (list
          (expect-pass "empty stream" test-stored-empty)
          (expect-pass "single byte" test-stored-single-byte)
          (expect-pass "hello" test-stored-hello)
          (expect-pass "abc" test-stored-abc)
          (expect-pass "run of repeated bytes" test-stored-repeated-bytes)
          (expect-pass "multiple stored blocks with an empty sync-flush block" test-stored-multiple-blocks)))

      (list
        "fixed Huffman blocks"
        (list
          (expect-pass "single literal" test-fixed-single-literal)
          (expect-pass "literal run with back-reference" test-fixed-literal-run)
          (expect-pass "repeated pattern" test-fixed-repeated-pattern)
          (expect-pass "overlapping back-reference replicates a run" test-fixed-overlapping-run)
          (expect-pass "overlapping back-reference replicates a two-byte pattern" test-fixed-overlapping-two-byte)
          (expect-pass "text with several back-references" test-fixed-several-back-references)))

      (list
        "dynamic Huffman blocks"
        (list
          (expect-pass "skewed alphabet" test-dynamic-skewed-alphabet)
          (expect-pass "zero runs exercise repeat codes" test-dynamic-zero-runs)))

      (list
        "errors"
        (list
          (expect-fail "rejects non-bytes argument" test-rejects-non-bytes "expects a bytes value")
          (expect-fail "rejects truncated input" test-rejects-truncated "unexpected end of input")
          (expect-fail "rejects stored block with mismatched LEN and NLEN"
                       test-rejects-len-mismatch
                       "LEN does not match NLEN")
          (expect-fail "rejects invalid block type" test-rejects-invalid-block-type "invalid block type"))))))

  (export tests))
