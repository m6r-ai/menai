      ; The factor that undoes the AAN scale the butterfly's two passes leave on each
      ; coefficient: the row pass multiplies frequency u by m(u) = 4 * aanscale(u),
      ; the column pass frequency v, so dividing by m(u) * m(v) restores the
      ; coefficient the DCT defines.  aanscale(u) is C(u) * cos(u * pi / 16).
      (forward-scale
       (vector 0.12500000000000003
               0.0901199777508685
               0.09567085809127246
               0.10630376184590706
               0.125
               0.15909482257160423
               0.23096988312782168
               0.45306372317644383
               0.0901199777508685
               0.06497288311853626
               0.06897484482073576
               0.07664074121909413
               0.09011997775086848
               0.11470097496345075
               0.16652000582879986
               0.32664074121909403
               0.09567085809127246
               0.06897484482073576
               0.07322330470336312
               0.08136137691302557
               0.09567085809127245
               0.12176590554643293
               0.17677669529663684
               0.34675996133053677
               0.10630376184590706
               0.07664074121909413
               0.08136137691302557
               0.09040391826073059
               0.10630376184590705
               0.13529902503654923
               0.19642373959677553
               0.3852990250365491
               0.125
               0.09011997775086848
               0.09567085809127245
               0.10630376184590705
               0.12499999999999997
               0.1590948225716042
               0.23096988312782163
               0.4530637231764438
               0.15909482257160423
               0.11470097496345075
               0.12176590554643293
               0.13529902503654923
               0.1590948225716042
               0.20248930055272182
               0.2939689006048396
               0.5766407412190938
               0.23096988312782168
               0.16652000582879986
               0.17677669529663684
               0.19642373959677553
               0.23096988312782163
               0.2939689006048396
               0.4267766952966367
               0.8371526015321518
               0.45306372317644383
               0.32664074121909403
               0.34675996133053677
               0.3852990250365491
               0.4530637231764438
               0.5766407412190938
               0.8371526015321518
               1.6421338980680102))

      ; Scale a base quantisation table for `quality` with the IJG rule, clamping
      ; each entry to 1..255.
      (scale-table
       (lambda (base scale)
         (map-vector
           (lambda (value)
             (let ((scaled (integer/ (integer+ (integer* value scale) 50) 100)))
               (if (integer<? scaled 1)
                   1
                   (if (integer>? scaled 255)
                       255
                       scaled))))
           base)))

      ; The IJG scale factor for a quality: below 50 it is 5000/quality, at or
      ; above it 200 - 2*quality.
      (scale-for
       (lambda (q)
         (if (integer<? q 50)
             (integer/ 5000 q)
             (integer- 200 (integer* 2 q)))))

      ; The canonical code and length of each symbol in a Huffman table, as a
      ; vector indexed by symbol holding (vector code length).
      (huffman-codes
       (lambda (bits values)
         (let ((fill
                (lambda (length code index n table)
                  (if (integer>=? n (vector-nth bits (integer- length 1)))
                      (next-length length code (integer+ index (vector-nth bits (integer- length 1))) table)
                      (fill
                        length
                        (integer+ code 1)
                        index
                        (integer+ n 1)
                        (vector-with table (vector-nth values (integer+ index n)) (vector code length))))))

               (next-length
                (lambda (length code index table)
                  (if (integer>=? length 16)
                      table
                      (fill (integer+ length 1) (integer-bit-shift-left code 1) index 0 table)))))
           (next-length 0 0 0 (vector-fill 256 (vector 0 0))))))

      ; The number of bits a coefficient needs (spec F.1.2.1).
      (category
       (lambda (value)
         (if (integer=? value 0)
             0
             (let ((loop
                    (lambda (magnitude bits)
                      (if (integer=? magnitude 0)
                          bits
                          (loop (integer-bit-shift-right magnitude 1) (integer+ bits 1))))))
               (loop (integer-abs value) 0)))))

      ; The `size`-bit magnitude encoding of a coefficient (spec F.1.2.1).
      (magnitude-bits
       (lambda (value size)
         (if (integer<? value 0)
             (integer- (integer+ value (integer-bit-shift-left 1 size)) 1)
             value)))

      ; The eight-point transform is the AAN butterfly: twelve multiplications
      ; where an eight-term inner product needs sixty-four.  Each output carries the
      ; scale recorded in `forward-scale`, which the quantisation step undoes, so
      ; these passes write coefficients the DCT would give divided by that scale.
      (butterfly
       (lambda (s0 s1 s2 s3 s4 s5 s6 s7)
         (let ((t0 (float+ s0 s7))
               (t7 (float- s0 s7))
               (t1 (float+ s1 s6))
               (t6 (float- s1 s6))
               (t2 (float+ s2 s5))
               (t5 (float- s2 s5))
               (t3 (float+ s3 s4))
               (t4 (float- s3 s4)))
           (let ((t10 (float+ t0 t3))
                 (t13 (float- t0 t3))
                 (t11 (float+ t1 t2))
                 (t12 (float- t1 t2)))
             (let ((z1 (float* (float+ t12 t13) 0.7071067811865476))
                   (u10 (float+ t4 t5))
                   (u11 (float+ t5 t6))
                   (u12 (float+ t6 t7)))
               (let ((z5 (float* (float- u10 u12) 0.38268343236508984))
                     (z2 (float+ (float* 0.5411961001461969 u10) z5))
                     (z4 (float+ (float* 1.3065629648763766 u12) z5))
                     (z3 (float* u11 0.7071067811865476)))
                 (vector
                   (float+ t10 t11)
                   (float+ (float+ t7 z3) z4)
                   (float+ t13 z1)
                   (float- (float- t7 z3) z2)
                   (float- t10 t11)
                   (float+ (float- t7 z3) z2)
                   (float- t13 z1)
                   (float- (float+ t7 z3) z4))))))))

      ; The row pass: butterfly each row of samples into `temp`.
      (forward-rows
       (lambda (samples y temp)
         (if (integer>=? y 8)
             temp
             (let ((b (integer* y 8)))
               (let ((out
                      (butterfly
                        (vector-nth samples b)
                        (vector-nth samples (integer+ b 1))
                        (vector-nth samples (integer+ b 2))
                        (vector-nth samples (integer+ b 3))
                        (vector-nth samples (integer+ b 4))
                        (vector-nth samples (integer+ b 5))
                        (vector-nth samples (integer+ b 6))
                        (vector-nth samples (integer+ b 7)))))
                 (forward-rows
                   samples
                   (integer+ y 1)
                   (vector-with
                     (vector-with
                       (vector-with
                         (vector-with
                           (vector-with
                             (vector-with
                               (vector-with (vector-with temp b (vector-nth out 0)) (integer+ b 1) (vector-nth out 1))
                               (integer+ b 2)
                               (vector-nth out 2))
                             (integer+ b 3)
                             (vector-nth out 3))
                           (integer+ b 4)
                           (vector-nth out 4))
                         (integer+ b 5)
                         (vector-nth out 5))
                       (integer+ b 6)
                       (vector-nth out 6))
                     (integer+ b 7)
                     (vector-nth out 7))))))))

      ; The column pass: butterfly each column of `temp`, the outputs laid down as
      ; row v of the result.
      (forward-columns
       (lambda (temp v out)
         (if (integer>=? v 8)
             out
             (let ((b (integer* v 8)))
               (let ((col
                      (butterfly
                        (vector-nth temp v)
                        (vector-nth temp (integer+ v 8))
                        (vector-nth temp (integer+ v 16))
                        (vector-nth temp (integer+ v 24))
                        (vector-nth temp (integer+ v 32))
                        (vector-nth temp (integer+ v 40))
                        (vector-nth temp (integer+ v 48))
                        (vector-nth temp (integer+ v 56)))))
                 (forward-columns
                   temp
                   (integer+ v 1)
                   (vector-with
                     (vector-with
                       (vector-with
                         (vector-with
                           (vector-with
                             (vector-with
                               (vector-with (vector-with out v (vector-nth col 0)) (integer+ 8 v) (vector-nth col 1))
                               (integer+ 16 v)
                               (vector-nth col 2))
                             (integer+ 24 v)
                             (vector-nth col 3))
                           (integer+ 32 v)
                           (vector-nth col 4))
                         (integer+ 40 v)
                         (vector-nth col 5))
                       (integer+ 48 v)
                       (vector-nth col 6))
                     (integer+ 56 v)
                     (vector-nth col 7))))))))

      ; The quantised coefficients of one block of 8-bit samples, in zigzag
      ; order, which is the order `encode-block` walks.  The samples are level
      ; shifted by 128 and transformed into natural order, then each coefficient
      ; is divided by its quantisation step and rounded.  The table is in zigzag
      ; order too, so position `p` reads `quant[p]` and writes the coefficient
      ; whose natural index is `zigzag[p]`.
      (quantise-block
       (lambda (samples quant)
         (let ((transformed
                (forward-columns
                  (forward-rows
                    (map-vector
                      (lambda (s)
                        (float- (integer->float s) 128.0))
                      samples)
                    0
                    (vector-fill 64 0.0))
                  0
                  (vector-fill 64 0.0))))
           (quantise transformed quant 0 (vector-fill 64 0)))))

      ; Fill `coefficients` with the quantised coefficient at each zigzag position.
      ;
      ; The result is the loop-carried accumulator, so each write lands in place
      ; rather than building a list to be converted afterwards.
      (quantise
       (lambda (transformed quant p coefficients)
         (if (integer>=? p 64)
             coefficients
             (quantise
               transformed
               quant
               (integer+ p 1)
               (vector-with
                 coefficients
                 p
                 (float->integer
                   (float-floor
                     (float+
                       (float/
                         (float*
                           (vector-nth transformed (vector-nth zigzag p))
                           (vector-nth forward-scale (vector-nth zigzag p)))
                         (integer->float (vector-nth quant p)))
                       0.5))))))))

      ; Append one byte to the output, stuffing a zero after an 0xFF.
      (emit-byte
       (lambda (out byte)
         (if (integer=? byte 255)
             (bytes-append-u8 (bytes-append-u8 out 255) 0)
             (bytes-append-u8 out byte))))

      ; Write `count` bits of `value`, most significant first.  `state` is
      ; (vector out acc bits), where `acc` holds `bits` pending bits.
      ; Returns the new state.
      ;
      ; The bits go out a whole byte at a time where the accumulator has room for
      ; them, so a symbol costs one step per byte it spans rather than one per bit.
      ; `remaining` counts the bits of `value` still to write and those are the low
      ; ones, so each step takes the top `space` of them and masks off what it has
      ; written; the accumulator is masked to its pending bits for the same reason.
      (put-bits
       (lambda (state value count)
         (let ((loop
                (lambda (out acc bits remaining)
                  (if (integer<=? remaining 0)
                      (vector out acc bits)
                      (if (integer<? remaining (integer- 8 bits))
                          (vector
                            out
                            (integer-bit-or
                              (integer-bit-shift-left
                                (integer-bit-and acc (integer- (integer-bit-shift-left 1 bits) 1))
                                remaining)
                              (integer-bit-and value (integer- (integer-bit-shift-left 1 remaining) 1)))
                            (integer+ bits remaining))
                          (let ((rest
                                 (integer-bit-and
                                   (integer-bit-shift-right value (integer- remaining (integer- 8 bits)))
                                   (integer- (integer-bit-shift-left 1 (integer- 8 bits)) 1))))
                            (loop
                              (emit-byte out (integer-bit-or (integer-bit-shift-left acc (integer- 8 bits)) rest))
                              0
                              0
                              (integer- remaining (integer- 8 bits)))))))))
           (loop (vector-nth state 0) (vector-nth state 1) (vector-nth state 2) count))))

      ; Pad the accumulator with one bits and return the written bytes.
      (flush-bits
       (lambda (state)
         (let ((bits (vector-nth state 2)))
           (if (integer=? bits 0)
               (vector-nth state 0)
               (vector-nth
                 (put-bits state (integer- (integer-bit-shift-left 1 (integer- 8 bits)) 1) (integer- 8 bits))
                 0)))))

      ; Write one Huffman symbol: its code, then its magnitude bits.
      (put-symbol
       (lambda (state table symbol size value)
         (let ((entry (vector-nth table symbol)))
           (put-bits (put-bits state (vector-nth entry 0) (vector-nth entry 1)) (magnitude-bits value size) size))))

      ; Entropy-encode the quantised coefficients of one block (zigzag order),
      ; returning the new state and DC predictor.
      (encode-block
       (lambda (state block dc-table ac-table predictor)
         (let ((difference (integer- (vector-nth block 0) predictor)))
           (let ((dc-size (category difference)))
             (let ((after-dc (put-symbol state dc-table dc-size dc-size difference)))
               (let ((loop
                      (lambda (state k run)
                        (if (integer>=? k 64)
                            (if (integer=? run 0)
                                state
                                (put-symbol state ac-table 0 0 0))
                            (let ((coefficient (vector-nth block k)))
                              (if (integer=? coefficient 0)
                                  (loop state (integer+ k 1) (integer+ run 1))
                                  (if (integer>? run 15)
                                      (loop (put-symbol state ac-table 240 0 0) k (integer- run 16))
                                      (let ((size (category coefficient)))
                                        (loop
                                          (put-symbol
                                            state
                                            ac-table
                                            (integer-bit-or (integer-bit-shift-left run 4) size)
                                            size
                                            coefficient)
                                          (integer+ k 1)
                                          0)))))))))
                 (dict "state" (loop after-dc 1 0) "predictor" (vector-nth block 0))))))))

      ; A marker segment: the marker, its length, and its payload.
      (segment
       (lambda (marker payload)
         (bytes-concat
           (bytes-append-u8 (bytes-concat) 255)
           (bytes-append-u8 (bytes-concat) marker)
           (bytes-append-u16-be (bytes-concat) (integer+ (bytes-length payload) 2))
           payload)))

      ; A DQT segment holding one table, given in natural order and written in
      ; zigzag order with zero precision.
      (quant-segment
       (lambda (table-id table)
         (segment
           219
           (bytes-concat
             (bytes-append-u8 (bytes-concat) table-id)
             (apply
               bytes-concat
               (map-list
                 (lambda (k)
                   (bytes-append-u8 (bytes-concat) (vector-nth table (vector-nth zigzag k))))
                 (range 0 64)))))))

      ; Three bytes: a component's id, its sampling factors, and its
      ; quantisation table id, in the order a frame header lists them.
      (component-entry
       (lambda (id sampling quant)
         (bytes-append-u8 (bytes-append-u8 (bytes-append-u8 (bytes-concat) id) sampling) quant)))

      ; The SOF0 segment: 8-bit precision, the frame size, then one entry per
      ; component.  All three components are 1x1 sampled; luminance uses
      ; quantisation table 0 and both chrominance components table 1.
      (frame-segment
       (lambda (width height)
         (segment
           192
           (bytes-concat
             (bytes-append-u8
               (bytes-append-u16-be (bytes-append-u16-be (bytes-append-u8 (bytes-concat) 8) height) width)
               3)
             (component-entry 1 17 0)
             (component-entry 2 17 1)
             (component-entry 3 17 1)))))

      ; The SOS segment: three components, each with its DC and AC Huffman table
      ; (both table 0 for luminance, both table 1 for chrominance), then the
      ; spectral selection 0..63 and approximation 0 of a sequential scan.
      (scan-segment
       (lambda ()
         (segment
           218
           (bytes-concat
             (bytes-append-u8 (bytes-concat) 3)
             (bytes-append-u8 (bytes-append-u8 (bytes-concat) 1) 0)
             (bytes-append-u8 (bytes-append-u8 (bytes-concat) 2) 17)
             (bytes-append-u8 (bytes-append-u8 (bytes-concat) 3) 17)
             (bytes-append-u8 (bytes-append-u8 (bytes-append-u8 (bytes-concat) 0) 63) 0)))))

      ; A DHT segment holding all four standard tables.
      (huffman-segment
       (lambda ()
         (let ((one
                (lambda (table-class table-id bits values)
                  (bytes-concat
                    (bytes-append-u8 (bytes-concat) (integer-bit-or (integer-bit-shift-left table-class 4) table-id))
                    (apply
                      bytes-concat
                      (map-list
                        (lambda (n)
                          (bytes-append-u8 (bytes-concat) n))
                        (vector->list bits)))
                    (apply
                      bytes-concat
                      (map-list
                        (lambda (n)
                          (bytes-append-u8 (bytes-concat) n))
                        (vector->list values)))))))
           (segment
             196
             (bytes-concat
               (one 0 0 dc-luminance-bits dc-luminance-values)
               (one 1 0 ac-luminance-bits ac-luminance-values)
               (one 0 1 dc-chrominance-bits dc-chrominance-values)
               (one 1 1 ac-chrominance-bits ac-chrominance-values))))))

      ; The one sample of a plane at (x, y), repeating the last row and column so
      ; that a partial block at the right or bottom edge is padded by replication.
      (plane-at
       (lambda (samples width height x y)
         (bytes-nth
           samples
           (integer+ (integer* (integer-min (integer- height 1) y) width) (integer-min (integer- width 1) x)))))

      ; The 64 samples of one block of a plane, in natural order.
      (block-samples
       (lambda (samples width height block-x block-y i block)
         (if (integer>=? i 64)
             block
             (block-samples
               samples
               width
               height
               block-x
               block-y
               (integer+ i 1)
               (vector-with
                 block
                 i
                 (plane-at
                   samples
                   width
                   height
                   (integer+ (integer* block-x 8) (integer% i 8))
                   (integer+ (integer* block-y 8) (integer/ i 8))))))))

      ; Encode one block of each component for MCU `index`: a scan interleaves
      ; the components per MCU, so all three blocks for an MCU are written before
      ; the next MCU's, not one component's blocks in a run.
      (encode-mcu
       (lambda (state planes width height blocks-x quants dc-tables ac-tables index component predictors)
         (if (integer>=? component 3)
             (dict "state" state "predictors" predictors)
             (let ((result
                    (encode-block
                      state
                      (quantise-block
                        (block-samples
                          (vector-nth planes component)
                          width
                          height
                          (integer% index blocks-x)
                          (integer/ index blocks-x)
                          0
                          (vector-fill 64 0))
                        (vector-nth quants component))
                      (vector-nth dc-tables component)
                      (vector-nth ac-tables component)
                      (vector-nth predictors component))))
               (encode-mcu
                 (dict-get result "state")
                 planes
                 width
                 height
                 blocks-x
                 quants
                 dc-tables
                 ac-tables
                 index
                 (integer+ component 1)
                 (vector-with predictors component (dict-get result "predictor")))))))

      ; Entropy-encode every MCU of the scan, returning the final bit-writer state.
      (encode-scan
       (lambda (state planes width height blocks-x blocks-y quants dc-tables ac-tables index predictors)
         (if (integer>=? index (integer* blocks-x blocks-y))
             state
             (let ((result
                    (encode-mcu state planes width height blocks-x quants dc-tables ac-tables index 0 predictors)))
               (encode-scan
                 (dict-get result "state")
                 planes
                 width
                 height
                 blocks-x
                 blocks-y
                 quants
                 dc-tables
                 ac-tables
                 (integer+ index 1)
                 (dict-get result "predictors"))))))

      ; Validate the channel count a pixel carries and return the value.
      (pixel-channel
       (lambda (pixel channel)
         (if (vector? pixel)
             (if (integer=? (vector-length pixel) 3)
                 (vector-nth pixel channel)
                 (error
                   (string-concat
                     "jpeg-encode: each pixel must have 3 channels, found "
                     (integer->string (vector-length pixel)))))
             (error "jpeg-encode: each pixel must be a vector of channels"))))

      ; YCbCr sample of a pixel: the JFIF transform, rounded and clamped.
      (to-ycbcr
       (lambda (pixel)
         (let ((red (integer->float (pixel-channel pixel 0)))
               (green (integer->float (pixel-channel pixel 1)))
               (blue (integer->float (pixel-channel pixel 2))))
           (vector
             (to-sample (float+ (float+ (float* 0.299 red) (float* 0.587 green)) (float* 0.114 blue)))
             (to-sample
               (float+ (float+ (float+ (float* -0.168736 red) (float* -0.331264 green)) (float* 0.5 blue)) 128.0))
             (to-sample
               (float+ (float+ (float+ (float* 0.5 red) (float* -0.418688 green)) (float* -0.081312 blue)) 128.0))))))

      ; A value rounded to the nearest integer and clamped to 8 bits.
      (to-sample
       (lambda (value)
         (let ((rounded (float->integer (float-floor (float+ value 0.5)))))
           (if (integer<? rounded 0)
               0
               (if (integer>? rounded 255)
                   255
                   rounded)))))

      ; Append the three channels of one row's pixels to the three planes.
      (scan-row
       (lambda (pixels width y x luma cb cr)
         (if (integer>=? x width)
             (vector luma cb cr)
             (let ((pixel (to-ycbcr (vector-nth (vector-nth pixels y) x))))
               (scan-row
                 pixels
                 width
                 y
                 (integer+ x 1)
                 (bytes-append-u8 luma (vector-nth pixel 0))
                 (bytes-append-u8 cb (vector-nth pixel 1))
                 (bytes-append-u8 cr (vector-nth pixel 2)))))))

      ; The three component planes of the pixel grid, converting each pixel once.
      ;
      ; Each plane is the loop-carried accumulator and the column index is part of
      ; the loop state rather than a nested loop, so the appends land in place
      ; (ADR-0065).
      (colour-planes
       (lambda (pixels width height y luma cb cr)
         (if (integer>=? y height)
             (vector luma cb cr)
             (let ((row (scan-row pixels width y 0 luma cb cr)))
               (colour-planes
                 pixels
                 width
                 height
                 (integer+ y 1)
                 (vector-nth row 0)
                 (vector-nth row 1)
                 (vector-nth row 2))))))

      ; Encode the value into a baseline sequential JPEG file.
      (encode
       (lambda (container)
         (let ((header (dict-get container "header")))
           (if (dict? header)
               (let ((width (dict-get header "width"))
                     (height (dict-get header "height"))
                     (pixels (dict-get container "pixels")))
                 (let ((scale (scale-for quality)))
                   (let ((quant-luminance (scale-table quant-luminance-base scale))
                         (quant-chrominance (scale-table quant-chrominance-base scale)))
                     (let ((dc-luminance (huffman-codes dc-luminance-bits dc-luminance-values))
                           (ac-luminance (huffman-codes ac-luminance-bits ac-luminance-values))
                           (dc-chrominance (huffman-codes dc-chrominance-bits dc-chrominance-values))
                           (ac-chrominance (huffman-codes ac-chrominance-bits ac-chrominance-values)))
                       (let ((blocks-x (integer/ (integer+ width 7) 8))
                             (blocks-y (integer/ (integer+ height 7) 8)))
                         (let ((planes
                                (colour-planes pixels width height 0 (bytes-concat) (bytes-concat) (bytes-concat))))
                           (let ((state
                                  (encode-scan
                                    (vector (bytes-concat) 0 0)
                                    planes
                                    width
                                    height
                                    blocks-x
                                    blocks-y
                                    (vector quant-luminance quant-chrominance quant-chrominance)
                                    (vector dc-luminance dc-chrominance dc-chrominance)
                                    (vector ac-luminance ac-chrominance ac-chrominance)
                                    0
                                    (vector 0 0 0))))
                             (bytes-concat
                               (string-hex->bytes "ffd8")
                               (quant-segment 0 quant-luminance)
                               (quant-segment 1 quant-chrominance)
                               (frame-segment width height)
                               (huffman-segment)
                               (scan-segment)
                               (flush-bits state)
                               (string-hex->bytes "ffd9")))))))))
               (error "jpeg-encode: \"header\" must be a dict"))))))

  (export encode))
