; Tests for tar-extract.menai

(let ((tar-create (import "tar-create"))
      (tar-extract (import "tar-extract"))
      (t (import "menai-test")))
  (let ((create (:: tar-create create))
        (extract (:: tar-extract extract))
        (extract-entry (:: tar-extract extract-entry))
        (extract-matching (:: tar-extract extract-matching))
        (assert-equal (:: t assert-equal))
        (expect-pass (:: t expect-pass))
        (expect-fail (:: t expect-fail))
        (gnu-archive (string-hex->bytes ""))
        (pax-archive (string-hex->bytes ""))
        (archive (create (dict "entries"
                               (list (dict "name" "a.txt" "content" (string->bytes "alpha"))
                                     (dict "name" "dir/")
                                     (dict "name" "dir/b.txt" "content" (string->bytes "beta"))
                                     (dict "name" "link" "typeflag" "2" "linkname" "a.txt"))))))
    (let ((tests (list
       (list "extract"
         (list
           (expect-pass "extracts every entry"
                        (lambda ()
                          (assert-equal (list-length (dict-get (extract archive) "entries")) 4)))
           (expect-pass "extracts file content"
                        (lambda ()
                          (assert-equal (bytes->string (dict-get (extract-entry archive "a.txt") "content"))
                                        "alpha")))
           (expect-pass "extracts nested file content"
                        (lambda ()
                          (assert-equal (bytes->string (dict-get (extract-entry archive "dir/b.txt") "content"))
                                        "beta")))
           (expect-pass "directory has no content"
                        (lambda ()
                          (assert-equal (dict-get (extract-entry archive "dir/") "content")
                                        #none)))
           (expect-pass "symlink has no content"
                        (lambda ()
                          (assert-equal (dict-get (extract-entry archive "link") "content")
                                        #none)))
           (expect-pass "meta reports the format"
                        (lambda ()
                          (assert-equal (dict-get (dict-get (extract archive) "meta") "format")
                                        "tar")))
           (expect-pass "extracts a GNU long-name entry"
                        (lambda ()
                          (assert-equal (bytes->string
                                          (dict-get (extract-entry gnu-archive
                                                     (string-concat "a/" (list->string (map-list (lambda (i) "b") (range 0 120))) "/file.txt"))
                                                     "content"))
                                        "gnu!!")))
           (expect-pass "extracts a PAX extended-header entry"
                        (lambda ()
                          (assert-equal (bytes->string
                                          (dict-get (extract-entry pax-archive
                                                     (string-concat "p/" (list->string (map-list (lambda (i) "q") (range 0 120))) "/file.txt"))
                                                     "content"))
                                        "pax!!")))))

       (list "extract-matching"
         (list
           (expect-pass "returns an empty list when nothing matches"
                        (lambda ()
                          (assert-equal (extract-matching archive "nope") (list))))
           (expect-pass "returns every entry with the name"
                        (lambda ()
                          (assert-equal (list-length (extract-matching archive "a.txt")) 1)))))

       (list "errors"
         (list
           (expect-fail "rejects non-bytes argument"
                        (lambda ()
                          (extract "not bytes"))
                        "expects a bytes value")
           (expect-fail "extract-entry rejects a missing name"
                        (lambda ()
                          (extract-entry archive "missing.txt"))
                        "no entry named")
           (expect-fail "extract-entry rejects a non-string name"
                        (lambda ()
                          (extract-entry archive 42))
                        "expects a string entry name"))))))

      (export tests))))
