; Tests for tar-extract.menai

(letrec
  ((tar-create (import "tar-create"))
   (tar-extract (import "tar-extract"))
   (t (import "menai-test"))
   (create (:: tar-create create))
   (extract (:: tar-extract extract))
   (extract-entry (:: tar-extract extract-entry))
   (extract-matching (:: tar-extract extract-matching))
   (assert-equal (:: t assert-equal))
   (expect-pass (:: t expect-pass))
   (expect-fail (:: t expect-fail))

   ; A ustar archive holding a GNU long-name entry for a 120-character path.
   (gnu-archive
    (string-hex->bytes
      ""))

   ; A ustar archive holding a PAX extended-header entry for a 120-character path.
   (pax-archive
    (string-hex->bytes
      ""))

   ; An archive holding a file, a directory, a nested file, and a symlink.
   (archive
    (create
      (dict "entries" (list
                        (dict "name" "a.txt" "content" (string->bytes "alpha"))
                        (dict "name" "dir/")
                        (dict "name" "dir/b.txt" "content" (string->bytes "beta"))
                        (dict "name" "link" "typeflag" "2" "linkname" "a.txt")))))

   ; extract returns every entry.
   (test-extracts-every-entry
    (lambda ()
      (assert-equal (list-length (dict-get (extract archive) "entries")) 4)))

   ; extract fills in a file's content.
   (test-extracts-file-content
    (lambda ()
      (assert-equal (bytes->string (dict-get (extract-entry archive "a.txt") "content")) "alpha")))

   ; extract fills in a nested file's content.
   (test-extracts-nested-file-content
    (lambda ()
      (assert-equal (bytes->string (dict-get (extract-entry archive "dir/b.txt") "content")) "beta")))

   ; A directory entry has no content.
   (test-directory-no-content
    (lambda ()
      (assert-equal (dict-get (extract-entry archive "dir/") "content") #none)))

   ; A symlink entry has no content.
   (test-symlink-no-content
    (lambda ()
      (assert-equal (dict-get (extract-entry archive "link") "content") #none)))

   ; The archive metadata reports the format.
   (test-meta-format
    (lambda ()
      (assert-equal (dict-get (dict-get (extract archive) "meta") "format") "tar")))

   ; A GNU long-name entry is resolved and its content is extracted.
   (test-gnu-long-name
    (lambda ()
      (assert-equal
        (bytes->string
          (dict-get
            (extract-entry
              gnu-archive
              (string-concat "a/" (list->string (map-list (lambda (i) "b") (range 0 120))) "/file.txt"))
            "content"))
        "gnu!!")))

   ; A PAX extended-header entry is resolved and its content is extracted.
   (test-pax-extended-header
    (lambda ()
      (assert-equal
        (bytes->string
          (dict-get
            (extract-entry
              pax-archive
              (string-concat "p/" (list->string (map-list (lambda (i) "q") (range 0 120))) "/file.txt"))
            "content"))
        "pax!!")))

   ; extract-matching returns an empty list when nothing matches.
   (test-extract-matching-empty
    (lambda ()
      (assert-equal (extract-matching archive "nope") (list))))

   ; extract-matching returns every entry with the name.
   (test-extract-matching-named
    (lambda ()
      (assert-equal (list-length (extract-matching archive "a.txt")) 1)))

   ; A non-bytes argument is rejected.
   (test-rejects-non-bytes
    (lambda ()
      (extract "not bytes")))

   ; extract-entry rejects a name that is not present.
   (test-extract-entry-missing
    (lambda ()
      (extract-entry archive "missing.txt")))

   ; extract-entry rejects a non-string name.
   (test-extract-entry-non-string-name
    (lambda ()
      (extract-entry archive 42)))

   (tests
    (list
      (list
        "extract"
        (list
          (expect-pass "extracts every entry" test-extracts-every-entry)
          (expect-pass "extracts file content" test-extracts-file-content)
          (expect-pass "extracts nested file content" test-extracts-nested-file-content)
          (expect-pass "directory has no content" test-directory-no-content)
          (expect-pass "symlink has no content" test-symlink-no-content)
          (expect-pass "meta reports the format" test-meta-format)
          (expect-pass "extracts a GNU long-name entry" test-gnu-long-name)
          (expect-pass "extracts a PAX extended-header entry" test-pax-extended-header)))

      (list
        "extract-matching"
        (list
          (expect-pass "returns an empty list when nothing matches" test-extract-matching-empty)
          (expect-pass "returns every entry with the name" test-extract-matching-named)))

      (list
        "errors"
        (list
          (expect-fail "rejects non-bytes argument" test-rejects-non-bytes "expects a bytes value")
          (expect-fail "extract-entry rejects a missing name" test-extract-entry-missing "no entry named")
          (expect-fail "extract-entry rejects a non-string name"
                       test-extract-entry-non-string-name
                       "expects a string entry name"))))))

  (export tests))
