; Tests for png-decode.menai

(let ((png-mod (import "png-decode"))
      (t (import "menai-test"))
      (decode (:: png-mod decode))
      (assert-equal (:: t assert-equal))
      (expect-pass (:: t expect-pass))
      (expect-fail (:: t expect-fail))

      ; A 2x2 8-bit greyscale file.
      (greyscale
       (string-hex->bytes
         "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000e49444154789c63e03ac160f41f0004bb0204b135a2230000000049454e44ae426082"))

      ; A 2x2 8-bit greyscale file with an alpha channel.
      (greyscale-alpha
       (string-hex->bytes
         "89504e470d0a1a0a0000000d4948445200000002000000020804000000d8bfc5af0000001249444154789c63e0fa7fa281c188e1ff7f001499048214c3c8690000000049454e44ae426082"))

      ; A 2x2 palette file with a PLTE chunk.
      (palette
       (string-hex->bytes
         "89504e470d0a1a0a0000000d49484452000000020000000208030000004568fd160000000c504c5445ff000000ff000000fffffffffb0060f60000000e49444154789c6360606460620600001100079ea22a120000000049454e44ae426082"))

      ; A 2x2 palette file with a PLTE chunk and a tRNS chunk.
      (palette-trns
       (string-hex->bytes
         "89504e470d0a1a0a0000000d49484452000000020000000208030000004568fd160000000c504c5445ff000000ff000000fffffffffb0060f60000000274524e53ff80080fb36a0000000e49444154789c6360606460620600001100079ea22a120000000049454e44ae426082"))

      ; A 2x2 8-bit truecolour (RGB) file.
      (truecolour
       (string-hex->bytes
         "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a73000000124944415478da63f8cfc0c000c20cff8100001fee05fbf1abba770000000049454e44ae426082"))

      ; A 2x2 8-bit truecolour file with an alpha channel (RGBA).
      (truecolour-alpha
       (string-hex->bytes
         "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d24000000144944415478da63f8cfc0f01f081b18803418000044d209786653c4700000000049454e44ae426082"))

      ; A 2x2 8-bit greyscale file whose first scanline declares filter type 5,
      ; which PNG does not define.
      (bad-filter
       (string-hex->bytes
         "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000e4944415478da63e53ac160f41f0004d90209e8e823e40000000049454e44ae426082"))

      ; The pixel grid that every 2x2 greyscale fixture below encodes.
      (greyscale-pixels
       (vector (vector (vector 10 10 10) (vector 200 200 200)) (vector (vector 50 50 50) (vector 255 255 255))))

      ; The same 2x2 greyscale image with both scanlines filtered, one fixture
      ; per PNG filter type: 1 (Sub), 2 (Up), 3 (Average) and 4 (Paeth).
      (greyscale-sub
       (string-hex->bytes
         "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000e4944415478da63e4dac768741600046a01caff3aa8d00000000049454e44ae426082"))

      (greyscale-up
       (string-hex->bytes
         "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000e4944415478da63e23ac1a4610e0003f101367c87a6100000000049454e44ae426082"))

      (greyscale-average
       (string-hex->bytes
         "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000e4944415478da63e63accacdb0400043b0183718e76d40000000049454e44ae426082"))

      (greyscale-paeth
       (string-hex->bytes
         "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000e4944415478da63e1dac7a2610e0003db0130bb4bdb6e0000000049454e44ae426082"))

      ; The header fields are decoded.
      (test-header-fields
       (lambda ()
         (let ((r (decode greyscale)))
           (assert-equal
             (dict-get r "header")
             (dict "width" 2 "height" 2 "bit-depth" 8 "colour-type" 0 "compression" 0 "filter" 0 "interlace" 0)))))

      ; The metadata reports three channels for a greyscale image.
      (test-meta-greyscale-channels
       (lambda ()
         (let ((r (decode greyscale)))
           (assert-equal (dict-get r "meta") (dict "format" "png" "channels" 3)))))

      ; The metadata reports four channels for an RGBA image.
      (test-meta-rgba-channels
       (lambda ()
         (let ((r (decode palette-trns)))
           (assert-equal (dict-get r "meta") (dict "format" "png" "channels" 4)))))

      ; Greyscale pixels are normalised to RGB.
      (test-greyscale-to-rgb
       (lambda ()
         (let ((r (decode greyscale)))
           (assert-equal (dict-get r "pixels") greyscale-pixels))))

      ; Sub filtering adds the byte one pixel to the left.
      (test-filter-sub
       (lambda ()
         (assert-equal (dict-get (decode greyscale-sub) "pixels") greyscale-pixels)))

      ; Up filtering adds the byte one scanline above.
      (test-filter-up
       (lambda ()
         (assert-equal (dict-get (decode greyscale-up) "pixels") greyscale-pixels)))

      ; Average filtering adds the mean of the left and above bytes, rounded down.
      (test-filter-average
       (lambda ()
         (assert-equal (dict-get (decode greyscale-average) "pixels") greyscale-pixels)))

      ; Paeth filtering adds the neighbour closest to left + above - upper left.
      (test-filter-paeth
       (lambda ()
         (assert-equal (dict-get (decode greyscale-paeth) "pixels") greyscale-pixels)))

      ; Truecolour pixels are returned as RGB, without conversion.
      (test-truecolour-pixels
       (lambda ()
         (assert-equal
           (dict-get (decode truecolour) "pixels")
           (vector (vector (vector 255 0 0) (vector 0 255 0)) (vector (vector 0 0 255) (vector 255 255 255))))))

      ; Truecolour pixels with an alpha channel are returned as RGBA.
      (test-truecolour-alpha-pixels
       (lambda ()
         (assert-equal
           (dict-get (decode truecolour-alpha) "pixels")
           (vector
             (vector (vector 255 0 0 255) (vector 0 255 0 128))
             (vector (vector 0 0 255 255) (vector 255 255 255 255))))))

      ; Input too short to hold the PNG signature is rejected.
      (test-rejects-too-short
       (lambda ()
         (decode (string-hex->bytes "89504e47"))))

      ; A file whose first eight bytes are not the PNG signature is rejected.
      (test-rejects-missing-signature
       (lambda ()
         (decode (string-hex->bytes "000000000000000000000000"))))

      ; A scanline filter type outside 0-4 is rejected.
      (test-rejects-unknown-filter-type
       (lambda ()
         (decode bad-filter)))

      ; Greyscale-with-alpha pixels are normalised to RGBA.
      (test-greyscale-alpha-to-rgba
       (lambda ()
         (let ((r (decode greyscale-alpha)))
           (assert-equal
             (dict-get r "pixels")
             (vector
               (vector (vector 10 10 10 255) (vector 200 200 200 128))
               (vector (vector 50 50 50 0) (vector 255 255 255 255)))))))

      ; Palette pixels are resolved through the PLTE chunk.
      (test-palette-resolved
       (lambda ()
         (let ((r (decode palette)))
           (assert-equal
             (dict-get r "pixels")
             (vector (vector (vector 255 0 0) (vector 0 255 0)) (vector (vector 0 0 255) (vector 255 255 255)))))))

      ; A palette with a tRNS chunk adds an alpha channel.
      (test-palette-trns-alpha
       (lambda ()
         (let ((r (decode palette-trns)))
           (assert-equal
             (dict-get r "pixels")
             (vector (vector (vector 255 0 0) (vector 0 255 0 128)) (vector (vector 0 0 255) (vector 255 255 255)))))))

      ; A non-bytes argument is rejected.
      (test-rejects-non-bytes
       (lambda ()
         (decode "not bytes")))

      ; An unsupported bit depth is rejected.
      (test-rejects-unsupported-bit-depth
       (lambda ()
         (decode
           (string-hex->bytes
             "89504e470d0a1a0a0000000d4948445200000002000000021002000000ad4446300000001649444154789c636064626661656360e7e06464640400015500318f92a71a0000000049454e44ae426082"))))

      ; An interlaced image is rejected.
      (test-rejects-interlaced
       (lambda ()
         (decode
           (string-hex->bytes
             "89504e470d0a1a0a0000000d49484452000000020000000208020000018ad3aae50000001649444154789c636064626661656360e7e06464640400015500318f92a71a0000000049454e44ae426082"))))

      ; An unsupported colour type is rejected.
      (test-rejects-unsupported-colour-type
       (lambda ()
         (decode
           (string-hex->bytes
             "89504e470d0a1a0a0000000d4948445200000002000000020807000000ca0a6a410000000b49444154789c636000010000060001fe8c67c80000000049454e44ae426082"))))

      ; A palette image with no PLTE chunk is rejected.
      (test-rejects-missing-plte
       (lambda ()
         (decode
           (string-hex->bytes
             "89504e470d0a1a0a0000000d49484452000000020000000208030000004568fd160000000b49444154789c636000010000060001fe8c67c80000000049454e44ae426082"))))

      ; A palette index that is out of range is rejected.
      (test-rejects-out-of-range-index
       (lambda ()
         (decode
           (string-hex->bytes
             "89504e470d0a1a0a0000000d49484452000000020000000208030000004568fd1600000003504c54450102030d8764d50000000e49444154789c6360646460640400001200055519c12c0000000049454e44ae426082"))))

      ; A tRNS chunk on a greyscale image is rejected.
      (test-rejects-trns-on-greyscale
       (lambda ()
         (decode
           (string-hex->bytes
             "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000274524e53000a964624260000000e49444154789c6310506030700000017600a1ec308af40000000049454e44ae426082"))))

      ; A chunk with a bad CRC is rejected.
      (test-rejects-bad-crc
       (lambda ()
         (decode
           (string-hex->bytes
             "89504e470d0a1a0a0000000d4948445200000002000000020800000000dd52f80000000e49444154789c63e03ac160f41f0004bb0204b135a2230000000049454e44ae426082"))))

      (tests
       (list
         (list
           "header"
           (list
             (expect-pass "header fields" test-header-fields)
             (expect-pass "meta reports three channels for greyscale" test-meta-greyscale-channels)
             (expect-pass "meta reports four channels for rgba" test-meta-rgba-channels)))

         (list
           "pixels"
           (list
             (expect-pass "greyscale pixels normalise to RGB" test-greyscale-to-rgb)
             (expect-pass "greyscale with alpha normalises to RGBA" test-greyscale-alpha-to-rgba)
             (expect-pass "palette pixels resolve through PLTE" test-palette-resolved)
             (expect-pass "palette with tRNS adds alpha" test-palette-trns-alpha)
             (expect-pass "sub-filtered scanlines" test-filter-sub)
             (expect-pass "up-filtered scanlines" test-filter-up)
             (expect-pass "average-filtered scanlines" test-filter-average)
             (expect-pass "paeth-filtered scanlines" test-filter-paeth)
             (expect-pass "truecolour pixels stay RGB" test-truecolour-pixels)
             (expect-pass "truecolour with alpha stays RGBA" test-truecolour-alpha-pixels)))

         (list
           "errors"
           (list
             (expect-fail "rejects non-bytes argument" test-rejects-non-bytes "expects a bytes value")
             (expect-fail "rejects input too short for a signature" test-rejects-too-short "too short")
             (expect-fail "rejects a missing PNG signature" test-rejects-missing-signature "missing PNG signature")
             (expect-fail "rejects an unknown filter type" test-rejects-unknown-filter-type "filter type 5")
             (expect-fail "rejects unsupported bit depth" test-rejects-unsupported-bit-depth "bit depth 16")
             (expect-fail "rejects interlaced images" test-rejects-interlaced "interlaced")
             (expect-fail "rejects unsupported colour type" test-rejects-unsupported-colour-type "colour type 7")
             (expect-fail "rejects palette image without PLTE" test-rejects-missing-plte "missing its PLTE")
             (expect-fail "rejects out-of-range palette index"
                          test-rejects-out-of-range-index
                          "palette index 1 is out of range")
             (expect-fail "rejects tRNS on greyscale" test-rejects-trns-on-greyscale "only supported for palette")
             (expect-fail "rejects a chunk with a bad CRC" test-rejects-bad-crc "checksum mismatch"))))))

  (export tests))
