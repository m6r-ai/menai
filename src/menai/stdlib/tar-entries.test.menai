; Tests for tar-entries.menai

(let ((tar-entries (import "tar-entries"))
      (t (import "menai-test"))
      (entries (:: tar-entries entries))
      (assert-equal (:: t assert-equal))
      (expect-pass (:: t expect-pass))
      (expect-fail (:: t expect-fail))

      ; A ustar archive holding a single regular file "hello.txt" with the content
      ; "hello world": the header, the padded data, and the two-block end marker.
      (hello-archive
       (string-hex->bytes
         ""))

      ; A ustar archive holding a GNU long-name entry for a 120-character path.
      (gnu-long-archive
       (string-hex->bytes
         ""))

      ; A ustar archive holding a PAX extended-header entry for a 120-character path.
      (pax-archive
       (string-hex->bytes
         ""))

      ; A ustar archive holding a single file "gnu.txt" with the content "gnu!!".
      (gnu-format-archive
       (string-hex->bytes
         ""))

      ; A ustar archive holding a hardlink entry, whose typeflag is unsupported.
      (unsupported-typeflag-archive
       (string-hex->bytes
         ""))

      ; A GNU archive whose mtime is a positive base-256 field (2^40).
      (base256-positive-archive
       (string-hex->bytes
         ""))

      ; A GNU archive whose mtime is a negative base-256 field (-1).
      (base256-negative-archive
       (string-hex->bytes
         ""))

      ; A ustar archive holding a directory, a symlink, and a contiguous file.
      (three-typeflags-archive
       (string-hex->bytes
         ""))

      ; A tar header whose magic is not ustar or GNU tar.
      (bad-magic-archive
       (string-hex->bytes
         ""))

      ; A tar header whose uid field is empty (all NUL bytes).
      (zero-uid-archive
       (string-hex->bytes
         ""))

      ; A GNU archive whose symlink link name uses a "K" long-link entry.
      (gnu-long-link-archive
       (string-hex->bytes
         ""))

      ; A PAX archive whose symlink link name uses a "linkpath" record.
      (pax-long-link-archive
       (string-hex->bytes
         ""))

      ; A ustar archive whose name is split across the prefix and name fields.
      (prefix-archive
       (string-hex->bytes
         ""))

      ; A PAX archive with a global "path" record and malformed records.
      (global-pax-archive
       (string-hex->bytes
         ""))

      ; A PAX archive with a global "linkpath" record.
      (global-pax-linkpath-archive
       (string-hex->bytes
         ""))

      ; A single-file archive reads back as one entry.
      (test-single-entry-count
       (lambda ()
         (let ((result (entries hello-archive)))
           (assert-equal (list-length (dict-get result "entries")) 1))))

      ; The entry name is decoded.
      (test-entry-name
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "name") "hello.txt")))

      ; The entry size is decoded.
      (test-entry-size
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "size") 11)))

      ; The entry mode is decoded.
      (test-entry-mode
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "mode") #o644)))

      ; The entry typeflag is decoded.
      (test-entry-typeflag
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "typeflag") "0")))

      ; The entry data offset is decoded.
      (test-entry-data-offset
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "data-offset") 512)))

      ; entries leaves an entry's content unset.
      (test-content-unset
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "content") #none)))

      ; The archive metadata reports the format.
      (test-meta-format
       (lambda ()
         (assert-equal (dict-get (dict-get (entries hello-archive) "meta") "format") "tar")))

      ; A GNU long-name entry is resolved to its full path.
      (test-gnu-long-name
       (lambda ()
         (assert-equal
           (dict-get (list-first (dict-get (entries gnu-long-archive) "entries")) "name")
           (string-concat "a/" (list->string (map-list (lambda (i) "b") (range 0 120))) "/file.txt"))))

      ; A PAX extended-header entry is resolved to its full path.
      (test-pax-extended-header
       (lambda ()
         (assert-equal
           (dict-get (list-first (dict-get (entries pax-archive) "entries")) "name")
           (string-concat "p/" (list->string (map-list (lambda (i) "q") (range 0 120))) "/file.txt"))))

      ; A GNU-format archive is read.
      (test-gnu-format
       (lambda ()
         (let ((result (entries gnu-format-archive)))
           (assert-equal (dict-get (list-first (dict-get result "entries")) "name") "gnu.txt"))))

      ; A positive base-256 numeric field is decoded.
      (test-base256-positive
       (lambda ()
         (assert-equal
           (dict-get (list-first (dict-get (entries base256-positive-archive) "entries")) "mtime")
           1099511627776)))

      ; A negative base-256 numeric field is decoded.
      (test-base256-negative
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries base256-negative-archive) "entries")) "mtime") -1)))

      ; Directory, symlink, and contiguous typeflags are reported.
      (test-three-typeflags
       (lambda ()
         (let ((items (dict-get (entries three-typeflags-archive) "entries")))
           (assert-equal
             (list
               (map-list
                 (lambda (e)
                   (dict-get e "typeflag"))
                 items)
               (dict-get (list-first items) "is-directory")
               (dict-get (list-nth items 1) "linkname"))
             (list (list "5" "2" "0") #t "target")))))

      ; A header with the wrong magic is rejected.
      (test-rejects-bad-magic
       (lambda ()
         (entries bad-magic-archive)))

      ; An empty uid field decodes as zero.
      (test-zero-uid
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries zero-uid-archive) "entries")) "uid") 0)))

      ; A GNU long-link entry is resolved to its full target.
      (test-gnu-long-link
       (lambda ()
         (assert-equal
           (dict-get (list-first (dict-get (entries gnu-long-link-archive) "entries")) "linkname")
           (list->string (map-list (lambda (i) "b") (range 0 120))))))

      ; A PAX linkpath record is resolved to its full target.
      (test-pax-long-link
       (lambda ()
         (assert-equal
           (dict-get (list-first (dict-get (entries pax-long-link-archive) "entries")) "linkname")
           (list->string (map-list (lambda (i) "b") (range 0 120))))))

      ; A name split across the prefix and name fields is joined.
      (test-prefix-name
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries prefix-archive) "entries")) "name") "sub/file.txt")))

      ; A global PAX path record applies to the following entry, and records
      ; without an "=" or without a space are skipped.
      (test-global-pax
       (lambda ()
         (assert-equal (dict-get (list-first (dict-get (entries global-pax-archive) "entries")) "name") "global.txt")))

      ; A global PAX linkpath record applies to the following entry.
      (test-global-pax-linkpath
       (lambda ()
         (assert-equal
           (dict-get (list-first (dict-get (entries global-pax-linkpath-archive) "entries")) "linkname")
           "global-target")))

      ; A non-bytes argument is rejected.
      (test-rejects-non-bytes
       (lambda ()
         (entries "not bytes")))

      ; A header with a bad checksum is rejected.
      (test-rejects-bad-checksum
       (lambda ()
         (entries (bytes-write-u8 hello-archive 0 88))))

      ; An unsupported typeflag is rejected.
      (test-rejects-unsupported-typeflag
       (lambda ()
         (entries unsupported-typeflag-archive)))

      (tests
       (list
         (list
           "entries"
           (list
             (expect-pass "reads a single-file archive" test-single-entry-count)
             (expect-pass "reports the entry name" test-entry-name)
             (expect-pass "reports the entry size" test-entry-size)
             (expect-pass "reports the entry mode" test-entry-mode)
             (expect-pass "reports the typeflag" test-entry-typeflag)
             (expect-pass "reports the data offset" test-entry-data-offset)
             (expect-pass "content is #none" test-content-unset)
             (expect-pass "reports the format" test-meta-format)
             (expect-pass "reads a GNU long-name entry" test-gnu-long-name)
             (expect-pass "reads a PAX extended-header entry" test-pax-extended-header)))

         (list
           "errors"
           (list
             (expect-fail "rejects non-bytes argument" test-rejects-non-bytes "expects a bytes value")
             (expect-fail "rejects a bad header checksum" test-rejects-bad-checksum "checksum mismatch")
             (expect-pass "reads a GNU-format archive" test-gnu-format)
             (expect-pass "reads a positive base-256 field" test-base256-positive)
             (expect-pass "reads a negative base-256 field" test-base256-negative)
             (expect-pass "reports directory, symlink, and contiguous typeflags" test-three-typeflags)
             (expect-pass "reports an empty uid as zero" test-zero-uid)
             (expect-pass "reads a GNU long link name" test-gnu-long-link)
             (expect-pass "reads a PAX linkpath record" test-pax-long-link)
             (expect-pass "joins the prefix and name fields" test-prefix-name)
             (expect-pass "applies a global PAX path record" test-global-pax)
             (expect-pass "applies a global PAX linkpath record" test-global-pax-linkpath)
             (expect-fail "rejects a header with the wrong magic"
                          test-rejects-bad-magic
                          "not a ustar or GNU tar archive")
             (expect-fail "rejects an unsupported typeflag" test-rejects-unsupported-typeflag "is not supported"))))))

  (export tests))
