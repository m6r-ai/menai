; Tests for tar-entries.menai

(letrec
  ((tar-entries (import "tar-entries"))
   (t (import "menai-test"))
   (entries (:: tar-entries entries))
   (assert-equal (:: t assert-equal))
   (expect-pass (:: t expect-pass))
   (expect-fail (:: t expect-fail))

   ; A ustar archive holding a single regular file "hello.txt" with the content
   ; "hello world": the header, the padded data, and the two-block end marker.
   (hello-archive
    (string-hex->bytes ""))

   ; A ustar archive holding a GNU long-name entry for a 120-character path.
   (gnu-long-archive
    (string-hex->bytes ""))

   ; A ustar archive holding a PAX extended-header entry for a 120-character path.
   (pax-archive
    (string-hex->bytes ""))

   ; A ustar archive holding a single file "gnu.txt" with the content "gnu!!".
   (gnu-format-archive
    (string-hex->bytes ""))

   ; A ustar archive holding a hardlink entry, whose typeflag is unsupported.
   (unsupported-typeflag-archive
    (string-hex->bytes ""))

   ; A single-file archive reads back as one entry.
   (test-single-entry-count
    (lambda ()
      (let ((result (entries hello-archive)))
        (assert-equal (list-length (dict-get result "entries")) 1))))

   ; The entry name is decoded.
   (test-entry-name
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "name")
                    "hello.txt")))

   ; The entry size is decoded.
   (test-entry-size
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "size")
                    11)))

   ; The entry mode is decoded.
   (test-entry-mode
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "mode")
                    #o644)))

   ; The entry typeflag is decoded.
   (test-entry-typeflag
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "typeflag")
                    "0")))

   ; The entry data offset is decoded.
   (test-entry-data-offset
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "data-offset")
                    512)))

   ; entries leaves an entry's content unset.
   (test-content-unset
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "content")
                    #none)))

   ; The archive metadata reports the format.
   (test-meta-format
    (lambda ()
      (assert-equal (dict-get (dict-get (entries hello-archive) "meta") "format")
                    "tar")))

   ; A GNU long-name entry is resolved to its full path.
   (test-gnu-long-name
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (entries gnu-long-archive) "entries")) "name")
                    (string-concat "a/" (list->string (map-list (lambda (i) "b") (range 0 120))) "/file.txt"))))

   ; A PAX extended-header entry is resolved to its full path.
   (test-pax-extended-header
    (lambda ()
      (assert-equal (dict-get (list-first (dict-get (entries pax-archive) "entries")) "name")
                    (string-concat "p/" (list->string (map-list (lambda (i) "q") (range 0 120))) "/file.txt"))))

   ; A GNU-format archive is read.
   (test-gnu-format
    (lambda ()
      (let ((result (entries gnu-format-archive)))
        (assert-equal (dict-get (list-first (dict-get result "entries")) "name")
                      "gnu.txt"))))

   ; A non-bytes argument is rejected.
   (test-rejects-non-bytes
    (lambda ()
      (entries "not bytes")))

   ; A header with a bad checksum is rejected.
   (test-rejects-bad-checksum
    (lambda ()
      (entries (bytes-write-u8 hello-archive 0 88))))

   ; An unsupported typeflag is rejected.
   (test-rejects-unsupported-typeflag
    (lambda ()
      (entries unsupported-typeflag-archive)))

   (tests
    (list
      (list "entries"
        (list
          (expect-pass "reads a single-file archive" test-single-entry-count)
          (expect-pass "reports the entry name" test-entry-name)
          (expect-pass "reports the entry size" test-entry-size)
          (expect-pass "reports the entry mode" test-entry-mode)
          (expect-pass "reports the typeflag" test-entry-typeflag)
          (expect-pass "reports the data offset" test-entry-data-offset)
          (expect-pass "content is #none" test-content-unset)
          (expect-pass "reports the format" test-meta-format)
          (expect-pass "reads a GNU long-name entry" test-gnu-long-name)
          (expect-pass "reads a PAX extended-header entry" test-pax-extended-header)))

      (list "errors"
        (list
          (expect-fail "rejects non-bytes argument" test-rejects-non-bytes "expects a bytes value")
          (expect-fail "rejects a bad header checksum" test-rejects-bad-checksum "checksum mismatch")
          (expect-pass "reads a GNU-format archive" test-gnu-format)
          (expect-fail "rejects an unsupported typeflag" test-rejects-unsupported-typeflag "is not supported"))))))

  (export tests))
