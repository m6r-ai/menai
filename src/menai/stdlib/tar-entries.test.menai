; Tests for tar-entries.menai

; A ustar archive holding a single regular file "hello.txt" with the content
; "hello world".  It is four 512-byte blocks: the header, the padded data, and
; the two-block end marker.
(let ((tar-entries (import "tar-entries"))
      (t (import "menai-test")))
  (let ((entries (:: tar-entries entries))
        (assert-equal (:: t assert-equal))
        (expect-pass (:: t expect-pass))
        (expect-fail (:: t expect-fail))
        (hello-archive (string-hex->bytes (string-concat
          ""))))
    (let ((gnu-long-archive (string-hex->bytes ""))
          (pax-archive (string-hex->bytes ""))
          (tests (list
       (list "entries"
         (list
           (expect-pass "reads a single-file archive"
                        (lambda ()
                          (let ((result (entries hello-archive)))
                            (assert-equal (list-length (dict-get result "entries")) 1))))
           (expect-pass "reports the entry name"
                        (lambda ()
                          (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "name")
                                        "hello.txt")))
           (expect-pass "reports the entry size"
                        (lambda ()
                          (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "size")
                                        11)))
           (expect-pass "reports the entry mode"
                        (lambda ()
                          (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "mode")
                                        #o644)))
           (expect-pass "reports the typeflag"
                        (lambda ()
                          (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "typeflag")
                                        "0")))
           (expect-pass "reports the data offset"
                        (lambda ()
                          (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "data-offset")
                                        512)))
           (expect-pass "content is #none"
                        (lambda ()
                          (assert-equal (dict-get (list-first (dict-get (entries hello-archive) "entries")) "content")
                                        #none)))
           (expect-pass "reports the format"
                        (lambda ()
                          (assert-equal (dict-get (dict-get (entries hello-archive) "meta") "format")
                                        "tar")))
           (expect-pass "reads a GNU long-name entry"
                        (lambda ()
                          (assert-equal (dict-get (list-first (dict-get (entries gnu-long-archive) "entries")) "name")
                                        (string-concat "a/" (list->string (map-list (lambda (i) "b") (range 0 120))) "/file.txt"))))
           (expect-pass "reads a PAX extended-header entry"
                        (lambda ()
                          (assert-equal (dict-get (list-first (dict-get (entries pax-archive) "entries")) "name")
                                        (string-concat "p/" (list->string (map-list (lambda (i) "q") (range 0 120))) "/file.txt"))))))

       (list "errors"
         (list
           (expect-fail "rejects non-bytes argument"
                        (lambda ()
                          (entries "not bytes"))
                        "expects a bytes value")
           (expect-fail "rejects a bad header checksum"
                        (lambda ()
                          (entries (bytes-write-u8 hello-archive 0 88)))
                        "checksum mismatch")
           (expect-pass "reads a GNU-format archive"
                        (lambda ()
                          (let ((result (entries (string-hex->bytes ""))))
                            (assert-equal (dict-get (list-first (dict-get result "entries")) "name")
                                          "gnu.txt"))))
           (expect-fail "rejects an unsupported typeflag"
                        (lambda ()
                          (entries (string-hex->bytes (string-concat
                            ""))))
                        "is not supported"))))))

      (export tests))))
