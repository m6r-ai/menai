; Tests for deflate-compress.menai

(let ((deflate-mod (import "deflate-compress"))
      (decompress-mod (import "deflate-decompress"))
      (t (import "menai-test"))
      (compress (:: deflate-mod compress))
      (mode (:: deflate-mod mode))
      (decompress (:: decompress-mod decompress))
      (assert-equal (:: t assert-equal))
      (expect-pass (:: t expect-pass))
      (expect-fail (:: t expect-fail))

      ; Compress text then decompress it, returning the recovered text.
      (round-trip
       (lambda (text block-mode)
         (let ((input (string->bytes text)))
           (bytes->string (decompress (compress input block-mode))))))

      ; Compress bytes then decompress them, returning whether they are recovered.
      (round-trip-bytes
       (lambda (input block-mode)
         (bytes=? (decompress (compress input block-mode)) input)))

      ; Build a string by repeating a unit the given number of times.
      (repeat
       (lambda (unit count)
         (list->string (map-list (lambda (i) unit) (range 0 count)))))

      ; `count` bytes from the high bits of a linear congruential generator.
      ; The sequence has a long period and no local structure, so DEFLATE cannot
      ; compress it: a stored block is then the shortest encoding, which is what
      ; auto mode selects.
      (lcg-bytes
       (lambda (count seed)
         (let ((loop
                (lambda (n state acc)
                  (if (integer>=? n count)
                      (list->bytes (list-reverse acc))
                      (let ((next (integer% (integer+ (integer* state 1103515245) 12345) 2147483648)))
                        (loop (integer+ n 1) next (list-prepend acc (integer% (integer/ next 65536) 256))))))))
           (loop 0 seed (list)))))

      ; The empty input round-trips in every mode.
      (test-empty-all-modes
       (lambda ()
         (and (assert-equal (round-trip "" (mode 'stored)) "")
              (and (assert-equal (round-trip "" (mode 'fixed)) "")
                   (and (assert-equal (round-trip "" (mode 'dynamic)) "")
                        (assert-equal (round-trip "" (mode 'auto)) ""))))))

      ; A single byte round-trips in every mode.
      (test-single-byte-all-modes
       (lambda ()
         (and (assert-equal (round-trip "A" (mode 'stored)) "A")
              (and (assert-equal (round-trip "A" (mode 'fixed)) "A")
                   (and (assert-equal (round-trip "A" (mode 'dynamic)) "A")
                        (assert-equal (round-trip "A" (mode 'auto)) "A"))))))

      ; A short text round-trips in every mode.
      (test-short-text-all-modes
       (lambda ()
         (and (assert-equal (round-trip "hello" (mode 'stored)) "hello")
              (and (assert-equal (round-trip "hello" (mode 'fixed)) "hello")
                   (and (assert-equal (round-trip "hello" (mode 'dynamic)) "hello")
                        (assert-equal (round-trip "hello" (mode 'auto)) "hello"))))))

      ; Repetitive text exercises back-references in every mode.
      (test-repetitive-text-all-modes
       (lambda ()
         (and (assert-equal (round-trip "hello hello hello" (mode 'stored)) "hello hello hello")
              (and (assert-equal (round-trip "hello hello hello" (mode 'fixed)) "hello hello hello")
                   (and (assert-equal (round-trip "hello hello hello" (mode 'dynamic)) "hello hello hello")
                        (assert-equal (round-trip "hello hello hello" (mode 'auto)) "hello hello hello"))))))

      ; A long run of a single byte round-trips.
      (test-long-run
       (lambda ()
         (let ((text (repeat "a" 500)))
           (and (assert-equal (round-trip text (mode 'fixed)) text)
                (assert-equal (round-trip text (mode 'dynamic)) text)))))

      ; A repeating two-byte pattern round-trips.
      (test-repeating-two-byte-pattern
       (lambda ()
         (let ((text (repeat "ab" 200)))
           (and (assert-equal (round-trip text (mode 'fixed)) text)
                (assert-equal (round-trip text (mode 'dynamic)) text)))))

      ; A skewed alphabet round-trips under dynamic and auto coding.
      (test-skewed-alphabet
       (lambda ()
         (let ((text
                (list->string
                  (map-list
                    (lambda (i)
                      (if (integer=? (integer% i 10) 0)
                          "b"
                          "a"))
                    (range 0 300)))))
           (and (assert-equal (round-trip text (mode 'dynamic)) text)
                (assert-equal (round-trip text (mode 'auto)) text)))))

      ; Every byte value round-trips in every mode.
      (test-all-byte-values
       (lambda ()
         (let ((input (list->bytes (range 0 256))))
           (and (assert-equal (round-trip-bytes input (mode 'stored)) #t)
                (and (assert-equal (round-trip-bytes input (mode 'fixed)) #t)
                     (and (assert-equal (round-trip-bytes input (mode 'dynamic)) #t)
                          (assert-equal (round-trip-bytes input (mode 'auto)) #t)))))))

      ; Auto mode round-trips a range of input lengths.
      (test-auto-range-of-lengths
       (lambda ()
         (and (assert-equal (round-trip "x" (mode 'auto)) "x")
              (and (assert-equal (round-trip "xyz" (mode 'auto)) "xyz")
                   (and (assert-equal (round-trip "abcdefghijklmnop" (mode 'auto)) "abcdefghijklmnop")
                        (assert-equal
                          (round-trip "the quick brown fox jumps over the lazy dog" (mode 'auto))
                          "the quick brown fox jumps over the lazy dog"))))))

      ; Stored mode emits a stored block.
      (test-stored-block-type
       (lambda ()
         (let ((stream (compress (string->bytes "abc") (mode 'stored))))
           (assert-equal (integer-bit-and (bytes-nth stream 0) 6) 0))))

      ; Fixed mode emits a fixed Huffman block.
      (test-fixed-block-type
       (lambda ()
         (let ((stream (compress (string->bytes "abc") (mode 'fixed))))
           (assert-equal (integer-bit-shift-right (integer-bit-and (bytes-nth stream 0) 6) 1) 1))))

      ; Dynamic mode emits a dynamic Huffman block.
      (test-dynamic-block-type
       (lambda ()
         (let ((stream (compress (string->bytes "abc") (mode 'dynamic))))
           (assert-equal (integer-bit-shift-right (integer-bit-and (bytes-nth stream 0) 6) 1) 2))))

      ; Every mode sets the final-block bit.
      (test-final-block-bit
       (lambda ()
         (and (assert-equal (integer-bit-and (bytes-nth (compress (string->bytes "abc") (mode 'stored)) 0) 1) 1)
              (and (assert-equal (integer-bit-and (bytes-nth (compress (string->bytes "abc") (mode 'fixed)) 0) 1) 1)
                   (assert-equal
                     (integer-bit-and (bytes-nth (compress (string->bytes "abc") (mode 'dynamic)) 0) 1)
                     1)))))

      ; Auto mode never exceeds the smallest single-mode output.
      (test-auto-smallest-output
       (lambda ()
         (let ((input (string->bytes "hello hello hello hello hello")))
           (let ((auto (bytes-length (compress input (mode 'auto))))
                 (stored (bytes-length (compress input (mode 'stored))))
                 (fixed (bytes-length (compress input (mode 'fixed))))
                 (dynamic (bytes-length (compress input (mode 'dynamic)))))
             (assert-equal (integer<=? auto (integer-min stored (integer-min fixed dynamic))) #t)))))

      ; Repetitive input compresses below its original size.
      (test-repetitive-compresses
       (lambda ()
         (let ((input (string->bytes (repeat "a" 1000))))
           (and (assert-equal (integer<? (bytes-length (compress input (mode 'fixed))) 1000) #t)
                (assert-equal (integer<? (bytes-length (compress input (mode 'dynamic))) 1000) #t)))))

      ; Stored output carries the original bytes verbatim.
      (test-stored-verbatim
       (lambda ()
         (let ((input (string->bytes "hello world")))
           (let ((stream (compress input (mode 'stored))))
             (assert-equal (bytes-index stream input) 5)))))

      ; Omitting the mode selects auto, so the result equals an explicit auto
      ; compression.
      (test-default-mode-is-auto
       (lambda ()
         (let ((input (string->bytes "hello hello hello")))
           (assert-equal (compress input) (compress input (mode 'auto))))))

      ; Repeated three-byte keys with differing continuations make the matcher
      ; compare several candidates for one key, and most of them cannot improve
      ; on the best match already found.
      (test-many-candidates-for-one-key
       (lambda ()
         (let ((text "abcXabcYabcZabcWabcVabcU"))
           (and (assert-equal (round-trip text (mode 'fixed)) text)
                (assert-equal (round-trip text (mode 'dynamic)) text)))))

      ; A key repeated further back than the match window is not a candidate, and
      ; the search stops at the first out-of-window position.
      (test-candidate-beyond-window
       (lambda ()
         (let ((text (string-concat "abc" (repeat "x" 40000) "abc")))
           (and (assert-equal (round-trip text (mode 'fixed)) text)
                (assert-equal (round-trip text (mode 'auto)) text)))))

      ; A pseudo-random text over a three-symbol alphabet has many three-byte keys
      ; with several candidates each, and candidates that share a shorter prefix
      ; with the current position than the best match so far.
      (test-dense-candidate-collisions
       (lambda ()
         (let ((symbols (vector "a" "b" "c"))

               (texts
                (map-list
                  (lambda (seed)
                    (let ((loop
                           (lambda (n state acc)
                             (if (integer>=? n 40)
                                 (list->string (list-reverse acc))
                                 (loop
                                   (integer+ n 1)
                                   (integer% (integer+ (integer* state 37) 11) 3)
                                   (list-prepend acc (vector-nth symbols state)))))))
                      (loop 0 (integer% seed 3) (list))))
                  (range 0 24))))
           (all-list?
             (lambda (text)
               (and (assert-equal (round-trip text (mode 'fixed)) text)
                    (assert-equal (round-trip text (mode 'dynamic)) text)))
             texts))))

      ; Auto mode round-trips inputs of every length up to 64, which reaches fixed
      ; Huffman blocks whose bit length is a whole number of bytes as well as ones
      ; that end mid-byte.
      (test-auto-length-sweep
       (lambda ()
         (let ((texts
                (map-list
                  (lambda (n)
                    (list->string
                      (map-list
                        (lambda (i)
                          (integer-codepoint->string (integer+ 97 (integer% i 3))))
                        (range 0 n))))
                  (range 1 65))))
           (all-list?
             (lambda (text)
               (assert-equal (round-trip text (mode 'auto)) text))
             texts))))

      ; Auto mode round-trips runs of varying length, which reaches fixed Huffman
      ; blocks of many different bit lengths as they are computed for comparison.
      (test-auto-run-length-sweep
       (lambda ()
         (let ((texts
                (map-list
                  (lambda (k)
                    (string-concat (repeat "a" (integer* 7 k)) (repeat "b" (integer* 5 k)) "z"))
                  (range 1 40))))
           (all-list?
             (lambda (text)
               (assert-equal (round-trip text (mode 'auto)) text))
             texts))))

      ; A candidate that shares the current position's three-byte key and matches at
      ; the best length so far, yet diverges before it, cannot improve the match.
      ; The text puts an old "abcze" behind a newer "abcd" so the weaker candidate is
      ; examined after the stronger one.
      (test-candidate-diverges-before-best
       (lambda ()
         (let ((text "abczeabcdabcdef"))
           (and (assert-equal (round-trip text (mode 'fixed)) text)
                (assert-equal (round-trip text (mode 'dynamic)) text)))))

      ; A stored block carries its length in sixteen bits, so an input larger than
      ; 65535 bytes needs more than one block.  At the limit exactly one block
      ; suffices.
      (test-stored-block-limit
       (lambda ()
         (let ((input (lcg-bytes 65535 1)))
           (assert-equal (round-trip-bytes input (mode 'stored)) #t))))

      ; One byte past the limit.  A single stored block cannot encode this, so it
      ; must be split.
      (test-stored-just-over-block-limit
       (lambda ()
         (let ((input (lcg-bytes 65536 1)))
           (assert-equal (round-trip-bytes input (mode 'stored)) #t))))

      ; Incompressible data far past the limit: auto mode picks the stored block
      ; because it is the shortest, so it must split too.
      (test-auto-incompressible-large
       (lambda ()
         (let ((input (lcg-bytes 66000 2)))
           (and (assert-equal (round-trip-bytes input (mode 'stored)) #t)
                (assert-equal (round-trip-bytes input (mode 'auto)) #t)))))

      ; A non-bytes argument is rejected.
      (test-rejects-non-bytes
       (lambda ()
         (compress "not bytes")))

      (tests
       (list
         (list
           "round-trip through decompress"
           (list
             (expect-pass "empty input, all modes" test-empty-all-modes)
             (expect-pass "single byte, all modes" test-single-byte-all-modes)
             (expect-pass "short text, all modes" test-short-text-all-modes)
             (expect-pass "repetitive text exercises back-references" test-repetitive-text-all-modes)
             (expect-pass "long run of a single byte" test-long-run)
             (expect-pass "repeating two-byte pattern" test-repeating-two-byte-pattern)
             (expect-pass "skewed alphabet favours dynamic coding" test-skewed-alphabet)
             (expect-pass "all byte values round-trip" test-all-byte-values)
             (expect-pass "auto round-trips a range of lengths" test-auto-range-of-lengths)))

         (list
           "block type selection"
           (list
             (expect-pass "stored mode emits a stored block" test-stored-block-type)
             (expect-pass "fixed mode emits a fixed Huffman block" test-fixed-block-type)
             (expect-pass "dynamic mode emits a dynamic Huffman block" test-dynamic-block-type)
             (expect-pass "every mode sets the final-block bit" test-final-block-bit)
             (expect-pass "auto never exceeds the smallest single-mode output" test-auto-smallest-output)))

         (list
           "compression"
           (list
             (expect-pass "repetitive input compresses below its original size" test-repetitive-compresses)
             (expect-pass "stored output carries the original bytes verbatim" test-stored-verbatim)
             (expect-pass "the mode defaults to auto" test-default-mode-is-auto)
             (expect-pass "several candidates for one key are compared" test-many-candidates-for-one-key)
             (expect-pass "a candidate beyond the window ends the search" test-candidate-beyond-window)
             (expect-pass "dense candidate collisions are resolved" test-dense-candidate-collisions)
             (expect-pass "auto round-trips every length up to 64" test-auto-length-sweep)
             (expect-pass "auto round-trips runs of varying length" test-auto-run-length-sweep)
             (expect-pass "a weaker candidate cannot improve the match" test-candidate-diverges-before-best)
             (expect-pass "a stored block holds exactly 65535 bytes" test-stored-block-limit)
             (expect-pass "a stored stream splits past 65535 bytes" test-stored-just-over-block-limit)
             (expect-pass "auto splits an incompressible input past 65535 bytes" test-auto-incompressible-large)))

         (list
           "errors"
           (list (expect-fail "rejects non-bytes argument" test-rejects-non-bytes "expects a bytes value"))))))

  (export tests))
