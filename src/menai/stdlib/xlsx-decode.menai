; xlsx-decode — decodes an XLSX package into a value tree.
;
; The input is a bytes value containing a .xlsx file and the output is a value
; tree describing the package's parts.  A .xlsx file is an OOXML package: a ZIP
; archive whose parts are XML documents (and media).  This module reads the
; package and decodes the parts, without interpreting the spreadsheetML
; semantics; a semantic workbook model is a separate concern layered on top.
;
; The result is a dict:
;
;   (dict
;     "workbook"       <element>              ; xl/workbook.xml, decoded
;     "relationships"  <dict>                 ; workbook rels: id -> relationship
;     "shared-strings" <list> or #none        ; xl/sharedStrings.xml, decoded <si> elements
;     "styles"         <element> or #none     ; xl/styles.xml, decoded
;     "theme"          <element> or #none     ; xl/theme/theme1.xml, decoded
;     "sheets"         <list>                 ; ordered, one entry per worksheet
;     "media"          <dict> or #none)       ; part name -> bytes
;
; An <element> is the value tree xml-decode produces for an XML document:
;
;   (dict "tag" <string> "attrs" <dict> "children" <list>)
;
; "workbook" is the decoded xl/workbook.xml and is always present: a package
; without it is not a workbook and raises.
;
; "sheets" is the workbook's worksheets in workbook order.  A sheet's order is
; not its part name: the order lives in the workbook part's <sheets>, each
; <sheet> naming a relationship id that resolves through the workbook's
; relationships to the worksheet part.  Each entry is a dict:
;
;   (dict
;     "name"          <string>              ; the sheet name, e.g. "Sheet1"
;     "part"          <string>              ; e.g. "xl/worksheets/sheet1.xml"
;     "element"       <element>             ; the decoded worksheet part
;     "relationships" <dict>)              ; the sheet's own rels: id -> relationship
;
; "name" is carried explicitly because the sheet name is workbook content, not
; derivable from the part name.  "relationships" carries the sheet's own
; relationships, read from xl/worksheets/_rels/<name>.rels; it is empty when the
; sheet has no relationships part.  A sheet's drawings and hyperlinks live in
; its own relationships, so dropping them would lose the sheet's content.
;
; "shared-strings" is the decoded xl/sharedStrings.xml's <si> elements, in
; order, or #none when the package carries no shared string table.  A cell whose
; type is "s" carries an index into this list as its value; the codec does not
; resolve the index, because resolution is interpretation and the codec stays a
; codec.
;
; "relationships" maps each relationship id declared in
; xl/_rels/workbook.xml.rels (e.g. "rId1") to a relationship dict:
;
;   (dict "type" <string> "target" <string> "mode" <string> or #none)
;
; "type" is the relationship type URI, "target" is the target, and "mode" is
; the target mode (e.g. "External") or #none when the relationship declares
; none.  Keeping the type is what makes the map usable: it is how a consumer
; tells a worksheet relationship from a styles or theme relationship.
;
; "styles" and "theme" are the decoded xl/styles.xml and xl/theme/theme1.xml, or
; #none when the package does not carry them.  "media" maps each part name under
; xl/media/ (e.g. "xl/media/image1.png") to its raw bytes, or is #none when the
; package carries no media.
;
; Namespace prefixes in the decoded XML are kept verbatim, exactly as
; xml-decode keeps them: a qualified name such as "r:id" stays "r:id" and is not
; resolved against its namespace declaration.
;
; The package is read with zip-extract, so a corrupt or unsupported ZIP raises
; from there.  A package whose xl/workbook.xml is not well-formed XML raises
; from xml-decode.
;
; It is the inverse of xlsx-encode's encode: for every value tree v that encode
; accepts, (decode (encode v)) reproduces v.

(letrec
  ((zip-extract (import "zip-extract"))
   (xml-decode (import "xml-decode"))

   (workbook-part "xl/workbook.xml")
   (workbook-rels-part "xl/_rels/workbook.xml.rels")
   (shared-strings-part "xl/sharedStrings.xml")
   (styles-part "xl/styles.xml")
   (theme-part "xl/theme/theme1.xml")
   (worksheets-prefix "xl/worksheets/")
   (media-prefix "xl/media/")

   ; The package's parts as a dict from part name to bytes.
   (parts-of
    (lambda (b)
      (fold-list
        (lambda (acc entry)
          (dict-with acc (dict-get entry "name") (dict-get entry "content")))
        (dict)
        (dict-get ((:: zip-extract extract) b) "entries"))))

   ; The decoded element for a part, or #none when the part is absent.
   (decode-part
    (lambda (parts name)
      (let ((content (dict-get parts name)))
        (if (bytes? content)
            ((:: xml-decode decode) (bytes->string content))
            #none))))

   ; The decoded element for a part that must be present.
   (decode-required-part
    (lambda (parts name)
      (let ((content (dict-get parts name)))
        (if (bytes? content)
            ((:: xml-decode decode) (bytes->string content))
            (error (string-concat "xlsx-decode: package has no " name))))))

   ; Add one <Relationship> element to the relationships dict.  A child that is
   ; not an element (the whitespace text nodes between the elements), or an
   ; element missing its Id, Type, or Target, contributes nothing.  The target
   ; mode is #none when the element declares none.
   (add-relationship
    (lambda (rels child)
      (if (dict? child)
          (let* ((attrs (dict-get child "attrs"))
                 (id (dict-get attrs "Id"))
                 (type (dict-get attrs "Type"))
                 (target (dict-get attrs "Target"))
                 (mode (dict-get attrs "TargetMode")))
            (if (and (string? id)
                     (string? type)
                     (string? target))
                (dict-with rels id (dict "type" type "target" target "mode" mode))
                rels))
          rels)))

   ; The relationships map from a decoded relationships part, or an empty map
   ; when the part is absent.  The root element's children are the
   ; <Relationship> elements.
   (relationships-of-part
    (lambda (parts name)
      (let ((root (decode-part parts name)))
        (if (dict? root)
            (fold-list add-relationship (dict) (dict-get root "children"))
            (dict)))))

   ; The workbook's relationships map.
   (relationships-of
    (lambda (parts)
      (relationships-of-part parts workbook-rels-part)))

   ; The relationship target of a relationship id, or #none when the id is
   ; unknown.
   (relationship-target
    (lambda (rels id)
      (if (string? id)
          (let ((relationship (dict-get rels id)))
            (if (dict? relationship)
                (dict-get relationship "target")
                #none))
          #none)))

   ; The part names under a prefix, in part-name order, restricted to parts with
   ; byte content so a directory entry is not mistaken for a part.
   (parts-under
    (lambda (parts prefix)
      (filter-list
        (lambda (name)
          (and (string-prefix? name prefix)
               (bytes? (dict-get parts name))))
        (dict-keys parts))))

   ; The final "/"-separated segment of a part name.
   (last-path-segment
    (lambda (name)
      (letrec ((loop
                (lambda (i found)
                  (if (integer>=? i (string-length name))
                      found
                      (loop
                        (integer+ i 1)
                        (if (string=? (string-nth name i) "/")
                            (integer+ i 1)
                            found))))))
        (string-slice name (loop 0 0)))))

   ; The <sheet> children of the workbook's <sheets>, in order.  The workbook
   ; part's children are the <sheets> element; its children are the <sheet>
   ; elements.  Returns an empty list when the workbook has no sheets list.
   (sheet-elements
    (lambda (workbook)
      (let ((lists
             (filter-list
               (lambda (child)
                 (and (dict? child)
                      (string=? (dict-get child "tag") "sheets")))
               (dict-get workbook "children"))))
        (if (list-null? lists)
            (list)
            (dict-get (list-first lists) "children")))))

   ; The relationship id carried by one <sheet> element, or #none.
   (sheet-relationship
    (lambda (child)
      (if (dict? child)
          (dict-get (dict-get child "attrs") "r:id")
          #none)))

   ; The sheet name carried by one <sheet> element, or #none.
   (sheet-name
    (lambda (child)
      (if (dict? child)
          (dict-get (dict-get child "attrs") "name")
          #none)))

   ; The worksheet part name for one <sheet> element.  The relationship target
   ; is relative to the workbook part's directory ("xl/"), so
   ; "worksheets/sheet1.xml" resolves to "xl/worksheets/sheet1.xml".  Raises when
   ; the relationship id is missing or does not resolve, because a sheet that
   ; cannot be located is a malformed package rather than a sheet to skip.
   (sheet-part-of
    (lambda (rels child)
      (let ((target (relationship-target rels (sheet-relationship child))))
        (if (string? target)
            (string-concat "xl/" target)
            (error "xlsx-decode: a sheet has no resolvable relationship")))))

   ; One sheet entry: the sheet's name, its part name, its decoded element, and
   ; its own relationships.
   (sheet-entry
    (lambda (parts rels child)
      (let ((part (sheet-part-of rels child)))
        (dict "name" (sheet-name child)
              "part" part
              "element" (decode-required-part parts part)
              "relationships" (relationships-of-part
                                parts
                                (string-concat "xl/worksheets/_rels/" (last-path-segment part) ".rels"))))))

   ; The workbook's sheets, in workbook order.
   (sheets-of
    (lambda (parts workbook)
      (let ((rels (relationships-of parts)))
        (map-list
          (lambda (child)
            (sheet-entry parts rels child))
          (sheet-elements workbook)))))

   ; The decoded <si> elements of the shared string table, or #none when the
   ; part is absent.
   (shared-strings-of
    (lambda (parts)
      (let ((root (decode-part parts shared-strings-part)))
        (if (dict? root)
            (filter-list
              (lambda (child)
                (and (dict? child)
                     (string=? (dict-get child "tag") "si")))
              (dict-get root "children"))
            #none))))

   ; The media parts as a dict from part name to bytes, or #none when there are
   ; none.
   (media-of
    (lambda (parts)
      (let ((names (parts-under parts media-prefix)))
        (if (list-null? names)
            #none
            (fold-list
              (lambda (acc name)
                (dict-with acc name (dict-get parts name)))
              (dict)
              names)))))

   ; Decode a bytes value containing an XLSX package into a value tree.  It is
   ; the inverse of xlsx-encode's encode.
   (decode
    (lambda (b)
      (if (bytes? b)
          (let* ((parts (parts-of b))
                 (workbook (decode-required-part parts workbook-part)))
            (dict "workbook" workbook
                  "relationships" (relationships-of parts)
                  "shared-strings" (shared-strings-of parts)
                  "styles" (decode-part parts styles-part)
                  "theme" (decode-part parts theme-part)
                  "sheets" (sheets-of parts workbook)
                  "media" (media-of parts)))
          (error "xlsx-decode: decode expects a bytes value")))))

  (export decode))
