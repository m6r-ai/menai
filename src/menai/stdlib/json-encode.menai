; json-encode — encodes a Menai value as JSON text.
;
; A structure's output is built as a list of string chunks and joined once with
; list->string, so encoding an n-element structure costs O(n) string copies
; rather than the O(n^2) of repeated string-concat.
;
; Numbers: integers are emitted in decimal.  Floats are emitted with
; float->string, whose exponent sign is then normalised, because JSON does not
; permit a leading "+" in an exponent.  float->string always includes a "." or
; an exponent, so a float never encodes as something that decodes back to an
; integer.
;
; Strings are emitted with the two mandatory escapes (" and \) plus the short
; escapes JSON defines for backspace, form feed, newline, carriage return, and
; tab.  Every other control character below U+0020 is emitted as a \u escape.
; All other characters are emitted literally.
;
; A string's body is examined as UTF-8 bytes, so a character that needs no
; escaping — which is most of them — costs a byte read and a comparison rather
; than a one-character string; a string with nothing to escape is emitted as it
; stands, with no copy of its contents.

(let ((quote-code 34)
      (backslash-code 92)

      ; #t when a byte must be escaped in a string body: the quote, the backslash,
      ; and every control character below U+0020.
      (needs-escape?
       (lambda (b)
         (or (integer=? b quote-code)
             (integer=? b backslash-code)
             (integer<? b 32))))

      ; #t when the body contains no byte that needs escaping.
      (needs-no-escape?
       (lambda (body n)
         (let ((loop
                (lambda (i)
                  (if (integer>=? i n)
                      #t
                      (if (needs-escape? (bytes-nth body i))
                          #f
                          (loop (integer+ i 1)))))))
           (loop 0))))

      ; The byte value of the hex digit for a value in [0, 16).  Only the low
      ; nibble of a control character's escape can need a letter, because a byte
      ; below U+0020 has a high nibble of 0 or 1.
      (hex-digit
       (lambda (v)
         (if (integer<? v 10)
             (integer+ 48 v)
             (integer+ 87 v))))

      ; Append the escape for one byte to a reversed output accumulator.
      (prepend-escape
       (lambda (out b)
         (match b
           (34 (list-prepend (list-prepend out backslash-code) quote-code))
           (92 (list-prepend (list-prepend out backslash-code) backslash-code))
           (8 (list-prepend (list-prepend out backslash-code) 98))
           (12 (list-prepend (list-prepend out backslash-code) 102))
           (10 (list-prepend (list-prepend out backslash-code) 110))
           (13 (list-prepend (list-prepend out backslash-code) 114))
           (9 (list-prepend (list-prepend out backslash-code) 116))
           (_
            (list-prepend
              (list-prepend
                (list-prepend (list-prepend (list-prepend (list-prepend out backslash-code) 117) 48) 48)
                (integer+ 48 (integer/ b 16)))
              (hex-digit (integer% b 16)))))))

      ; The escaped form of a string body, from its UTF-8 bytes.
      (escape-body
       (lambda (body n)
         (let ((loop
                (lambda (i out)
                  (if (integer>=? i n)
                      (bytes->string (list->bytes (list-reverse out)))
                      (let ((b (bytes-nth body i)))
                        (loop
                          (integer+ i 1)
                          (if (needs-escape? b)
                              (prepend-escape out b)
                              (list-prepend out b))))))))
           (loop 0 (list)))))

      ; Escape a whole string, returning its JSON source text including quotes.
      (encode-string
       (lambda (s)
         (let ((body (string->bytes s)))
           (let ((n (bytes-length body)))
             (string-concat
               "\""
               (if (needs-no-escape? body n)
                   s
                   (escape-body body n))
               "\"")))))

      ; Normalise a float's textual form for JSON: drop a "+" immediately after
      ; the exponent marker, which JSON does not allow.
      (encode-float
       (lambda (f)
         (let ((text (float->string f))
               (e-pos (find-exponent text)))
           (if (none? e-pos)
               text
               (if (string=? (string-slice text (integer+ e-pos 1) (integer+ e-pos 2)) "+")
                   (string-concat
                     (string-slice text 0 (integer+ e-pos 1))
                     (string-slice text (integer+ e-pos 2) (string-length text)))
                   text)))))

      ; Return the index of the exponent marker in a float's textual form, or
      ; #none.  float->string writes the marker in lower case, so there is one
      ; form to look for.
      (find-exponent
       (lambda (text)
         (string-index text "e")))

      ; Encode a list as a JSON array, joining elements with commas.
      (encode-list
       (lambda (lst)
         (let ((loop
                (lambda (rest acc first)
                  (if (list-null? rest)
                      (list->string (list-reverse (list-prepend acc "]")))
                      (loop
                        (list-rest rest)
                        (list-prepend
                          (if first
                              acc
                              (list-prepend acc ","))
                          (encode (list-first rest)))
                        #f)))))
           (loop lst (list "[") #t))))

      ; Encode a dict as a JSON object.  Keys must be strings; a non-string key
      ; raises.  The dict's insertion order is preserved.
      (encode-object
       (lambda (d)
         (let ((loop
                (lambda (keys acc first)
                  (if (list-null? keys)
                      (list->string (list-reverse (list-prepend acc "}")))
                      (let ((k (list-first keys)))
                        (let ((acc2
                               (if first
                                   acc
                                   (list-prepend acc ",")))

                              (acc3 (list-prepend acc2 (encode-string k)))
                              (acc4 (list-prepend acc3 ":")))
                          (loop (list-rest keys) (list-prepend acc4 (encode (dict-get d k))) #f)))))))
           (loop (dict-keys d) (list "{") #t))))

      ; Encode a Menai value as a string containing the equivalent JSON.  It is
      ; the inverse of json-decode's decode: for every value that encode accepts,
      ; (decode (encode v)) reproduces v.
      ;
      ; The value-to-JSON mapping is:
      ;
      ;   dict            -> JSON object (keys must be strings)
      ;   list            -> JSON array
      ;   string          -> JSON string
      ;   integer         -> JSON integer
      ;   float           -> JSON float
      ;   #t / #f         -> JSON true / false
      ;   #none           -> JSON null
      ;
      ; Values with no JSON representation (bytes, symbol, vector, set, complex, and
      ; functions) raise a runtime error, as does a dict with a non-string key.
      (encode
       (lambda (v)
         (match v
           ((? none? _) "null")
           ((? boolean? b) (if b "true" "false"))
           ((? integer? n) (integer->string n))
           ((? float? f) (encode-float f))
           ((? string? s) (encode-string s))
           ((? list? l) (encode-list l))
           ((? dict? d) (encode-object d))
           (_ (error "json-encode: value has no JSON representation"))))))

  (export encode))
