; Round-trip tests for jpeg-decode.menai and jpeg-encode.menai
;
; JPEG is lossy, so unlike the other codec pairs here (decode (encode v)) is not
; v.  What is asserted is that the re-encoded image has the same dimensions and
; channel count, and that every channel is within 12 levels of the image it came
; from.  The bound is what re-quantising an already-quantised image costs at the
; quality jpeg-encode uses; a fault in either direction breaks it by far more
; than that.

(let ((jpeg-decode (import "jpeg-decode"))
      (jpeg-encode (import "jpeg-encode"))
      (t (import "menai-test"))
      (decode (:: jpeg-decode decode))
      (encode (:: jpeg-encode encode))
      (assert-equal (:: t assert-equal))
      (expect-pass (:: t expect-pass))

      ; Every channel of a pixel grid, flattened into one list.
      (channels
       (lambda (pixels)
         (fold-vector
           list-concat
           (list)
           (map-vector
             (lambda (row) (fold-vector list-concat (list) (map-vector vector->list row)))
             pixels))))

      ; The largest difference between corresponding channels of two grids.
      (worst-difference
       (lambda (actual expected)
         (fold-list
           integer-max
           0
           (map-list
             (lambda (pair)
               (integer-abs (integer- (list-nth pair 0) (list-nth pair 1))))
             (list-zip actual expected)))))


      (fixture-gradient-444
       (bytes-concat
                (string-hex->bytes "ffd8ffe000104a46494600010100000100010000ffdb0043000201010101010201010102020202020403")
                (string-hex->bytes "020202020504040304060506060605060606070908060709070606080b08090a0a0a0a0a06080b0c0b0a")
                (string-hex->bytes "0c090a0a0affdb004301020202020202050303050a0706070a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a")
                (string-hex->bytes "0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0affc00011080010001003")
                (string-hex->bytes "011100021101031101ffc4001f0000010501010101010100000000000000000102030405060708090a0b")
                (string-hex->bytes "ffc400b5100002010303020403050504040000017d010203000411051221314106135161072271143281")
                (string-hex->bytes "91a1082342b1c11552d1f02433627282090a161718191a25262728292a3435363738393a434445464748")
                (string-hex->bytes "494a535455565758595a636465666768696a737475767778797a838485868788898a9293949596979899")
                (string-hex->bytes "9aa2a3a4a5a6a7a8a9aab2b3b4b5b6b7b8b9bac2c3c4c5c6c7c8c9cad2d3d4d5d6d7d8d9dae1e2e3e4e5")
                (string-hex->bytes "e6e7e8e9eaf1f2f3f4f5f6f7f8f9faffc4001f0100030101010101010101010000000000000102030405")
                (string-hex->bytes "060708090a0bffc400b51100020102040403040705040400010277000102031104052131061241510761")
                (string-hex->bytes "711322328108144291a1b1c109233352f0156272d10a162434e125f11718191a262728292a3536373839")
                (string-hex->bytes "3a434445464748494a535455565758595a636465666768696a737475767778797a82838485868788898a")
                (string-hex->bytes "92939495969798999aa2a3a4a5a6a7a8a9aab2b3b4b5b6b7b8b9bac2c3c4c5c6c7c8c9cad2d3d4d5d6d7")
                (string-hex->bytes "d8d9dae2e3e4e5e6e7e8e9eaf2f3f4f5f6f7f8f9faffda000c03010002110311003f00fcdff831fb21ff")
                (string-hex->bytes "00aaff00895fa7f05183c67987879e21fc1ef9f5b7c17fd90f3e57fc4afd3f82beab078cdb53fbafc3cf")
                (string-hex->bytes "10fe0f7cfa53e0bfec878f2bfe257e9fc15f95e0f19b6a7f853e1e7887f07be7d6df063f643ff55ff12b")
                (string-hex->bytes "f4fe0afaac1e33ccfeebf0f3c43f83df3fffd9")))

      (fixture-gradient-420
       (bytes-concat
                (string-hex->bytes "ffd8ffe000104a46494600010100000100010000ffdb0043000503040404030504040405050506070c08")
                (string-hex->bytes "070707070f0b0b090c110f1212110f111113161c1713141a1511111821181a1d1d1f1f1f13172224221e")
                (string-hex->bytes "241c1e1f1effdb0043010505050706070e08080e1e1411141e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e")
                (string-hex->bytes "1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1effc00011080010001003")
                (string-hex->bytes "012200021101031101ffc4001f0000010501010101010100000000000000000102030405060708090a0b")
                (string-hex->bytes "ffc400b5100002010303020403050504040000017d010203000411051221314106135161072271143281")
                (string-hex->bytes "91a1082342b1c11552d1f02433627282090a161718191a25262728292a3435363738393a434445464748")
                (string-hex->bytes "494a535455565758595a636465666768696a737475767778797a838485868788898a9293949596979899")
                (string-hex->bytes "9aa2a3a4a5a6a7a8a9aab2b3b4b5b6b7b8b9bac2c3c4c5c6c7c8c9cad2d3d4d5d6d7d8d9dae1e2e3e4e5")
                (string-hex->bytes "e6e7e8e9eaf1f2f3f4f5f6f7f8f9faffc4001f0100030101010101010101010000000000000102030405")
                (string-hex->bytes "060708090a0bffc400b51100020102040403040705040400010277000102031104052131061241510761")
                (string-hex->bytes "711322328108144291a1b1c109233352f0156272d10a162434e125f11718191a262728292a3536373839")
                (string-hex->bytes "3a434445464748494a535455565758595a636465666768696a737475767778797a82838485868788898a")
                (string-hex->bytes "92939495969798999aa2a3a4a5a6a7a8a9aab2b3b4b5b6b7b8b9bac2c3c4c5c6c7c8c9cad2d3d4d5d6d7")
                (string-hex->bytes "d8d9dae2e3e4e5e6e7e8e9eaf2f3f4f5f6f7f8f9faffda000c03010002110311003f00f0cf0ef843eefe")
                (string-hex->bytes "ebf4af49f0e7843eefeebf4aeefc39e10fbbfbafd2bd27c3be10fbbfbafd28c3624382b8d7e1f78fffd9")))


      (test-fixture-gradient-444
       (lambda ()
         (let ((image (decode fixture-gradient-444)))
           (let ((again (decode (encode image))))
             (and
               (assert-equal (dict-get (dict-get again "header") "height") 16)
               (assert-equal (dict-get (dict-get again "header") "width") 16)
               (assert-equal (dict-get (dict-get again "meta") "channels") 3)
               (integer<=?
                 (worst-difference
                   (channels (dict-get again "pixels"))
                   (channels (dict-get image "pixels")))
                 12))))))

      (test-fixture-gradient-420
       (lambda ()
         (let ((image (decode fixture-gradient-420)))
           (let ((again (decode (encode image))))
             (and
               (assert-equal (dict-get (dict-get again "header") "height") 16)
               (assert-equal (dict-get (dict-get again "header") "width") 16)
               (assert-equal (dict-get (dict-get again "meta") "channels") 3)
               (integer<=?
                 (worst-difference
                   (channels (dict-get again "pixels"))
                   (channels (dict-get image "pixels")))
                 12))))))

      (tests
         (list
           (list "round trip"
                 (list
                   (expect-pass "fixture-gradient-444" test-fixture-gradient-444)
                   (expect-pass "fixture-gradient-420" test-fixture-gradient-420))))))

  (export tests))
