; Tests for json-encode.menai

(let ((json-encode (import "json-encode"))
      (t (import "menai-test"))
      (encode (:: json-encode encode))
      (assert-equal (:: t assert-equal))
      (expect-pass (:: t expect-pass))
      (expect-fail (:: t expect-fail))

      ; #none encodes to null.
      (test-scalar-null
       (lambda ()
         (assert-equal (encode #none) "null")))

      ; #t encodes to true.
      (test-scalar-true
       (lambda ()
         (assert-equal (encode #t) "true")))

      ; #f encodes to false.
      (test-scalar-false
       (lambda ()
         (assert-equal (encode #f) "false")))

      ; An integer encodes to its decimal form.
      (test-scalar-integer
       (lambda ()
         (assert-equal (encode 42) "42")))

      ; A negative integer encodes to its decimal form.
      (test-scalar-negative-integer
       (lambda ()
         (assert-equal (encode -7) "-7")))

      ; A float encodes to its decimal form.
      (test-scalar-float
       (lambda ()
         (assert-equal (encode 3.14) "3.14")))

      ; A float with a positive exponent drops the plus sign.
      (test-scalar-float-positive-exponent
       (lambda ()
         (assert-equal (encode 1e10) "1e10")))

      ; A float with a negative exponent keeps the minus sign.
      (test-scalar-float-negative-exponent
       (lambda ()
         (assert-equal (encode 0.001) "0.001")))

      ; The empty string encodes to an empty JSON string.
      (test-string-empty
       (lambda ()
         (assert-equal (encode "") "\"\"")))

      ; A simple string encodes to itself, quoted.
      (test-string-simple
       (lambda ()
         (assert-equal (encode "hello") "\"hello\"")))

      ; A double quote is escaped.
      (test-escape-double-quote
       (lambda ()
         (assert-equal (encode "\"") "\"\\\"\"")))

      ; A backslash is escaped.
      (test-escape-backslash
       (lambda ()
         (assert-equal (encode "\\") "\"\\\\\"")))

      ; A newline is escaped.
      (test-escape-newline
       (lambda ()
         (assert-equal (encode "\n") "\"\\n\"")))

      ; A tab is escaped.
      (test-escape-tab
       (lambda ()
         (assert-equal (encode "\t") "\"\\t\"")))

      ; A carriage return is escaped.
      (test-escape-carriage-return
       (lambda ()
         (assert-equal (encode "\r") "\"\\r\"")))

      ; A form feed is escaped.
      (test-escape-form-feed
       (lambda ()
         (assert-equal (encode "\u000c") "\"\\f\"")))

      ; A backspace is escaped.
      (test-escape-backspace
       (lambda ()
         (assert-equal (encode "\u0008") "\"\\b\"")))

      ; Any other control character is escaped as a unicode escape.
      (test-escape-other-control
       (lambda ()
         (assert-equal (encode "\u0001") "\"\\u0001\"")))

      ; An empty list encodes to an empty JSON array.
      (test-collection-empty-array
       (lambda ()
         (assert-equal (encode (list)) "[]")))

      ; A list of integers encodes to a JSON array.
      (test-collection-integer-array
       (lambda ()
         (assert-equal (encode (list 1 2 3)) "[1,2,3]")))

      ; A nested list encodes to a nested JSON array.
      (test-collection-nested-array
       (lambda ()
         (assert-equal (encode (list (list 1 2) (list 3 4))) "[[1,2],[3,4]]")))

      ; An empty dict encodes to an empty JSON object.
      (test-collection-empty-object
       (lambda ()
         (assert-equal (encode (dict)) "{}")))

      ; A single-key dict encodes to a JSON object.
      (test-collection-single-key
       (lambda ()
         (assert-equal (encode (dict "a" 1)) "{\"a\":1}")))

      ; A multi-key dict preserves insertion order.
      (test-collection-multi-key
       (lambda ()
         (assert-equal (encode (dict "a" 1 "b" 2)) "{\"a\":1,\"b\":2}")))

      ; A nested dict encodes to a nested JSON object.
      (test-collection-nested-object
       (lambda ()
         (assert-equal (encode (dict "a" (dict "b" 2))) "{\"a\":{\"b\":2}}")))

      ; A bytes value has no JSON representation.
      (test-rejects-bytes
       (lambda ()
         (encode (string->bytes "abc"))))

      ; A symbol has no JSON representation.
      (test-rejects-symbol
       (lambda ()
         (encode 'foo)))

      ; A vector has no JSON representation.
      (test-rejects-vector
       (lambda ()
         (encode (vector 1 2 3))))

      ; A set has no JSON representation.
      (test-rejects-set
       (lambda ()
         (encode (set 1 2 3))))

      ; A complex value has no JSON representation.
      (test-rejects-complex
       (lambda ()
         (encode (float->complex 1.0 2.0))))

      ; A dict with a non-string key is rejected.
      (test-rejects-non-string-key
       (lambda ()
         (encode (dict 1 "value"))))

      (tests
       (list
         (list
           "scalars"
           (list
             (expect-pass "null" test-scalar-null)
             (expect-pass "true" test-scalar-true)
             (expect-pass "false" test-scalar-false)
             (expect-pass "integer" test-scalar-integer)
             (expect-pass "negative integer" test-scalar-negative-integer)
             (expect-pass "float" test-scalar-float)
             (expect-pass "float with positive exponent drops the plus sign" test-scalar-float-positive-exponent)
             (expect-pass "float with negative exponent" test-scalar-float-negative-exponent)))

         (list
           "strings"
           (list
             (expect-pass "empty string" test-string-empty)
             (expect-pass "simple string" test-string-simple)
             (list
               "escapes"
               (list
                 (expect-pass "double quote" test-escape-double-quote)
                 (expect-pass "backslash" test-escape-backslash)
                 (expect-pass "newline" test-escape-newline)
                 (expect-pass "tab" test-escape-tab)
                 (expect-pass "carriage return" test-escape-carriage-return)
                 (expect-pass "form feed" test-escape-form-feed)
                 (expect-pass "backspace" test-escape-backspace)
                 (expect-pass "other control character" test-escape-other-control)))))

         (list
           "collections"
           (list
             (expect-pass "empty array" test-collection-empty-array)
             (expect-pass "integer array" test-collection-integer-array)
             (expect-pass "nested array" test-collection-nested-array)
             (expect-pass "empty object" test-collection-empty-object)
             (expect-pass "single-key object" test-collection-single-key)
             (expect-pass "multi-key object preserves insertion order" test-collection-multi-key)
             (expect-pass "nested object" test-collection-nested-object)))

         (list
           "errors"
           (list
             (expect-fail "bytes has no JSON representation" test-rejects-bytes "no JSON representation")
             (expect-fail "symbol has no JSON representation" test-rejects-symbol "no JSON representation")
             (expect-fail "vector has no JSON representation" test-rejects-vector "no JSON representation")
             (expect-fail "set has no JSON representation" test-rejects-set "no JSON representation")
             (expect-fail "complex has no JSON representation" test-rejects-complex "no JSON representation")
             (expect-fail "non-string dict key" test-rejects-non-string-key "dict keys must be strings"))))))

  (export tests))
