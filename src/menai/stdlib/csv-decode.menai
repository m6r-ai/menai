; csv-decode — decodes CSV text into a table of field strings.
;
; The decoder follows RFC 4180: fields may be quoted with double quotes, a
; quoted field may contain the delimiter, line terminators, and doubled quotes
; ("" represents a literal "), and records are separated by line terminators.
; Both CRLF and a bare LF are accepted as a line terminator, and a CRLF pair
; counts as a single terminator.  A single trailing line terminator does not
; produce a final empty row, but a genuinely blank line does produce a row
; containing one empty field.
;
; Every field is returned as a string; no type coercion is performed.  The
; result is a vector of rows, each row a vector of field strings, so that both
; rows and fields are reachable in O(1) by position:
;
;   #vector(#vector("a" "b") #vector("c" "d"))
;
; A header row can be turned into per-row dicts by the caller, for example by
; zipping the first row against each subsequent row with list-zip.  That is
; deliberately not part of this module: it is a policy decision (duplicate
; header names, ragged rows) that belongs to the caller.
;
; Scanning is native: `string-index-any` finds the end of an unquoted field as
; the first delimiter or line terminator, `string-index` finds the next quote,
; and a field is taken as a slice of the input rather than assembled from its
; characters.  Only a quoted field that actually contains a doubled quote is
; built up, because that is the one case where the field is not a contiguous
; run of the input.
;
; Malformed input raises a runtime error: an unterminated quoted field, or a
; character following a closing quote other than the delimiter or a line
; terminator.

(let (; The dispatch tag after-field returns: another field follows in the same row
      ; (field), the row ends (row), or the input ends (end).
      (after-field-tag (enum (field row end)))

      (is-line-terminator?
       (lambda (ch)
         (or (string=? ch "\n")
             (string=? ch "\r"))))

      ; The index of `needle` in the text from `pos` onwards, or #none.
      (index-from
       (lambda (s pos needle)
         (let ((i (string-index (string-slice s pos) needle)))
           (if (none? i)
               #none
               (integer+ i pos)))))

      ; The number of characters from `i` to the end of the unquoted field that
      ; starts there: the first delimiter or line terminator.  `stop` is that set
      ; of characters, as the flat ranges `string-index-any` takes, so a field
      ; costs one native scan of its own length.
      (unquoted-length
       (lambda (s i stop)
         (let ((rest (string-slice s i)))
           (let ((hit (string-index-any rest stop)))
             (if (none? hit)
                 (string-length rest)
                 hit)))))

      ; The number of characters consumed by the line terminator at `i`: 2 for a
      ; CRLF pair, 1 for a bare CR or LF.  `i` must be at a line terminator.
      (terminator-length
       (lambda (s i)
         (if (and (string=? (string-nth s i) "\r")
                  (integer<? (integer+ i 1) (string-length s))
                  (string=? (string-nth s (integer+ i 1)) "\n"))
             2
             1)))

      ; Scan an unquoted field starting at `i`, stopping at the delimiter, a line
      ; terminator, or end of input.  Returns (list <field-string> <next-pos>).
      (scan-unquoted
       (lambda (s i stop)
         (let ((end (integer+ i (unquoted-length s i stop))))
           (list (string-slice s i end) end))))

      ; Whether the quote at `q` is the first of a doubled quote.
      (doubled-quote-at?
       (lambda (s q)
         (and (integer<? (integer+ q 1) (string-length s))
              (string=? (string-nth s (integer+ q 1)) "\""))))

      ; The value of a quoted field that contains a doubled quote, from the run
      ; ending at the first one.  The caller has already found the closing quote
      ; of every later run, so this is the only case that assembles a value from
      ; more than one run of the input.
      (scan-quoted-escaped
       (lambda (s start q)
         (let ((loop
                (lambda (pos acc)
                  (let ((q2 (index-from s pos "\"")))
                    (if (none? q2)
                        (error "Unterminated quoted field in CSV input")
                        (if (doubled-quote-at? s q2)
                            (loop (integer+ q2 2) (list-prepend (list-prepend acc (string-slice s pos q2)) "\""))
                            (list
                              (list->string (list-reverse (list-prepend acc (string-slice s pos q2))))
                              (integer+ q2 1))))))))
           (loop (integer+ q 2) (list-prepend (list-prepend (list) (string-slice s start q)) "\"")))))

      ; Scan a quoted field starting at `i`, where `i` is the position of the
      ; opening quote.  A doubled quote inside the field is an escaped quote; the
      ; field ends at a quote not followed by another quote.  Returns
      ; (list <field-string> <next-pos>), where next-pos is the position just
      ; after the closing quote.
      (scan-quoted
       (lambda (s i)
         (let ((start (integer+ i 1)))
           (let ((q (index-from s start "\"")))
             (if (none? q)
                 (error "Unterminated quoted field in CSV input")
                 (if (doubled-quote-at? s q)
                     (scan-quoted-escaped s start q)
                     (list (string-slice s start q) (integer+ q 1))))))))

      ; Parse one field at `i`.  Returns (list <field-string> <next-pos>).
      (parse-field
       (lambda (s i delim stop)
         (if (and (integer<? i (string-length s))
                  (string=? (string-nth s i) "\""))
             (scan-quoted s i)
             (scan-unquoted s i stop))))

      ; After a field ends at `pos`, consume the separator that follows and decide
      ; whether the row continues, ends, or the input ends.  Returns a dispatch tag
      ; and the next position:
      ;   (list (after-field-tag 'field) <pos>) — another field follows in the same row
      ;   (list (after-field-tag 'row)   <pos>) — the row ends; pos is just past the terminator
      ;   (list (after-field-tag 'end)   <pos>) — the input ends immediately after this field
      (after-field
       (lambda (s pos delim)
         (if (integer>=? pos (string-length s))
             (list (after-field-tag 'end) pos)
             (let ((ch (string-nth s pos)))
               (if (string=? ch delim)
                   (list (after-field-tag 'field) (integer+ pos 1))
                   (if (is-line-terminator? ch)
                       (list (after-field-tag 'row) (integer+ pos (terminator-length s pos)))
                       (error "Unexpected character after quoted field in CSV input")))))))

      ; Decode CSV text into a vector of rows (each a vector of field strings).
      ; The optional second argument is the field delimiter, a single-character
      ; string; it defaults to ",".
      (decode
       (lambda (csv-string . rest)
         (if (string? csv-string)
             (let ((delim
                    (if (list-null? rest)
                        ","
                        (list-first rest))))
               (if (and (string? delim)
                        (integer=? (string-length delim) 1))
                   (let ((stop
                          (let ((cp (string->integer-codepoint delim)))
                            (vector cp cp 13 13 10 10)))

                         (finish
                          (lambda (rows-acc row)
                            (list->vector
                              (map-list list->vector (list-reverse (list-prepend rows-acc (list-reverse row)))))))

                         (loop
                          (lambda (i row-acc rows-acc)
                            (let ((field-result (parse-field csv-string i delim stop))
                                  (field (list-first field-result))
                                  (pos (list-nth field-result 1))
                                  (row (list-prepend row-acc field))
                                  (dispatch (after-field csv-string pos delim))
                                  (tag (list-first dispatch))
                                  (next (list-nth dispatch 1)))
                              (match tag
                                ((: after-field-tag 'field) (loop next row rows-acc))
                                ((: after-field-tag 'row)
                                 (if (integer>=? next (string-length csv-string))
                                     ; A single trailing terminator ends the
                                     ; last row without starting a new one.
                                     (finish rows-acc row)
                                     (loop next (list) (list-prepend rows-acc (list-reverse row)))))
                                ((: after-field-tag 'end) (finish rows-acc row)))))))
                     (loop 0 (list) (list)))
                   (error "CSV delimiter must be a single-character string")))
             (error "CSV input must be a string")))))

  (export decode))
