; html-encode — serialises an HTML value tree to text.
;
; The input is a value tree in the shape html-decode produces and the output is a
; string containing HTML.  An element is a dict:
;
;   (dict "tag" <string> "attrs" <dict> "children" <list>)
;
; "tag" is the element's name, emitted verbatim.  "attrs" maps each attribute's
; name to its value, which must be a string.  "children" is an ordered list of
; nodes, where each node is either a string (a text node) or an element dict.
;
; Two reserved tags are written as the declarations they capture rather than as
; elements:
;
;   (dict "tag" "!doctype" ...)  →  <!DOCTYPE text>
;   (dict "tag" "!--" ...)       →  <!--text-->
;
; The top-level value is a list of nodes, which is what html-decode returns.
;
; It is the inverse of html-decode's decode: for every value tree v that encode
; accepts, (decode (encode v)) reproduces v.
;
; Text is escaped minimally: "&", "<", and ">" become &amp;, &lt;, and &gt;.
; Attribute values additionally escape "\"".  Every other character, including
; non-ASCII, is emitted literally, because the output is a UTF-8 string.
;
; An element with no children is written with an explicit end tag rather than
; self-closing, because HTML has no self-closing syntax outside foreign content:
; "<div/>" is not a "<div>" to a browser.  The output is a single unbroken
; document with no added whitespace, so it does not reproduce the incidental
; formatting of any input document.  This is a value round-trip, not a byte
; round-trip.
;
; A value that is not a well-formed node tree raises a runtime error: a missing
; or non-string "tag", a non-dict "attrs", a non-list "children", a non-string
; attribute value, or a child that is neither a string nor an element dict.

(let ((escape-text-char
       (lambda (ch)
         (match ch
           ("&" "&amp;")
           ("<" "&lt;")
           (">" "&gt;")
           (_ ch))))

      (escape-attribute-char
       (lambda (ch)
         (match ch
           ("&" "&amp;")
           ("<" "&lt;")
           (">" "&gt;")
           ("\"" "&quot;")
           (_ ch))))

      (escape
       (lambda (s escape-char)
         (let ((loop
                (lambda (i acc)
                  (if (integer>=? i (string-length s))
                      (list->string (list-reverse acc))
                      (loop (integer+ i 1) (list-prepend acc (escape-char (string-nth s i))))))))
           (loop 0 (list)))))

      ; One attribute as " name=\"value\"".
      (encode-attribute
       (lambda (name value)
         (if (string? name)
             (if (string? value)
                 (string-concat " " name "=\"" (escape value escape-attribute-char) "\"")
                 (error (string-concat "html-encode: attribute \"" name "\" value must be a string")))
             (error "html-encode: attribute name must be a string"))))

      (encode-attributes
       (lambda (attrs)
         (if (dict? attrs)
             (list->string
               (map-list
                 (lambda (name)
                   (encode-attribute name (dict-get attrs name)))
                 (dict-keys attrs)))
             (error "html-encode: \"attrs\" must be a dict"))))

      ; The concatenation of an element's children, each node encoded in order.
      (encode-children
       (lambda (children)
         (if (list? children)
             (list->string (map-list encode-node children))
             (error "html-encode: \"children\" must be a list"))))

      ; The text of a node whose children are a single string, as the doctype and
      ; comment nodes carry.
      (declaration-text
       (lambda (children)
         (if (list? children)
             (list->string (map-list encode-declaration-part children))
             (error "html-encode: \"children\" must be a list"))))

      (encode-declaration-part
       (lambda (part)
         (if (string? part)
             part
             (error "html-encode: a doctype or comment child must be a string"))))

      ; One node: text is escaped, an element dict is serialised.
      (encode-node
       (lambda (node)
         (if (string? node)
             (escape node escape-text-char)
             (if (dict? node)
                 (encode-element node)
                 (error "html-encode: a node must be a string or an element dict")))))

      ; One element as "<tag attrs>children</tag>".
      (encode-element
       (lambda (element)
         (let ((tag (dict-get element "tag"))
               (attrs (dict-get element "attrs"))
               (children (dict-get element "children")))
           (if (string? tag)
               (if (string=? tag "!doctype")
                   (string-concat "<!DOCTYPE " (declaration-text children) ">")
                   (if (string=? tag "!--")
                       (string-concat "<!--" (declaration-text children) "-->")
                       (string-concat "<" tag (encode-attributes attrs) ">" (encode-children children) "</" tag ">")))
               (error "html-encode: element \"tag\" must be a string")))))

      (encode
       (lambda (v)
         (if (list? v)
             (list->string (map-list encode-node v))
             (error "html-encode: encode expects a list of nodes")))))

  (export encode))
