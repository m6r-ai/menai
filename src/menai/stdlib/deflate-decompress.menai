; deflate-decompress — raw DEFLATE decompressor (RFC 1951).
;
; All three DEFLATE block types are supported: stored (BTYPE = 00), fixed
; Huffman (BTYPE = 01), and dynamic Huffman (BTYPE = 10).  Invalid block types
; (BTYPE = 11) are rejected.
;
; The bit reader is a pure state value threaded through every call.  The state
; is a single integer: the absolute bit position `p` into the input, where bit
; `k` of the stream is bit `k % 8` of byte `k / 8`, counted from the
; least-significant bit (DEFLATE is LSB-first within each byte).  The input
; bytes are threaded alongside the position rather than carried in the state,
; because they are constant for the whole decode.
;
; Decompressed output is carried as an output state value threaded through the
; decode:
;
;   (output <reversed list of committed blocks>
;           <reversed list of uncommitted fragments>
;           <reversed list of fragments not yet folded into the window>
;           <bytes: the most recent output, coalesced>
;           <integer: total bytes produced>)
;
; Appending only prepends to the two fragment lists, so it is O(1) regardless of
; how much output has already been produced.  `window` is a coalesced contiguous
; view of the most recent output and is refreshed lazily, only when a
; back-reference needs to read from it.  A back-reference can reach back at most
; the maximum DEFLATE distance, so refreshing keeps only the most recent
; `window-cap` bytes.
;
; `fragments` is bounded: once it holds `fragment-max` entries they are
; coalesced into a single block and committed to `blocks`.  A stream can append a
; fragment per match, so without this bound a decode of a large match-heavy
; stream would hold one list cell and one bytes value per match for the whole
; decode.  Committing keeps the number of live fragments proportional to the
; output size divided by `fragment-max`, not to the number of matches.
;
; `pending` tracks which fragments have not yet been folded into `window`, so
; that a refresh folds each fragment exactly once.  It is cleared by a refresh
; and is independent of committing.
;
; The full output is `reverse(blocks) ++ reverse(fragments)`.

(let ((tables (import "deflate-tables"))
      (length-base (:: tables length-base))
      (length-extra (:: tables length-extra))
      (distance-base (:: tables distance-base))
      (distance-extra (:: tables distance-extra))
      (code-length-order (:: tables code-length-order))
      (fixed-lit-lengths (:: tables fixed-lit-lengths))
      (fixed-dist-lengths (:: tables fixed-dist-lengths))

      ; The maximum DEFLATE back-reference distance.  The output window must
      ; always retain at least this many bytes of recent output so that any
      ; back-reference can be resolved.
      (window-cap 32768)

      ; The number of recent fragments the output state keeps before coalescing
      ; them into a committed block.  Bounding this bounds the number of live
      ; fragment values and list cells, which would otherwise grow with the number
      ; of matches in the stream.
      (fragment-max 64)

      ; Create an empty output state.
      (output (struct (blocks fragments pending window total)))

      (make-output
       (lambda ()
         (output (list) (list) (list) (string->bytes "") 0)))

      ; Append a bytes value to the output.  O(1): the value is prepended to the
      ; fragment list.  When that list reaches `fragment-max` entries they are
      ; coalesced into one block and committed, so the fragment list never grows
      ; without bound.  Committing does not touch `pending` or `window`: the next
      ; refresh folds every fragment appended since the last refresh, whether it
      ; has been committed or not.
      (output-append-bytes
       (lambda (out bs)
         (let ((fragments (list-prepend (struct-get out 'fragments) bs))
               (pending (list-prepend (struct-get out 'pending) bs))
               (total (integer+ (struct-get out 'total) (bytes-length bs))))
           (if (integer>=? (list-length fragments) fragment-max)
               (let ((block (concat-blocks (list-reverse fragments))))
                 (output (list-prepend (struct-get out 'blocks) block) (list) pending (struct-get out 'window) total))
               (output (struct-get out 'blocks) fragments pending (struct-get out 'window) total)))))

      ; Concatenate a list of bytes values, in list order, into one bytes value.
      ; The list is merged pairwise rather than folded, so each byte is copied
      ; O(log n) times rather than O(n).
      (concat-blocks
       (lambda (fragments)
         (if (list-null? fragments)
             (string->bytes "")
             (if (list-null? (list-rest fragments))
                 (list-first fragments)
                 (let ((half (integer/ (list-length fragments) 2)))
                   (bytes-concat
                     (concat-blocks (list-slice fragments 0 half))
                     (concat-blocks (list-slice fragments half))))))))

      ; Coalesce the pending appends onto the window, keeping only the most recent
      ; `window-cap` bytes (all a back-reference can reach).  A no-op when there is
      ; nothing pending, so it is cheap to call before every read.
      (output-refresh-window
       (lambda (out)
         (let ((pending (struct-get out 'pending)))
           (if (list-null? pending)
               out
               (let ((win (apply bytes-concat (list-prepend (list-reverse pending) (struct-get out 'window)))))
                 (output
                   (struct-get out 'blocks)
                   (struct-get out 'fragments)
                   (list)
                   (if (integer>? (bytes-length win) window-cap)
                       (bytes-slice win (integer- (bytes-length win) window-cap) (bytes-length win))
                       win)
                   (struct-get out 'total)))))))

      ; Flatten the output state into a single bytes value.  O(total * log n).
      (output-finalize
       (lambda (out)
         (concat-blocks
           (list-concat (list-reverse (struct-get out 'blocks)) (list-reverse (struct-get out 'fragments))))))

      ; Read a single bit at bit position `p`, returning (list <0-or-1> <p+1>).
      (read-bit
       (lambda (b p)
         (let ((pos (integer/ p 8)))
           (if (integer>=? pos (bytes-length b))
               (error "deflate-decompress: unexpected end of input while reading bits")
               (list (integer-bit-and (integer-bit-shift-right (bytes-nth b pos) (integer% p 8)) 1) (integer+ p 1))))))

      ; Read `n` bits LSB-first starting at bit position `p`, returning
      ; (list <integer> <p+n>).  The first bit read becomes the least-significant
      ; bit of the result.  The bits are gathered from the whole bytes that span
      ; the range rather than one at a time, so the cost is independent of `n`.
      (read-bits
       (lambda (b p n)
         (let ((start-byte (integer/ p 8))
               (start-bit (integer% p 8))
               (nbytes (integer/ (integer+ (integer+ start-bit n) 7) 8)))
           (if (integer>? (integer+ start-byte nbytes) (bytes-length b))
               (error "deflate-decompress: unexpected end of input while reading bits")
               (let ((chunk
                      (lambda (k acc)
                        (if (integer>=? k nbytes)
                            acc
                            (chunk
                              (integer+ k 1)
                              (integer-bit-or
                                acc
                                (integer-bit-shift-left (bytes-nth b (integer+ start-byte k)) (integer* 8 k))))))))
                 (list
                   (integer-bit-and
                     (integer-bit-shift-right (chunk 0 0) start-bit)
                     (integer- (integer-bit-shift-left 1 n) 1))
                   (integer+ p n)))))))

      ; Discard bits up to the next byte boundary, returning the new bit position.
      (align-to-byte
       (lambda (p)
         (if (integer=? (integer% p 8) 0)
             p
             (integer* (integer+ (integer/ p 8) 1) 8))))

      ; Read `n` raw bytes from the byte containing bit position `p`, returning
      ; (list <bytes> <p + 8n>).  The position must be byte-aligned.
      (read-raw-bytes
       (lambda (b p n)
         (let ((pos (integer/ p 8)))
           (if (integer>? (integer+ pos n) (bytes-length b))
               (error "deflate-decompress: unexpected end of input while reading stored block")
               (list (bytes-slice b pos (integer+ pos n)) (integer+ p (integer* 8 n)))))))

      ; Build a canonical Huffman decoding table from a list of code lengths.
      ; `lengths` is a list where element i is the code length of symbol i
      ; (0 means the symbol is unused).  Returns a dict mapping an integer key to
      ; the symbol index, following the canonical code assignment of RFC 1951
      ; §3.2.2 (shorter codes first; within a length, codes assigned in symbol
      ; order).  A code of length L with value `code` is keyed by (1 << L) + code;
      ; because a code of length L is always less than 2^L, keys for different
      ; lengths occupy disjoint ranges.
      (build-huffman-table
       (lambda (lengths)
         (let (; Count the codes of each length and find the longest, in one walk.
               ; Returns (list <bl-count> <maxlen>).
               (count-lengths
                (lambda (lst acc maxlen)
                  (if (list-null? lst)
                      (list acc maxlen)
                      (let ((len (list-first lst)))
                        (count-lengths
                          (list-rest lst)
                          (dict-with acc len (integer+ (dict-get acc len 0) 1))
                          (integer-max maxlen len))))))

               ; Compute the first canonical code for each length 1..maxlen.
               ; bl_count[len] = number of codes of that length.
               ; Returns a dict mapping length to the first code assigned to it.
               (first-codes
                (lambda (bl-count maxlen)
                  (let ((loop
                         (lambda (len code acc)
                           (if (integer>? len maxlen)
                               acc
                               (let ((next (integer-bit-shift-left (integer+ code (dict-get bl-count len 0)) 1)))
                                 (loop (integer+ len 1) next (dict-with acc len code)))))))
                    (loop 1 0 (dict)))))

               ; Walk symbols in order, assigning each its canonical code.  The
               ; symbol index is carried as an integer rather than read from a
               ; range list.  Returns a table dict keyed by (1 << length) + code.
               (assign
                (lambda (lens sym codes table)
                  (if (list-null? lens)
                      table
                      (let ((len (list-first lens)))
                        (if (integer=? len 0)
                            (assign (list-rest lens) (integer+ sym 1) codes table)
                            (let ((code (dict-get codes len)))
                              (if (none? code)
                                  (error "deflate-decompress: internal error building Huffman table")
                                  (let ((key (integer+ (integer-bit-shift-left 1 len) code)))
                                    (assign
                                      (list-rest lens)
                                      (integer+ sym 1)
                                      (dict-with codes len (integer+ code 1))
                                      (dict-with table key sym)))))))))))

           (let ((counted (count-lengths lengths (dict) 0)))
             (assign lengths 0 (first-codes (list-first counted) (list-nth counted 1)) (dict))))))

      ; Decode one symbol using a canonical Huffman table, reading bits one at a
      ; time until a code matches.  The table is keyed by (1 << length) + code, so
      ; the lookup key is built with integer arithmetic.  Returns
      ; (list <symbol> <new-bit-position>).
      (decode-symbol
       (lambda (b p table)
         (let ((loop
                (lambda (pos length code)
                  (if (integer>? length 15)
                      (error "deflate-decompress: invalid Huffman code (no match within 15 bits)")
                      (let ((byte (integer/ pos 8)))
                        (if (integer>=? byte (bytes-length b))
                            (error "deflate-decompress: unexpected end of input while reading bits")
                            (let ((bit
                                   (integer-bit-and (integer-bit-shift-right (bytes-nth b byte) (integer% pos 8)) 1))

                                  (new-code (integer-bit-or (integer-bit-shift-left code 1) bit))
                                  (next-length (integer+ length 1))
                                  (next-pos (integer+ pos 1))
                                  (key (integer+ (integer-bit-shift-left 1 next-length) new-code))
                                  (sym (dict-get table key)))
                              (if (none? sym)
                                  (loop next-pos next-length new-code)
                                  (list sym next-pos)))))))))
           (loop p 0 0))))

      ; Read `n` extra bits and return (list <integer> <new-bit-position>).
      (read-extra
       (lambda (b p n)
         (if (integer=? n 0)
             (list 0 p)
             (read-bits b p n))))

      ; Decode a length symbol (257-285) into an actual length value.
      ; Returns (list <length> <new-bit-position>).
      (decode-length
       (lambda (b p sym)
         (let ((idx (integer- sym 257))
               (base (vector-nth length-base idx))
               (extra (vector-nth length-extra idx))
               (extra-result (read-extra b p extra)))
           (list (integer+ base (list-first extra-result)) (list-nth extra-result 1)))))

      ; Decode a distance symbol (0-29) into an actual distance value.
      ; Returns (list <distance> <new-bit-position>).
      (decode-distance
       (lambda (b p sym)
         (let ((base (vector-nth distance-base sym))
               (extra (vector-nth distance-extra sym))
               (extra-result (read-extra b p extra)))
           (list (integer+ base (list-first extra-result)) (list-nth extra-result 1)))))

      ; Copy `length` bytes from `distance` bytes back in the output, appending to
      ; it.  Returns the new output state.
      ;
      ; The source is the block of `min(distance, length)` bytes ending at the end
      ; of the window; the copied bytes are that block repeated.  When
      ; `distance >= length` the block is already `length` bytes, so a single
      ; slice is appended.  When `distance < length` the block is shorter than the
      ; copy and is repeated to fill it, which reproduces the byte-at-a-time
      ; overlap replication.  Appending in one operation keeps the cost
      ; proportional to `length` rather than to the window size.
      ;
      ; The window is refreshed first so it covers the most recent output, which
      ; is all a back-reference can reach.
      (copy-back-reference
       (lambda (out distance length)
         (if (integer>? distance (struct-get out 'total))
             (error "deflate-decompress: back-reference distance exceeds output produced so far")
             (let ((refreshed (output-refresh-window out))
                   (win (struct-get refreshed 'window))
                   (wlen (bytes-length (struct-get refreshed 'window)))
                   (block-len (integer-min distance length))
                   (block (bytes-slice win (integer- wlen distance) (integer+ (integer- wlen distance) block-len))))
               (output-append-bytes refreshed (repeat-to-length block block-len length))))))

      ; Return a bytes value of exactly `length` bytes formed by repeating `block`
      ; (which has `block-len` bytes) until it is long enough, then truncating.
      ; `block-len` must be at least 1 and at most `length`.
      (repeat-to-length
       (lambda (block block-len length)
         (let ((loop
                (lambda (acc)
                  (if (integer>=? (bytes-length acc) length)
                      (bytes-slice acc 0 length)
                      (loop (bytes-concat acc block))))))
           (loop block))))

      ; Decode the symbols of a Huffman-coded block (fixed or dynamic) until the
      ; end-of-block symbol (256).  Returns (list <output-state> <new-bit-position>).
      ;
      ; Consecutive literals are gathered into a pending list and appended in one
      ; operation when a match or the end of the block is reached.  Appending each
      ; literal individually would allocate a one-byte value per literal, which
      ; dominates the cost on literal-heavy streams.
      (decode-huffman-block
       (lambda (b p lit-table dist-table out)
         (let ((flush-literals
                (lambda (acc pending)
                  (if (list-null? pending)
                      acc
                      (output-append-bytes acc (list->bytes (list-reverse pending))))))

               (loop
                (lambda (pos acc pending)
                  (let ((sym-result (decode-symbol b pos lit-table))
                        (sym (list-first sym-result))
                        (pos2 (list-nth sym-result 1)))
                    (if (integer=? sym 256)
                        (list (flush-literals acc pending) pos2)
                        (if (integer<? sym 256)
                            (loop pos2 acc (list-prepend pending sym))
                            (let ((length-result (decode-length b pos2 sym))
                                  (length (list-first length-result))
                                  (pos3 (list-nth length-result 1))
                                  (dist-sym-result (decode-symbol b pos3 dist-table))
                                  (dist-sym (list-first dist-sym-result))
                                  (pos4 (list-nth dist-sym-result 1))
                                  (dist-result (decode-distance b pos4 dist-sym))
                                  (distance (list-first dist-result))
                                  (pos5 (list-nth dist-result 1)))
                              (loop
                                pos5
                                (copy-back-reference (flush-literals acc pending) distance length)
                                (list)))))))))
           (loop p out (list)))))

      ; Decode one stored block (BTYPE = 00).  The reader is positioned just after
      ; the 3 header bits; stored blocks byte-align, then carry LEN and NLEN
      ; (little-endian u16 each) followed by LEN literal bytes.  Returns
      ; (list <bytes> <new-bit-position>).
      (decode-stored-block
       (lambda (b p)
         (let ((aligned (align-to-byte p))
               (len-result (read-raw-bytes b aligned 2))
               (len-bytes (list-first len-result))
               (pos2 (list-nth len-result 1))
               (nlen-result (read-raw-bytes b pos2 2))
               (nlen-bytes (list-first nlen-result))
               (pos3 (list-nth nlen-result 1))
               (len (bytes-read-u16-le len-bytes 0))
               (nlen (bytes-read-u16-le nlen-bytes 0)))
           (if (integer=? len (integer-bit-and (integer-bit-not nlen) #xffff))
               (read-raw-bytes b pos3 len)
               (error "deflate-decompress: stored block LEN does not match NLEN")))))

      ; The fixed Huffman decoding tables (RFC 1951 §3.2.6).  These are constant,
      ; so they are built once here rather than per block.  Building them per block
      ; dominates the cost of archives with many small fixed-Huffman entries.
      (fixed-lit-table (build-huffman-table fixed-lit-lengths))
      (fixed-dist-table (build-huffman-table fixed-dist-lengths))

      ; Decode one fixed Huffman block (BTYPE = 01).  Returns
      ; (list <output-state> <new-bit-position>).
      (decode-fixed-block
       (lambda (b p out)
         (decode-huffman-block b p fixed-lit-table fixed-dist-table out)))

      ; Read the code-length code lengths and build the code-length Huffman table.
      ; Reads HCLEN + 4 three-bit lengths in the special order.  Returns
      ; (list <table> <new-bit-position>).
      (read-code-length-table
       (lambda (b p hclen)
         (let ((count (integer+ hclen 4)))
           (let ((loop
                  (lambda (i pos lengths)
                    (if (integer>=? i count)
                        (list (build-huffman-table (build-code-length-lengths lengths 19)) pos)
                        (let ((r (read-bits b pos 3)))
                          (loop
                            (integer+ i 1)
                            (list-nth r 1)
                            (dict-with lengths (vector-nth code-length-order i) (list-first r))))))))
             (loop 0 p (dict))))))

      ; Expand a sparse dict of code lengths (only the first `count` entries of
      ; the code-length order are meaningful) into a full list of length 19, with
      ; unset entries defaulting to 0.
      (build-code-length-lengths
       (lambda (lengths count)
         (map-list
           (lambda (i)
             (dict-get lengths i 0))
           (range 0 count))))

      ; Decode the HLIT + HDIST code lengths from the code-length table, expanding
      ; the repeat codes 16/17/18 (RFC 1951 §3.2.7).  Returns
      ; (list <list-of-lengths> <new-bit-position>).
      (read-code-lengths
       (lambda (b p cl-table total)
         (let ((loop
                (lambda (pos acc)
                  (if (integer>=? (list-length acc) total)
                      (list (list-reverse acc) pos)
                      (let ((sym-result (decode-symbol b pos cl-table)))
                        (let ((sym (list-first sym-result))
                              (pos2 (list-nth sym-result 1)))
                          (if (integer<=? sym 15)
                              (loop pos2 (list-prepend acc sym))
                              (if (integer=? sym 16)
                                  (let ((r (read-bits b pos2 2)))
                                    (let ((repeat (integer+ 3 (list-first r)))
                                          (prev (list-first acc)))
                                      (loop (list-nth r 1) (repeat-prepend acc prev repeat))))
                                  (if (integer=? sym 17)
                                      (let ((r (read-bits b pos2 3)))
                                        (loop (list-nth r 1) (repeat-prepend acc 0 (integer+ 3 (list-first r)))))
                                      (let ((r (read-bits b pos2 7)))
                                        (loop
                                          (list-nth r 1)
                                          (repeat-prepend acc 0 (integer+ 11 (list-first r))))))))))))))
           (loop p (list)))))

      ; Prepend `value` `n` times to list `lst`.
      (repeat-prepend
       (lambda (lst value n)
         (if (integer=? n 0)
             lst
             (repeat-prepend (list-prepend lst value) value (integer- n 1)))))

      ; Decode one dynamic Huffman block (BTYPE = 10).  Reads the literal/length
      ; and distance code lengths, builds the two tables, and decodes the block
      ; body.  Returns (list <output-state> <new-bit-position>).
      (decode-dynamic-block
       (lambda (b p out)
         (let ((hlit-result (read-bits b p 5))
               (hlit (list-first hlit-result))
               (pos1 (list-nth hlit-result 1))
               (hdist-result (read-bits b pos1 5))
               (hdist (list-first hdist-result))
               (pos2 (list-nth hdist-result 1))
               (hclen-result (read-bits b pos2 4))
               (hclen (list-first hclen-result))
               (pos3 (list-nth hclen-result 1))
               (cl-result (read-code-length-table b pos3 hclen))
               (cl-table (list-first cl-result))
               (pos4 (list-nth cl-result 1))
               (num-lit (integer+ hlit 257))
               (num-dist (integer+ hdist 1))
               (lengths-result (read-code-lengths b pos4 cl-table (integer+ num-lit num-dist)))
               (lengths (list-first lengths-result))
               (pos5 (list-nth lengths-result 1))
               (lit-lengths (list-slice lengths 0 num-lit))
               (dist-lengths (list-slice lengths num-lit (integer+ num-lit num-dist))))
           (decode-huffman-block b pos5 (build-huffman-table lit-lengths) (build-huffman-table dist-lengths) out))))

      ; Decode the block stream until the final block (BFINAL = 1) is consumed.
      ; The output state is threaded through and extended by each block.  Returns
      ; (list <output-state> <new-bit-position>).
      (decode-blocks
       (lambda (b p out)
         (let ((bfinal-result (read-bit b p))
               (bfinal (list-first bfinal-result))
               (pos1 (list-nth bfinal-result 1))
               (btype-result (read-bits b pos1 2))
               (btype (list-first btype-result))
               (pos2 (list-nth btype-result 1))

               (block-result
                (if (integer=? btype 0)
                    (let ((r (decode-stored-block b pos2)))
                      (list (output-append-bytes out (list-first r)) (list-nth r 1)))
                    (if (integer=? btype 1)
                        (decode-fixed-block b pos2 out)
                        (if (integer=? btype 2)
                            (decode-dynamic-block b pos2 out)
                            (error "deflate-decompress: invalid block type (BTYPE = 11)")))))

               (new-out (list-first block-result))
               (pos3 (list-nth block-result 1)))
           (if (integer=? bfinal 1)
               (list new-out pos3)
               (decode-blocks b pos3 new-out)))))

      ; Decompress a bytes value containing a raw DEFLATE stream into the
      ; decompressed data.
      (decompress
       (lambda (b)
         (if (bytes? b)
             (output-finalize (list-first (decode-blocks b 0 (make-output))))
             (error "deflate-decompress: decompress expects a bytes value")))))

  (export decompress))
