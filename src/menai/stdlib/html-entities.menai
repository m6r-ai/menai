; html-entities — the named character references HTML documents use.
;
; This is a shared-data module: it exports a table of specification data and is not
; an operation.  html-decode uses it to resolve a named reference such as "&nbsp;"
; to its character.  html-encode does not use it, because the encoder escapes only
; the characters that must be escaped and emits everything else literally.
;
; The table is the common subset of the HTML standard's named character references,
; not the full list of 2231.  A reference outside the table is not an error: a
; decoder leaves it as literal text, so an obscure symbol is visible to the caller
; rather than silently wrong.  The table can grow without changing any operation's
; signature.
;
; The table is a dict mapping each reference's name, without its leading "&" and
; trailing ";", to the character it denotes.  It is exported under the name
; "entities".

(let (; The named character references, by name without "&" and ";".
      (entities
       (dict "amp" "&"
             "lt" "<"
             "gt" ">"
             "quot" "\""
             "apos" "'"
             "nbsp" " "
             "ensp" " "
             "emsp" " "
             "thinsp" " "
             "zwnj" "‌"
             "zwj" "‍"
             "lrm" "‎"
             "rlm" "‏"
             "ndash" "–"
             "mdash" "—"
             "lsquo" "‘"
             "rsquo" "’"
             "sbquo" "‚"
             "ldquo" "“"
             "rdquo" "”"
             "bdquo" "„"
             "dagger" "†"
             "Dagger" "‡"
             "bull" "•"
             "hellip" "…"
             "permil" "‰"
