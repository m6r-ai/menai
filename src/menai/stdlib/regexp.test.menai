; Tests for regexp.menai

(let ((r (import "regexp"))
      (t (import "menai_test")))
  (let ((compile (:: r compile))
        (search (:: r search))
        (search? (:: r search?))
        (search-all (:: r search-all))
        (split (:: r split))
        (replace (:: r replace))
        (regexp? (:: r regexp?))
        (assert-equal (:: t assert-equal))
        (expect-pass (:: t test))
        (expect-fail (:: t test-error)))
    (let ((tests
      (list
        (list "construction"
          (list
            (expect-pass "compiled regexp is a regexp"
                         (lambda () (assert-equal (regexp? (compile "[0-9]+")) #t)))
            (expect-pass "regexp? rejects an integer"
                         (lambda () (assert-equal (regexp? 5) #f)))
            (expect-pass "regexp? rejects a string"
                         (lambda () (assert-equal (regexp? "hello") #f)))
            (expect-pass "regexp? rejects a list"
                         (lambda () (assert-equal (regexp? (list 1 2)) #f)))
            (expect-pass "regexp? rejects none"
                         (lambda () (assert-equal (regexp? #none) #f)))
            (expect-fail "compiling a non-string raises"
                         (lambda () (compile 5))
                         "must be a string")
            (expect-fail "unterminated group raises"
                         (lambda () (compile "(abc"))
                         "Unterminated group")
            (expect-fail "unterminated class raises"
                         (lambda () (compile "[abc"))
                         "Unterminated character class")
            (expect-fail "repetition count over the limit raises"
                         (lambda () (compile "a{5000}"))
                         "exceeds the limit")
            (expect-fail "inverted repetition range raises"
                         (lambda () (compile "a{4,2}"))
                         "is inverted")))

        (list "literal"
          (list
            (expect-pass "match at start"
                         (lambda () (assert-equal (search (compile "abc") "abcdef") (list 0 3))))
            (expect-pass "match in middle"
                         (lambda () (assert-equal (search (compile "abc") "xxabcyy") (list 2 5))))
            (expect-pass "match at end"
                         (lambda () (assert-equal (search (compile "abc") "xxabc") (list 2 5))))
            (expect-pass "no match returns none"
                         (lambda () (assert-equal (search (compile "xyz") "abcdef") #none)))
            (expect-pass "empty input cannot match a literal"
                         (lambda () (assert-equal (search (compile "abc") "") #none)))
            (expect-pass "literal equal to whole input"
                         (lambda () (assert-equal (search (compile "abc") "abc") (list 0 3))))
            (expect-pass "leftmost match wins"
                         (lambda () (assert-equal (search (compile "a") "aXaXa") (list 0 1))))))

        (list "anchors"
          (list
            (expect-pass "start anchor matches at position 0"
                         (lambda () (assert-equal (search (compile "^abc") "abcdef") (list 0 3))))
            (expect-pass "start anchor does not match later"
                         (lambda () (assert-equal (search (compile "^abc") "xabcdef") #none)))
            (expect-pass "end anchor matches at the end"
                         (lambda () (assert-equal (search (compile "abc$") "xxabc") (list 2 5))))
            (expect-pass "end anchor does not match earlier"
                         (lambda () (assert-equal (search (compile "abc$") "abcxx") #none)))
            (expect-pass "both anchors match the whole input"
                         (lambda () (assert-equal (search (compile "^abc$") "abc") (list 0 3))))
            (expect-pass "both anchors reject a partial input"
                         (lambda () (assert-equal (search (compile "^abc$") "xabc") #none)))))

        (list "character-classes"
          (list
            (expect-pass "digit class matches a run of digits"
                         (lambda () (assert-equal (search (compile "[0-9]+") "abc123def") (list 3 6))))
            (expect-pass "ranged class matches only its range"
                         (lambda () (assert-equal (search (compile "[a-z]+") "ABCdef") (list 3 6))))
            (expect-pass "negated class matches outside the set"
                         (lambda () (assert-equal (search (compile "[^a]+") "aaabbb") (list 3 6))))
            (expect-pass "shorthand digit class"
                         (lambda () (assert-equal (search (compile "\\d+") "ab12cd") (list 2 4))))
            (expect-pass "shorthand word class"
                         (lambda () (assert-equal (search (compile "\\w+") "  abc  ") (list 2 5))))
            (expect-pass "shorthand space class"
                         (lambda () (assert-equal (search (compile "\\s+") "ab   cd") (list 2 5))))
            (expect-pass "negated shorthand digit class"
                         (lambda () (assert-equal (search (compile "\\D+") "123abc") (list 3 6))))
            (expect-pass "any character matches one character"
                         (lambda () (assert-equal (search (compile "a.c") "xxaXcyy") (list 2 5))))))

        (list "quantifiers"
          (list
            (expect-pass "star matches zero occurrences"
                         (lambda () (assert-equal (search (compile "a*b") "b") (list 0 1))))
            (expect-pass "star matches many occurrences"
                         (lambda () (assert-equal (search (compile "a*b") "aaab") (list 0 4))))
            (expect-pass "plus matches one or more"
                         (lambda () (assert-equal (search (compile "a+b") "aaab") (list 0 4))))
            (expect-pass "plus requires at least one"
                         (lambda () (assert-equal (search (compile "a+b") "b") #none)))
            (expect-pass "optional matches zero"
                         (lambda () (assert-equal (search (compile "ab?c") "xacy") (list 1 3))))
            (expect-pass "optional matches one"
                         (lambda () (assert-equal (search (compile "ab?c") "xabcy") (list 1 4))))
            (expect-pass "exact repeat matches exactly n"
                         (lambda () (assert-equal (search (compile "a{3}") "xaaaay") (list 1 4))))
            (expect-pass "exact repeat rejects fewer than n"
                         (lambda () (assert-equal (search (compile "a{3}") "xaay") #none)))
            (expect-pass "open repeat matches n or more"
                         (lambda () (assert-equal (search (compile "a{2,}") "xaaaay") (list 1 5))))
            (expect-pass "open repeat rejects fewer than n"
                         (lambda () (assert-equal (search (compile "a{2,}") "xay") #none)))
            (expect-pass "bounded repeat matches up to m"
                         (lambda () (assert-equal (search (compile "a{2,4}") "xaaaay") (list 1 5))))
            (expect-pass "bounded repeat matches its lower bound"
                         (lambda () (assert-equal (search (compile "a{2,4}") "xaay") (list 1 3))))
            (expect-pass "bounded repeat rejects fewer than n"
                         (lambda () (assert-equal (search (compile "a{2,4}") "xay") #none)))
            (expect-pass "bounded repeat is greedy"
                         (lambda () (assert-equal (search (compile "a{2,4}") "xaaaaay") (list 1 5))))
            (expect-pass "zero repeat matches nothing"
                         (lambda () (assert-equal (search (compile "a{0}b") "b") (list 0 1))))
            (expect-pass "zero-or-more repeat is a star"
                         (lambda () (assert-equal (search (compile "a{0,}b") "aaab") (list 0 4))))
            (expect-pass "zero-or-more repeat matches zero"
                         (lambda () (assert-equal (search (compile "a{0,}b") "b") (list 0 1))))
            (expect-pass "a brace that is not a quantifier is literal"
                         (lambda () (assert-equal (search (compile "a{b}") "xa{b}y") (list 1 5))))))

        (list "grouping"
          (list
            (expect-pass "a quantifier applies to the whole group"
                         (lambda () (assert-equal (search (compile "(ab)+") "ababab") (list 0 6))))
            (expect-pass "alternation matches the second branch"
                         (lambda () (assert-equal (search (compile "cat|dog") "a dog here") (list 2 5))))
            (expect-pass "alternation matches the first branch"
                         (lambda () (assert-equal (search (compile "cat|dog") "a cat here") (list 2 5))))
            (expect-pass "alternation backtracks into the second branch"
                         (lambda () (assert-equal (search (compile "abc|abd") "abd") (list 0 3))))))

        (list "search-predicate"
          (list
            (expect-pass "match returns true"
                         (lambda () (assert-equal (search? (compile "[0-9]+") "abc123") #t)))
            (expect-pass "no match returns false"
                         (lambda () (assert-equal (search? (compile "[0-9]+") "abcdef") #f)))
            (expect-fail "requires a string"
                         (lambda () (search? (compile "a") 5))
                         "must be a string")))

        (list "search-all"
          (list
            (expect-pass "every non-overlapping match, left to right"
                         (lambda () (assert-equal (search-all (compile "[0-9]+") "a1 b22 c333")
                                                  (list (list 1 2) (list 4 6) (list 8 11)))))
            (expect-pass "no matches returns an empty list"
                         (lambda () (assert-equal (search-all (compile "[0-9]+") "no digits") (list))))
            (expect-pass "a single match returns a one-element list"
                         (lambda () (assert-equal (search-all (compile "[0-9]+") "a1b") (list (list 1 2)))))
            (expect-pass "adjacent matches are all reported"
                         (lambda () (assert-equal (search-all (compile "[0-9]") "a1b2c3")
                                                  (list (list 1 2) (list 3 4) (list 5 6)))))
            (expect-fail "requires a string"
                         (lambda () (search-all (compile "a") 5))
                         "must be a string")))

        (list "split"
          (list
            (expect-pass "splits on a class of separators, keeping empty fields"
                         (lambda () (assert-equal (split (compile "[,;]") "a,,b,")
                                                  (list "a" "" "b" ""))))
            (expect-pass "a run of whitespace is one separator"
                         (lambda () (assert-equal (split (compile "\\s+") " fee fi  fo")
                                                  (list "" "fee" "fi" "fo"))))
            (expect-pass "no match returns the input as one element"
                         (lambda () (assert-equal (split (compile ",") "abc") (list "abc"))))
            (expect-pass "empty input returns one empty field"
                         (lambda () (assert-equal (split (compile ",") "") (list ""))))
            (expect-fail "requires a string"
                         (lambda () (split (compile "a") 5))
                         "must be a string")))

        (list "replace"
          (list
            (expect-pass "replaces every match, including runs"
                         (lambda () (assert-equal (replace (compile "\\s+") "one two three" "_")
                                                  "one_two_three")))
            (expect-pass "replaces a run of digits as one match"
                         (lambda () (assert-equal (replace (compile "[0-9]+") "a1b22c" "#") "a#b#c")))
            (expect-pass "no match leaves the input unchanged"
                         (lambda () (assert-equal (replace (compile ",") "abc" "_") "abc")))
            (expect-pass "matches at the start and end are both replaced"
                         (lambda () (assert-equal (replace (compile "a") "aba" "X") "XbX")))
            (expect-fail "requires a string"
                         (lambda () (replace (compile "a") 5 "_"))
                         "must be a string")))

        (list "composition"
          (list
            (expect-pass "a match result indexes the matched text"
                         (lambda ()
                           (let ((m (search (compile "[0-9]+") "abc123def")))
                             (assert-equal (string-slice "abc123def" (list-nth m 0) (list-nth m 1))
                                           "123"))))
            (expect-pass "a compiled regexp is reusable"
                         (lambda ()
                           (let ((rx (compile "[0-9]+")))
                             (assert-equal (list (search rx "a1") (search rx "b22") (search rx "ccc"))
                                           (list (list 1 2) (list 1 3) #none)))))
            (expect-pass "an ISO date is extracted from surrounding text"
                         (lambda ()
                           (assert-equal (search (compile "[0-9]{4}-[0-9]{2}-[0-9]{2}")
                                                 "logged on 2026-10-06 ok")
                                         (list 10 20)))))))))

      (export tests))))
