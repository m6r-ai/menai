; Tests for zip-entries.menai

(letrec
  ((zip-mod (import "zip-entries"))
   (t (import "menai-test"))
   (entries (:: zip-mod entries))
   (assert-equal (:: t assert-equal))
   (expect-pass (:: t expect-pass))
   (expect-fail (:: t expect-fail))

   ; A one-entry archive whose entry is deflate-compressed.
   (deflate-archive
    (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))

   ; A one-entry archive whose entry is stored.
   (stored-archive
    (string-hex->bytes "504b030414000000000007542f5df1080d9b040000000400000005000000612e74787441414141504b0102140314000000000007542f5df1080d9b0400000004000000050000000000000000000000800100000000612e747874504b0506000000000100010033000000270000000000"))

   ; A two-entry archive with a directory entry and a file entry.
   (two-entry-archive
    (string-hex->bytes ""))

   ; A deflate archive reports a single entry.
   (test-deflate-entry-count
    (lambda ()
      (let ((r (entries deflate-archive)))
        (assert-equal (dict-get (dict-get r "meta") "entry-count") 1))))

   ; A deflate archive's entry name is decoded.
   (test-deflate-entry-name
    (lambda ()
      (let ((r (entries deflate-archive)))
        (assert-equal (dict-get (list-first (dict-get r "entries")) "name") "hello.txt"))))

   ; A deflate archive's entry compression method is decoded.
   (test-deflate-entry-compression
    (lambda ()
      (let ((r (entries deflate-archive)))
        (assert-equal (dict-get (list-first (dict-get r "entries")) "compression") 8))))

   ; A deflate archive's entry uncompressed size is decoded.
   (test-deflate-entry-uncompressed-size
    (lambda ()
      (let ((r (entries deflate-archive)))
        (assert-equal (dict-get (list-first (dict-get r "entries")) "uncompressed-size") 11))))

   ; A stored archive's entry name is decoded.
   (test-stored-entry-name
    (lambda ()
      (let ((r (entries stored-archive)))
        (assert-equal (dict-get (list-first (dict-get r "entries")) "name") "a.txt"))))

   ; A stored archive's entry compression method is decoded.
   (test-stored-entry-compression
    (lambda ()
      (let ((r (entries stored-archive)))
        (assert-equal (dict-get (list-first (dict-get r "entries")) "compression") 0))))

   ; entries leaves an entry's content unset.
   (test-content-unset
    (lambda ()
      (let ((r (entries deflate-archive)))
        (assert-equal (dict-get (list-first (dict-get r "entries")) "content") #none))))

   ; The archive metadata reports the format.
   (test-meta-format
    (lambda ()
      (let ((r (entries two-entry-archive)))
        (assert-equal (dict-get (dict-get r "meta") "format") "zip"))))

   ; The archive metadata reports the entry count.
   (test-meta-entry-count
    (lambda ()
      (let ((r (entries two-entry-archive)))
        (assert-equal (dict-get (dict-get r "meta") "entry-count") 2))))

   ; The archive metadata reports no comment when none is present.
   (test-meta-no-comment
    (lambda ()
      (let ((r (entries two-entry-archive)))
        (assert-equal (dict-get (dict-get r "meta") "comment") #none))))

   ; A directory entry is flagged.
   (test-directory-entry-flagged
    (lambda ()
      (let ((r (entries two-entry-archive)))
        (assert-equal (dict-get (list-first (dict-get r "entries")) "is-directory") #t))))

   ; A file entry is not flagged as a directory.
   (test-file-entry-not-flagged
    (lambda ()
      (let ((r (entries two-entry-archive)))
        (assert-equal (dict-get (list-nth (dict-get r "entries") 1) "is-directory") #f))))

   ; A non-bytes argument is rejected.
   (test-rejects-non-bytes
    (lambda ()
      (entries "not bytes")))

   ; Data that is not a ZIP file is rejected.
   (test-rejects-not-a-zip
    (lambda ()
      (entries (string-hex->bytes "000000000000000000000000000000000000000000000000"))))

   ; An archive with encrypted entries is rejected.
   (test-rejects-encrypted
    (lambda ()
      (entries (string-hex->bytes "504b03041400000000008f542f5d63f3f3ad040000000400000005000000782e74787464617461504b010214031400010000008f542f5d63f3f3ad040000000400000005000000000000000000000000800100000000782e747874504b0506000000000100010033000000270000000000"))))

   ; A Zip64 archive is rejected.
   (test-rejects-zip64
    (lambda ()
      (entries (string-hex->bytes "504b03041400000000008f542f5d63f3f3ad040000000400000005000000792e74787464617461504b010214031400000000008f542f5d63f3f3ad0400000004000000050000000000000000000000800100000000792e747874504b0506000000000100ffff33000000270000000000"))))

   (tests
    (list
      (list "entries"
        (list
          (expect-pass "deflate archive entry count" test-deflate-entry-count)
          (expect-pass "deflate archive entry name" test-deflate-entry-name)
          (expect-pass "deflate archive entry compression method" test-deflate-entry-compression)
          (expect-pass "deflate archive entry uncompressed size" test-deflate-entry-uncompressed-size)
          (expect-pass "stored archive entry name" test-stored-entry-name)
          (expect-pass "stored archive entry compression method" test-stored-entry-compression)
          (expect-pass "entries leaves content unset" test-content-unset)
          (expect-pass "meta reports format" test-meta-format)
          (expect-pass "meta reports entry count" test-meta-entry-count)
          (expect-pass "meta reports no comment" test-meta-no-comment)
          (expect-pass "directory entry is flagged" test-directory-entry-flagged)
          (expect-pass "file entry is not flagged as a directory" test-file-entry-not-flagged)))

      (list "errors"
        (list
          (expect-fail "rejects non-bytes argument" test-rejects-non-bytes "expects a bytes value")
          (expect-fail "rejects data that is not a ZIP file" test-rejects-not-a-zip "no end-of-central-directory")
          (expect-fail "rejects encrypted entries" test-rejects-encrypted "encrypted entries")
          (expect-fail "rejects Zip64 archives" test-rejects-zip64 "Zip64"))))))

  (export tests))
