; Tests for xlsx-decode.menai

(let ((xlsx-decode (import "xlsx-decode"))
      (zip-create (import "zip-create"))
      (t (import "menai-test")))
  (let ((decode (:: xlsx-decode decode))
        (create (:: zip-create create))
        (assert-equal (:: t assert-equal))
        (expect-pass (:: t expect-pass))
        (expect-fail (:: t expect-fail))
        (main-ns "http://schemas.openxmlformats.org/spreadsheetml/2006/main")
        (rels-ns "http://schemas.openxmlformats.org/package/2006/relationships")
        (worksheet-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet")
        (shared-strings-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings")
        (image-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/image")
        (workbook-xml
         (string->bytes
           (string-concat
             "<workbook xmlns=\""
             main-ns
             "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
             "<sheets>"
             "<sheet name=\"First\" sheetId=\"1\" r:id=\"rId1\"/>"
             "<sheet name=\"Second\" sheetId=\"2\" r:id=\"rId2\"/>"
             "</sheets></workbook>")))
        (workbook-rels-xml
         (string->bytes
           (string-concat
             "<Relationships xmlns=\""
             rels-ns
             "\"><Relationship Id=\"rId1\" Type=\""
             worksheet-rel
             "\" Target=\"worksheets/sheet1.xml\"/>"
             "<Relationship Id=\"rId2\" Type=\""
             worksheet-rel
             "\" Target=\"worksheets/sheet2.xml\"/>"
             "<Relationship Id=\"rId3\" Type=\""
             shared-strings-rel
             "\" Target=\"sharedStrings.xml\"/></Relationships>")))
        (sheet-xml
         (string->bytes
           (string-concat
             "<worksheet xmlns=\""
             main-ns
             "\"><sheetData><row r=\"1\"><c r=\"A1\" t=\"s\"><v>0</v></c></row></sheetData></worksheet>")))
        (sheet1-rels-xml
         (string->bytes
           (string-concat
             "<Relationships xmlns=\""
             rels-ns
             "\"><Relationship Id=\"rId1\" Type=\""
             image-rel
             "\" Target=\"../media/image1.png\"/></Relationships>")))
        (shared-strings-xml
         (string->bytes
           (string-concat
             "<sst xmlns=\""
             main-ns
             "\" count=\"2\" uniqueCount=\"2\"><si><t>Hello</t></si><si><t>World</t></si></sst>")))
        (styles-xml (string->bytes (string-concat "<styleSheet xmlns=\"" main-ns "\"/>")))
        (theme-xml (string->bytes (string-concat "<a:theme xmlns:a=\"" main-ns "\"/>")))
        (media-bytes (string-hex->bytes "89504e470d0a1a0a"))
        (workbook-empty-xml
         (string->bytes (string-concat "<workbook xmlns=\"" main-ns "\"><sheets/></workbook>")))
        (package-of
         (lambda (parts)
           (create (dict "entries"
                         (map-list (lambda (p) (dict "name" (list-first p) "content" (list-nth p 1)))
                                   parts)
                         "meta" (dict))))))
    (let ((minimal (create (dict "entries"
                                 (list (dict "name" "xl/workbook.xml" "content" workbook-empty-xml))
                                 "meta" (dict))))
          (full
           (create (dict "entries"
                         (list
                           (dict "name" "xl/workbook.xml" "content" workbook-xml)
                           (dict "name" "xl/_rels/workbook.xml.rels" "content" workbook-rels-xml)
                           (dict "name" "xl/worksheets/sheet1.xml" "content" sheet-xml)
                           (dict "name" "xl/worksheets/sheet2.xml" "content" sheet-xml)
                           (dict "name" "xl/worksheets/_rels/sheet1.xml.rels" "content" sheet1-rels-xml)
                           (dict "name" "xl/sharedStrings.xml" "content" shared-strings-xml)
                           (dict "name" "xl/styles.xml" "content" styles-xml)
                           (dict "name" "xl/theme/theme1.xml" "content" theme-xml)
                           (dict "name" "xl/media/image1.png" "content" media-bytes))
                         "meta" (dict))))
          (out-of-order
           (package-of
             (list
               (list "xl/workbook.xml"
                     (string->bytes
                       (string-concat
                         "<workbook xmlns=\"" main-ns
                         "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
                         "<sheets><sheet name=\"Only\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>")))
               (list "xl/_rels/workbook.xml.rels"
                     (string->bytes
                       (string-concat
                         "<Relationships xmlns=\"" rels-ns "\"><Relationship Id=\"rId1\" Type=\""
                         worksheet-rel "\" Target=\"worksheets/sheet2.xml\"/></Relationships>")))
               (list "xl/worksheets/sheet1.xml" sheet-xml)
               (list "xl/worksheets/sheet2.xml" sheet-xml))))
          (with-mode
           (package-of
             (list
               (list "xl/workbook.xml"
                     (string->bytes
                       (string-concat
                         "<workbook xmlns=\"" main-ns
                         "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
                         "<sheets><sheet name=\"Only\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>")))
               (list "xl/_rels/workbook.xml.rels"
                     (string->bytes
                       (string-concat
                         "<Relationships xmlns=\"" rels-ns "\"><Relationship Id=\"rId1\" Type=\""
                         worksheet-rel "\" Target=\"worksheets/sheet1.xml\" TargetMode=\"External\"/></Relationships>")))
               (list "xl/worksheets/sheet1.xml" sheet-xml)))))
      (let ((tests
        (list
          (list "package"
            (list
              (expect-pass "workbook part is decoded"
                           (lambda ()
                             (assert-equal (dict-get (decode full) "workbook")
                                           (dict "tag" "workbook"
                                                 "attrs" (dict "xmlns" main-ns
                                                               "xmlns:r" "http://schemas.openxmlformats.org/officeDocument/2006/relationships")
                                                 "children" (list (dict "tag" "sheets"
                                                                        "attrs" (dict)
                                                                        "children" (list (dict "tag" "sheet"
                                                                                               "attrs" (dict "name" "First" "sheetId" "1" "r:id" "rId1")
                                                                                               "children" (list))
                                                                                         (dict "tag" "sheet"
                                                                                               "attrs" (dict "name" "Second" "sheetId" "2" "r:id" "rId2")
                                                                                               "children" (list)))))))))
              (expect-pass "sheets is empty when there is no sheet list"
                           (lambda () (assert-equal (dict-get (decode minimal) "sheets") (list))))
              (expect-pass "shared-strings is #none when absent"
                           (lambda () (assert-equal (dict-get (decode minimal) "shared-strings") #none)))
              (expect-pass "styles is #none when absent"
                           (lambda () (assert-equal (dict-get (decode minimal) "styles") #none)))
              (expect-pass "theme is #none when absent"
                           (lambda () (assert-equal (dict-get (decode minimal) "theme") #none)))
              (expect-pass "media is #none when absent"
                           (lambda () (assert-equal (dict-get (decode minimal) "media") #none)))
              (expect-pass "relationships is empty when absent"
                           (lambda () (assert-equal (dict-get (decode minimal) "relationships") (dict))))))
          (list "sheets"
            (list
              (expect-pass "sheets are in workbook order"
                           (lambda ()
                             (assert-equal (map-list (lambda (s) (dict-get s "part"))
                                                     (dict-get (decode full) "sheets"))
                                           (list "xl/worksheets/sheet1.xml" "xl/worksheets/sheet2.xml"))))
              (expect-pass "a sheet carries its workbook name"
                           (lambda ()
                             (assert-equal (map-list (lambda (s) (dict-get s "name"))
                                                     (dict-get (decode full) "sheets"))
                                           (list "First" "Second"))))
              (expect-pass "a sheet carries its decoded element"
                           (lambda ()
                             (assert-equal (dict-get (dict-get (list-first (dict-get (decode full) "sheets")) "element") "tag")
                                           "worksheet")))
              (expect-pass "a sheet carries its own relationships"
                           (lambda ()
                             (assert-equal (dict-get (dict-get (list-first (dict-get (decode full) "sheets")) "relationships") "rId1")
                                           (dict "type" image-rel "target" "../media/image1.png" "mode" #none))))
              (expect-pass "a sheet with no relationships part has an empty map"
                           (lambda ()
                             (assert-equal (dict-get (list-nth (dict-get (decode full) "sheets") 1) "relationships")
                                           (dict))))
              (expect-pass "sheet order follows the sheet list, not the part names"
                           (lambda ()
                             (assert-equal (map-list (lambda (s) (dict-get s "part"))
                                                     (dict-get (decode out-of-order) "sheets"))
                                           (list "xl/worksheets/sheet2.xml"))))))
          (list "shared-strings"
            (list
              (expect-pass "shared strings are decoded in order"
                           (lambda ()
                             (assert-equal (map-list (lambda (si) (dict-get si "tag"))
                                                     (dict-get (decode full) "shared-strings"))
                                           (list "si" "si"))))
              (expect-pass "a shared string carries its decoded text"
                           (lambda ()
                             (assert-equal (dict-get (list-first (dict-get (decode full) "shared-strings")) "children")
                                           (list (dict "tag" "t" "attrs" (dict) "children" (list "Hello"))))))
              (expect-pass "a cell's shared-string value is not resolved"
                           (lambda ()
                             (assert-equal (dict-get (dict-get (list-first (dict-get (decode full) "sheets")) "element") "tag")
                                           "worksheet")))))
          (list "optional-parts"
            (list
              (expect-pass "styles is decoded when present"
                           (lambda () (assert-equal (dict-get (dict-get (decode full) "styles") "tag") "styleSheet")))
              (expect-pass "theme is decoded when present"
                           (lambda () (assert-equal (dict-get (dict-get (decode full) "theme") "tag") "a:theme")))
              (expect-pass "media is decoded to a dict of bytes"
                           (lambda () (assert-equal (dict-get (dict-get (decode full) "media") "xl/media/image1.png")
                                                    media-bytes)))))
          (list "relationships"
            (list
              (expect-pass "relationship id maps to a relationship dict"
                           (lambda ()
                             (assert-equal (dict-get (dict-get (decode full) "relationships") "rId1")
                                           (dict "type" worksheet-rel "target" "worksheets/sheet1.xml" "mode" #none))))
              (expect-pass "relationship target mode is preserved"
                           (lambda ()
                             (assert-equal (dict-get (dict-get (dict-get (decode with-mode) "relationships") "rId1") "mode")
                                           "External")))))
          (list "errors"
            (list
              (expect-fail "rejects a non-bytes argument"
                           (lambda () (decode "not a package"))
                           "expects a bytes value")
              (expect-fail "rejects a package with no workbook part"
                           (lambda () (decode (package-of (list (list "[Content_Types].xml"
                                                                     (string->bytes "<Types/>"))))))
                           "package has no xl/workbook.xml")
              (expect-fail "rejects a package whose workbook is not XML"
                           (lambda () (decode (package-of (list (list "xl/workbook.xml"
                                                                     (string->bytes "not xml"))))))
                           "xml-decode"))))))
        (export tests)))))
