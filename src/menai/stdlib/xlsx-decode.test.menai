; Tests for xlsx-decode.menai

(let ((xlsx-decode (import "xlsx-decode"))
      (zip-create (import "zip-create"))
      (t (import "menai-test"))
      (decode (:: xlsx-decode decode))
      (create (:: zip-create create))
      (assert-equal (:: t assert-equal))
      (expect-pass (:: t expect-pass))
      (expect-fail (:: t expect-fail))

      (main-ns "http://schemas.openxmlformats.org/spreadsheetml/2006/main")
      (rels-ns "http://schemas.openxmlformats.org/package/2006/relationships")
      (worksheet-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet")

      (shared-strings-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings")

      (image-rel "http://schemas.openxmlformats.org/officeDocument/2006/relationships/image")

      (workbook-xml
       (string->bytes
         (string-concat "<workbook xmlns=\""
                        main-ns
                        "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
                        "<sheets>"
                        "<sheet name=\"First\" sheetId=\"1\" r:id=\"rId1\"/>"
                        "<sheet name=\"Second\" sheetId=\"2\" r:id=\"rId2\"/>"
                        "</sheets></workbook>")))

      (workbook-rels-xml
       (string->bytes
         (string-concat "<Relationships xmlns=\""
                        rels-ns
                        "\"><Relationship Id=\"rId1\" Type=\""
                        worksheet-rel
                        "\" Target=\"worksheets/sheet1.xml\"/>"
                        "<Relationship Id=\"rId2\" Type=\""
                        worksheet-rel
                        "\" Target=\"worksheets/sheet2.xml\"/>"
                        "<Relationship Id=\"rId3\" Type=\""
                        shared-strings-rel
                        "\" Target=\"sharedStrings.xml\"/></Relationships>")))

      (sheet-xml
       (string->bytes
         (string-concat "<worksheet xmlns=\""
                        main-ns
                        "\"><sheetData><row r=\"1\"><c r=\"A1\" t=\"s\"><v>0</v></c></row></sheetData></worksheet>")))

      (sheet1-rels-xml
       (string->bytes
         (string-concat "<Relationships xmlns=\""
                        rels-ns
                        "\"><Relationship Id=\"rId1\" Type=\""
                        image-rel
                        "\" Target=\"../media/image1.png\"/></Relationships>")))

      (shared-strings-xml
       (string->bytes
         (string-concat "<sst xmlns=\""
                        main-ns
                        "\" count=\"2\" uniqueCount=\"2\"><si><t>Hello</t></si><si><t>World</t></si></sst>")))

      (styles-xml (string->bytes (string-concat "<styleSheet xmlns=\"" main-ns "\"/>")))
      (theme-xml (string->bytes (string-concat "<a:theme xmlns:a=\"" main-ns "\"/>")))
      (media-bytes (string-hex->bytes "89504e470d0a1a0a"))

      (workbook-empty-xml (string->bytes (string-concat "<workbook xmlns=\"" main-ns "\"><sheets/></workbook>")))

      ; Build a package from a list of (part-name content) pairs, with no metadata.
      (package-of
       (lambda (parts)
         (create
           (dict "entries" (map-list
                             (lambda (p)
                               (dict "name" (list-first p) "content" (list-nth p 1)))
                             parts)
                 "meta" (dict)))))

      (minimal
       (create (dict "entries" (list (dict "name" "xl/workbook.xml" "content" workbook-empty-xml)) "meta" (dict))))

      (full
       (create
         (dict "entries" (list
                           (dict "name" "xl/workbook.xml" "content" workbook-xml)
                           (dict "name" "xl/_rels/workbook.xml.rels" "content" workbook-rels-xml)
                           (dict "name" "xl/worksheets/sheet1.xml" "content" sheet-xml)
                           (dict "name" "xl/worksheets/sheet2.xml" "content" sheet-xml)
                           (dict "name" "xl/worksheets/_rels/sheet1.xml.rels" "content" sheet1-rels-xml)
                           (dict "name" "xl/sharedStrings.xml" "content" shared-strings-xml)
                           (dict "name" "xl/styles.xml" "content" styles-xml)
                           (dict "name" "xl/theme/theme1.xml" "content" theme-xml)
                           (dict "name" "xl/media/image1.png" "content" media-bytes))
               "meta" (dict))))

      (out-of-order
       (package-of
         (list
           (list
             "xl/workbook.xml"
             (string->bytes
               (string-concat "<workbook xmlns=\""
                              main-ns
                              "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
                              "<sheets><sheet name=\"Only\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>")))
           (list
             "xl/_rels/workbook.xml.rels"
             (string->bytes
               (string-concat "<Relationships xmlns=\""
                              rels-ns
                              "\"><Relationship Id=\"rId1\" Type=\""
                              worksheet-rel
                              "\" Target=\"worksheets/sheet2.xml\"/></Relationships>")))
           (list "xl/worksheets/sheet1.xml" sheet-xml)
           (list "xl/worksheets/sheet2.xml" sheet-xml))))

      (with-mode
       (package-of
         (list
           (list
             "xl/workbook.xml"
             (string->bytes
               (string-concat "<workbook xmlns=\""
                              main-ns
                              "\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
                              "<sheets><sheet name=\"Only\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>")))
           (list
             "xl/_rels/workbook.xml.rels"
             (string->bytes
               (string-concat "<Relationships xmlns=\""
                              rels-ns
                              "\"><Relationship Id=\"rId1\" Type=\""
                              worksheet-rel
                              "\" Target=\"worksheets/sheet1.xml\" TargetMode=\"External\"/></Relationships>")))
           (list "xl/worksheets/sheet1.xml" sheet-xml))))

      ; The workbook part is decoded as the xml-decode element tree of xl/workbook.xml.
      (test-workbook-part
       (lambda ()
         (assert-equal
           (dict-get (decode full) "workbook")
           (dict "tag" "workbook"
                 "attrs" (dict "xmlns" main-ns
                               "xmlns:r" "http://schemas.openxmlformats.org/officeDocument/2006/relationships")
                 "children" (list
                              (dict "tag" "sheets"
                                    "attrs" (dict)
                                    "children" (list
                                                 (dict "tag" "sheet"
                                                       "attrs" (dict "name" "First" "sheetId" "1" "r:id" "rId1")
                                                       "children" (list))
                                                 (dict "tag" "sheet"
                                                       "attrs" (dict "name" "Second" "sheetId" "2" "r:id" "rId2")
                                                       "children" (list)))))))))

      ; A workbook with no sheet list yields an empty sheets list.
      (test-sheets-empty
       (lambda ()
         (assert-equal (dict-get (decode minimal) "sheets") (list))))

      ; shared-strings is #none when the package has no sharedStrings part.
      (test-shared-strings-absent
       (lambda ()
         (assert-equal (dict-get (decode minimal) "shared-strings") #none)))

      ; styles is #none when the package has no styles part.
      (test-styles-absent
       (lambda ()
         (assert-equal (dict-get (decode minimal) "styles") #none)))

      ; theme is #none when the package has no theme part.
      (test-theme-absent
       (lambda ()
         (assert-equal (dict-get (decode minimal) "theme") #none)))

      ; media is #none when the package has no media parts.
      (test-media-absent
       (lambda ()
         (assert-equal (dict-get (decode minimal) "media") #none)))

      ; relationships is an empty map when the package has no workbook relationships part.
      (test-relationships-absent
       (lambda ()
         (assert-equal (dict-get (decode minimal) "relationships") (dict))))

      ; Sheets appear in workbook order, not part-name order.
      (test-sheets-in-workbook-order
       (lambda ()
         (assert-equal
           (map-list
             (lambda (s)
               (dict-get s "part"))
             (dict-get (decode full) "sheets"))
           (list "xl/worksheets/sheet1.xml" "xl/worksheets/sheet2.xml"))))

      ; Each sheet carries the name declared for it in the workbook.
      (test-sheet-carries-name
       (lambda ()
         (assert-equal
           (map-list
             (lambda (s)
               (dict-get s "name"))
             (dict-get (decode full) "sheets"))
           (list "First" "Second"))))

      ; Each sheet carries its decoded worksheet element.
      (test-sheet-carries-element
       (lambda ()
         (assert-equal
           (dict-get (dict-get (list-first (dict-get (decode full) "sheets")) "element") "tag")
           "worksheet")))

      ; A sheet carries the relationships from its own rels part.
      (test-sheet-carries-relationships
       (lambda ()
         (assert-equal
           (dict-get (dict-get (list-first (dict-get (decode full) "sheets")) "relationships") "rId1")
           (dict "type" image-rel "target" "../media/image1.png" "mode" #none))))

      ; A sheet with no rels part has an empty relationship map.
      (test-sheet-without-relationships
       (lambda ()
         (assert-equal (dict-get (list-nth (dict-get (decode full) "sheets") 1) "relationships") (dict))))

      ; Sheet order follows the workbook sheet list, not the worksheet part names.
      (test-sheet-order-follows-list
       (lambda ()
         (assert-equal
           (map-list
             (lambda (s)
               (dict-get s "part"))
             (dict-get (decode out-of-order) "sheets"))
           (list "xl/worksheets/sheet2.xml"))))

      ; Shared strings are decoded in document order.
      (test-shared-strings-in-order
       (lambda ()
         (assert-equal
           (map-list
             (lambda (si)
               (dict-get si "tag"))
             (dict-get (decode full) "shared-strings"))
           (list "si" "si"))))

      ; A shared string carries its decoded text children.
      (test-shared-string-carries-text
       (lambda ()
         (assert-equal
           (dict-get (list-first (dict-get (decode full) "shared-strings")) "children")
           (list (dict "tag" "t" "attrs" (dict) "children" (list "Hello"))))))

      ; A cell's shared-string value is left unresolved, not replaced by the string it indexes.
      (test-cell-shared-string-unresolved
       (lambda ()
         (assert-equal
           (dict-get (dict-get (list-first (dict-get (decode full) "sheets")) "element") "tag")
           "worksheet")))

      ; styles is decoded as an element tree when present.
      (test-styles-decoded
       (lambda ()
         (assert-equal (dict-get (dict-get (decode full) "styles") "tag") "styleSheet")))

      ; theme is decoded as an element tree when present.
      (test-theme-decoded
       (lambda ()
         (assert-equal (dict-get (dict-get (decode full) "theme") "tag") "a:theme")))

      ; media is decoded to a dict mapping each media part name to its bytes.
      (test-media-decoded
       (lambda ()
         (assert-equal (dict-get (dict-get (decode full) "media") "xl/media/image1.png") media-bytes)))

      ; Each relationship id maps to a dict carrying its type, target, and mode.
      (test-relationship-maps-to-dict
       (lambda ()
         (assert-equal
           (dict-get (dict-get (decode full) "relationships") "rId1")
           (dict "type" worksheet-rel "target" "worksheets/sheet1.xml" "mode" #none))))

      ; A relationship's target mode is preserved when present.
      (test-relationship-mode-preserved
       (lambda ()
         (assert-equal (dict-get (dict-get (dict-get (decode with-mode) "relationships") "rId1") "mode") "External")))

      ; A non-bytes argument is rejected.
      (test-rejects-non-bytes
       (lambda ()
         (decode "not a package")))

      ; A package with no workbook part is rejected.
      (test-rejects-no-workbook
       (lambda ()
         (decode (package-of (list (list "[Content_Types].xml" (string->bytes "<Types/>")))))))

      ; A workbook part that is not valid XML is rejected.
      (test-rejects-non-xml-workbook
       (lambda ()
         (decode (package-of (list (list "xl/workbook.xml" (string->bytes "not xml")))))))

      (tests
       (list
         (list
           "package"
           (list
             (expect-pass "workbook part is decoded" test-workbook-part)
             (expect-pass "sheets is empty when there is no sheet list" test-sheets-empty)
             (expect-pass "shared-strings is #none when absent" test-shared-strings-absent)
             (expect-pass "styles is #none when absent" test-styles-absent)
             (expect-pass "theme is #none when absent" test-theme-absent)
             (expect-pass "media is #none when absent" test-media-absent)
             (expect-pass "relationships is empty when absent" test-relationships-absent)))

         (list
           "sheets"
           (list
             (expect-pass "sheets are in workbook order" test-sheets-in-workbook-order)
             (expect-pass "a sheet carries its workbook name" test-sheet-carries-name)
             (expect-pass "a sheet carries its decoded element" test-sheet-carries-element)
             (expect-pass "a sheet carries its own relationships" test-sheet-carries-relationships)
             (expect-pass "a sheet with no relationships part has an empty map" test-sheet-without-relationships)
             (expect-pass "sheet order follows the sheet list, not the part names" test-sheet-order-follows-list)))

         (list
           "shared-strings"
           (list
             (expect-pass "shared strings are decoded in order" test-shared-strings-in-order)
             (expect-pass "a shared string carries its decoded text" test-shared-string-carries-text)
             (expect-pass "a cell's shared-string value is not resolved" test-cell-shared-string-unresolved)))

         (list
           "optional-parts"
           (list
             (expect-pass "styles is decoded when present" test-styles-decoded)
             (expect-pass "theme is decoded when present" test-theme-decoded)
             (expect-pass "media is decoded to a dict of bytes" test-media-decoded)))

         (list
           "relationships"
           (list
             (expect-pass "relationship id maps to a relationship dict" test-relationship-maps-to-dict)
             (expect-pass "relationship target mode is preserved" test-relationship-mode-preserved)))

         (list
           "errors"
           (list
             (expect-fail "rejects a non-bytes argument" test-rejects-non-bytes "expects a bytes value")
             (expect-fail "rejects a package with no workbook part"
                          test-rejects-no-workbook
                          "package has no xl/workbook.xml")
             (expect-fail "rejects a package whose workbook is not XML" test-rejects-non-xml-workbook "xml-decode"))))))

  (export tests))
