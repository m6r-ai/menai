; Sudoku solver using backtracking search with a most-constrained-cell order.
;
; The board is a vector of 9 rows, each a vector of 9 integers, and empty cells
; are 0, matching sudoku-vector-solver.menai.
;
; Two things make this search small.  Ordering: instead of filling the first
; empty cell in scan order, each node picks the empty cell with the fewest
; legal digits, so the branching factor is as low as it can be and a
; contradiction is usually found a few placements in.  State: the digits
; already placed in each row, column and box are carried down the search as
; nine-bit masks (digit d in bit d - 1), so the candidates for a cell are one
; mask computation rather than three scans and three set operations.
;
; Neither is much use without the other: the gain is in the node count, and
; bitmasks are what make the per-node ordering scan cheap enough to pay for
; itself.  Against sudoku-vector-solver.menai, which searches the same four
; benchmark puzzles in scan order with set-based candidates, the four cases
; together fall from about 933,000 search nodes to about 20,500, and from about
; 356 million executed bytecodes to about 9.9 million.  The node count is the
; figure to compare, since it is deterministic where wall-clock timing is not.

(let ((all-digits #x1ff)

      ; The candidate mask bit for digit `digit` (1..9).
      (digit-bit
       (lambda (digit)
         (integer-bit-shift-left 1 (integer- digit 1))))

      ; The flat box index 0..8 of the 3x3 box containing (row, col).
      (box-index
       (lambda (row col)
         (integer+ (integer* (integer/ row 3) 3) (integer/ col 3))))

      ; A 512-entry table mapping a candidate mask to the number of digits it
      ; holds.  Filled in ascending order so that the entry for (integer/ mask 2)
      ; is already present when it is read.
      (build-popcounts
       (lambda (mask table)
         (if (integer>=? mask 512)
             table
             (build-popcounts
               (integer+ mask 1)
               (vector-with table mask (integer+ (vector-nth table (integer/ mask 2)) (integer-bit-and mask 1)))))))

      (popcounts (build-popcounts 0 (vector-fill 512 0)))

      ; The digits that may legally be placed at (row, col).
      (cell-candidates
       (lambda (rows cols boxes row col)
         (integer-bit-and
           all-digits
           (integer-bit-not
             (integer-bit-or
               (vector-nth rows row)
               (integer-bit-or (vector-nth cols col) (vector-nth boxes (box-index row col))))))))

      ; Return (list flat-index candidate-mask) for the empty cell with the fewest
      ; candidates, preferring the earliest such cell.
      ;
      ; The scan returns as soon as it meets a cell with a single candidate, since
      ; no cell can have fewer.  A candidate mask of 0 means the position is
      ; already contradictory, and there is no point trying digits.
      (most-constrained
       (lambda (rows cols boxes empties best-index best-mask best-count)
         (if (list-null? empties)
             (list best-index best-mask)
             (let ((at (list-first empties))

                   (candidates
                    (cell-candidates
                      rows
                      cols
                      boxes
                      (integer/ (list-first empties) 9)
                      (integer% (list-first empties) 9))))

               (let ((count (vector-nth popcounts candidates)))
                 (if (integer<? count best-count)
                     (if (integer=? count 1)
                         (list at candidates)
                         (most-constrained rows cols boxes (list-rest empties) at candidates count))
                     (most-constrained rows cols boxes (list-rest empties) best-index best-mask best-count)))))))

      ; Return a new board with `digit` placed at (row, col).
      (set-cell
       (lambda (board row col digit)
         (vector-with board row (vector-with (vector-nth board row) col digit))))

      ; Try every candidate digit for the cell at flat index `at`, in ascending
      ; digit order.  Returns the solved board, or #none if every candidate fails.
      (try-digits
       (lambda (board rows cols boxes empties at candidates digit)
         (if (integer>? digit 9)
             #none
             (if (integer=? (integer-bit-and candidates (digit-bit digit)) 0)
                 (try-digits board rows cols boxes empties at candidates (integer+ digit 1))
                 (let ((row (integer/ at 9))
                       (col (integer% at 9))
                       (box (box-index (integer/ at 9) (integer% at 9))))
                   (let ((solved
                          (solve-from
                            (set-cell board row col digit)
                            (vector-with rows row (integer-bit-or (vector-nth rows row) (digit-bit digit)))
                            (vector-with cols col (integer-bit-or (vector-nth cols col) (digit-bit digit)))
                            (vector-with boxes box (integer-bit-or (vector-nth boxes box) (digit-bit digit)))
                            (list-without empties at))))
                     (if (none? solved)
                         (try-digits board rows cols boxes empties at candidates (integer+ digit 1))
                         solved)))))))

      ; Solve by backtracking with the empty cells `empties` still to fill.
      ; Returns the solved board, or #none if the position has no solution.
      (solve-from
       (lambda (board rows cols boxes empties)
         (if (list-null? empties)
             board
             (let ((choice (most-constrained rows cols boxes empties 0 0 10)))
               (if (integer=? (list-nth choice 1) 0)
                   #none
                   (try-digits board rows cols boxes empties (list-first choice) (list-nth choice 1) 1))))))

      ; Return (list rows cols boxes empties) for a board: the digit masks of every
      ; row, column and box, and the flat indices of the empty cells in scan order.
      (board-state
       (lambda (board index rows cols boxes empties)
         (if (integer>=? index 81)
             (list rows cols boxes empties)
             (let ((row (integer/ index 9))
                   (col (integer% index 9))
                   (value (vector-nth (vector-nth board (integer/ index 9)) (integer% index 9))))
               (if (integer=? value 0)
                   (board-state board (integer+ index 1) rows cols boxes (list-append empties index))
                   (board-state
                     board
                     (integer+ index 1)
                     (vector-with rows row (integer-bit-or (vector-nth rows row) (digit-bit value)))
                     (vector-with cols col (integer-bit-or (vector-nth cols col) (digit-bit value)))
                     (vector-with
                       boxes
                       (box-index row col)
                       (integer-bit-or (vector-nth boxes (box-index row col)) (digit-bit value)))
                     empties))))))

      ; Solve the board by backtracking.  Returns the solved board or #none.
      (solve
       (lambda (board)
         (let ((state (board-state board 0 (vector-fill 9 0) (vector-fill 9 0) (vector-fill 9 0) (list))))
           (solve-from board (list-nth state 0) (list-nth state 1) (list-nth state 2) (list-nth state 3)))))

      ; Format one cell: digit (or "." for empty) followed by a column separator.
      (format-cell
       (lambda (col value)
         (string-concat
           (if (integer=? value 0)
               "."
               (integer->string value))
           (if (integer=? (integer% (integer+ col 1) 3) 0)
               " | "
               " "))))

      ; Format the cells of one row, in column order.
      (format-cells
       (lambda (row col acc)
         (if (integer>=? col 9)
             acc
             (format-cells row (integer+ col 1) (string-concat acc (format-cell col (vector-nth row col)))))))

      ; Format every row of the board, appending a divider after every third row.
      (format-rows
       (lambda (board row acc)
         (if (integer>=? row 9)
             acc
             (format-rows
               board
               (integer+ row 1)
               (string-concat
                 acc
                 (string-concat
                   "| "
                   (string-concat
                     (format-cells (vector-nth board row) 0 "")
                     (if (integer=? (integer% (integer+ row 1) 3) 0)
                         "\n+-------+-------+-------+\n"
                         "\n"))))))))

      ; Render a complete board as a printable string.
      (display-board
       (lambda (board)
         (string-concat "+-------+-------+-------+\n" (format-rows board 0 "")))))

  (export solve display-board))
