; Rubik's Cube Solver in Menai (vector variant)
; Uses IDA* algorithm with heuristic based on misplaced stickers
;
; Vector variant of the list-based rubiks_cube.menai: each face is a vector
; of 9 stickers, so get-sticker is O(1) vector-nth and each move constructs
; new faces as contiguous vectors instead of linked lists.
;
; Cube representation: cube-repr struct with 6 face fields (U D F B L R), each a vector of 9 stickers (0-5)
; Face order: U(up/white), D(down/yellow), F(front/green), B(back/blue), L(left/orange), R(right/red)
; Sticker positions on each face:
;   0 1 2
;   3 4 5
;   6 7 8
; Center (position 4) never moves and identifies the face color
;
; A move is a `move` struct of a `face` and a `turn`.  The `face` enum names the
; six faces and the `turn` enum the three quarter-turn amounts, so a move is a
; closed, typed value rather than a string.  `move->string` renders a move in the
; standard notation ("U", "U'", "U2").

(letrec
  ((cube-repr (struct (U D F B L R)))
   (search-result (struct (found value)))

   (face (enum (u d f b l r)))
   (turn (enum (cw ccw half)))
   (move (struct (face turn)))

   (solved-cube
     (lambda ()
       (cube-repr
         (vector 0 0 0 0 0 0 0 0 0)
         (vector 1 1 1 1 1 1 1 1 1)
         (vector 2 2 2 2 2 2 2 2 2)
         (vector 3 3 3 3 3 3 3 3 3)
         (vector 4 4 4 4 4 4 4 4 4)
         (vector 5 5 5 5 5 5 5 5 5))))

   (get-sticker
     (lambda (face pos)
       (vector-nth face pos)))

   (rotate-face-cw
     (lambda (face)
       (vector
         (get-sticker face 6)
         (get-sticker face 3)
         (get-sticker face 0)
         (get-sticker face 7)
         (get-sticker face 4)
         (get-sticker face 1)
         (get-sticker face 8)
         (get-sticker face 5)
         (get-sticker face 2))))

   (move-U
     (lambda (cube)
       (let* ((u (struct-get cube 'U))
              (f (struct-get cube 'F))
              (r (struct-get cube 'R))
              (b (struct-get cube 'B))
              (l (struct-get cube 'L)))
         (cube-repr
           (rotate-face-cw u)
           (struct-get cube 'D)
           (vector (get-sticker r 0) (get-sticker r 1) (get-sticker r 2)
                   (get-sticker f 3) (get-sticker f 4) (get-sticker f 5)
                   (get-sticker f 6) (get-sticker f 7) (get-sticker f 8))
           (vector (get-sticker l 0) (get-sticker l 1) (get-sticker l 2)
                   (get-sticker b 3) (get-sticker b 4) (get-sticker b 5)
                   (get-sticker b 6) (get-sticker b 7) (get-sticker b 8))
           (vector (get-sticker f 0) (get-sticker f 1) (get-sticker f 2)
                   (get-sticker l 3) (get-sticker l 4) (get-sticker l 5)
                   (get-sticker l 6) (get-sticker l 7) (get-sticker l 8))
           (vector (get-sticker b 0) (get-sticker b 1) (get-sticker b 2)
                   (get-sticker r 3) (get-sticker r 4) (get-sticker r 5)
                   (get-sticker r 6) (get-sticker r 7) (get-sticker r 8))))))

   (move-D
     (lambda (cube)
       (let* ((d (struct-get cube 'D))
              (f (struct-get cube 'F))
              (r (struct-get cube 'R))
              (b (struct-get cube 'B))
              (l (struct-get cube 'L)))
         (cube-repr
           (struct-get cube 'U)
           (rotate-face-cw d)
           (vector (get-sticker f 0) (get-sticker f 1) (get-sticker f 2)
                   (get-sticker f 3) (get-sticker f 4) (get-sticker f 5)
                   (get-sticker l 6) (get-sticker l 7) (get-sticker l 8))
           (vector (get-sticker b 0) (get-sticker b 1) (get-sticker b 2)
                   (get-sticker b 3) (get-sticker b 4) (get-sticker b 5)
                   (get-sticker r 6) (get-sticker r 7) (get-sticker r 8))
           (vector (get-sticker l 0) (get-sticker l 1) (get-sticker l 2)
                   (get-sticker l 3) (get-sticker l 4) (get-sticker l 5)
                   (get-sticker b 6) (get-sticker b 7) (get-sticker b 8))
           (vector (get-sticker r 0) (get-sticker r 1) (get-sticker r 2)
                   (get-sticker r 3) (get-sticker r 4) (get-sticker r 5)
                   (get-sticker f 6) (get-sticker f 7) (get-sticker f 8))))))

   (move-F
     (lambda (cube)
       (let* ((f (struct-get cube 'F))
              (u (struct-get cube 'U))
              (r (struct-get cube 'R))
              (d (struct-get cube 'D))
              (l (struct-get cube 'L)))
         (cube-repr
           (vector (get-sticker u 0) (get-sticker u 1) (get-sticker u 2)
                   (get-sticker u 3) (get-sticker u 4) (get-sticker u 5)
                   (get-sticker l 8) (get-sticker l 5) (get-sticker l 2))
           (vector (get-sticker r 0) (get-sticker r 3) (get-sticker r 6)
                   (get-sticker d 3) (get-sticker d 4) (get-sticker d 5)
                   (get-sticker d 6) (get-sticker d 7) (get-sticker d 8))
           (rotate-face-cw f)
           (struct-get cube 'B)
           (vector (get-sticker l 0) (get-sticker l 1) (get-sticker d 2)
                   (get-sticker l 3) (get-sticker l 4) (get-sticker d 1)
                   (get-sticker l 6) (get-sticker l 7) (get-sticker d 0))
           (vector (get-sticker u 6) (get-sticker r 1) (get-sticker r 2)
                   (get-sticker u 7) (get-sticker r 4) (get-sticker r 5)
                   (get-sticker u 8) (get-sticker r 7) (get-sticker r 8))))))

   (move-B
     (lambda (cube)
       (let* ((b (struct-get cube 'B))
              (u (struct-get cube 'U))
              (l (struct-get cube 'L))
              (d (struct-get cube 'D))
              (r (struct-get cube 'R)))
         (cube-repr
           (vector (get-sticker r 8) (get-sticker r 5) (get-sticker r 2)
                   (get-sticker u 3) (get-sticker u 4) (get-sticker u 5)
                   (get-sticker u 6) (get-sticker u 7) (get-sticker u 8))
           (vector (get-sticker d 0) (get-sticker d 1) (get-sticker d 2)
                   (get-sticker d 3) (get-sticker d 4) (get-sticker d 5)
                   (get-sticker l 6) (get-sticker l 3) (get-sticker l 0))
           (struct-get cube 'F)
           (rotate-face-cw b)
           (vector (get-sticker u 2) (get-sticker l 1) (get-sticker l 2)
                   (get-sticker u 1) (get-sticker l 4) (get-sticker l 5)
                   (get-sticker u 0) (get-sticker l 7) (get-sticker l 8))
           (vector (get-sticker r 0) (get-sticker r 1) (get-sticker d 6)
                   (get-sticker r 3) (get-sticker r 4) (get-sticker d 7)
                   (get-sticker r 6) (get-sticker r 7) (get-sticker d 8))))))

   (move-L
     (lambda (cube)
       (let* ((l (struct-get cube 'L))
              (u (struct-get cube 'U))
              (f (struct-get cube 'F))
              (d (struct-get cube 'D))
              (b (struct-get cube 'B)))
         (cube-repr
           (vector (get-sticker b 8) (get-sticker u 1) (get-sticker u 2)
                   (get-sticker b 5) (get-sticker u 4) (get-sticker u 5)
                   (get-sticker b 2) (get-sticker u 7) (get-sticker u 8))
           (vector (get-sticker f 0) (get-sticker d 1) (get-sticker d 2)
                   (get-sticker f 3) (get-sticker d 4) (get-sticker d 5)
                   (get-sticker f 6) (get-sticker d 7) (get-sticker d 8))
           (vector (get-sticker u 0) (get-sticker f 1) (get-sticker f 2)
                   (get-sticker u 3) (get-sticker f 4) (get-sticker f 5)
                   (get-sticker u 6) (get-sticker f 7) (get-sticker f 8))
           (vector (get-sticker b 0) (get-sticker b 1) (get-sticker d 6)
                   (get-sticker b 3) (get-sticker b 4) (get-sticker d 3)
                   (get-sticker b 6) (get-sticker b 7) (get-sticker d 0))
           (rotate-face-cw l)
           (struct-get cube 'R)))))

   (move-R
     (lambda (cube)
       (let* ((r (struct-get cube 'R))
              (u (struct-get cube 'U))
              (b (struct-get cube 'B))
              (d (struct-get cube 'D))
              (f (struct-get cube 'F)))
         (cube-repr
           (vector (get-sticker u 0) (get-sticker u 1) (get-sticker f 2)
                   (get-sticker u 3) (get-sticker u 4) (get-sticker f 5)
                   (get-sticker u 6) (get-sticker u 7) (get-sticker f 8))
           (vector (get-sticker d 0) (get-sticker d 1) (get-sticker b 6)
                   (get-sticker d 3) (get-sticker d 4) (get-sticker b 3)
                   (get-sticker d 6) (get-sticker d 7) (get-sticker b 0))
           (vector (get-sticker f 0) (get-sticker f 1) (get-sticker d 2)
                   (get-sticker f 3) (get-sticker f 4) (get-sticker d 5)
                   (get-sticker f 6) (get-sticker f 7) (get-sticker d 8))
           (vector (get-sticker u 8) (get-sticker b 1) (get-sticker b 2)
                   (get-sticker u 5) (get-sticker b 4) (get-sticker b 5)
                   (get-sticker u 2) (get-sticker b 7) (get-sticker b 8))
           (struct-get cube 'L)
           (rotate-face-cw r)))))

   ; Apply a turn to a cube by repeating the face's clockwise rotation: once for
   ; cw, three times for ccw (the inverse of cw), twice for half.
   (turn-apply
     (lambda (rotate-cw cube t)
       (match t
         ((: turn 'cw) (rotate-cw cube))
         ((: turn 'ccw) (rotate-cw (rotate-cw (rotate-cw cube))))
         ((: turn 'half) (rotate-cw (rotate-cw cube))))))

   (apply-move
     (lambda (cube m)
       (let ((t (struct-get m 'turn)))
         (match (struct-get m 'face)
           ((: face 'u) (turn-apply move-U cube t))
           ((: face 'd) (turn-apply move-D cube t))
           ((: face 'f) (turn-apply move-F cube t))
           ((: face 'b) (turn-apply move-B cube t))
           ((: face 'l) (turn-apply move-L cube t))
           ((: face 'r) (turn-apply move-R cube t))))))

   (apply-moves
     (lambda (cube moves)
       (if (list-null? moves)
           cube
           (apply-moves (apply-move cube (list-first moves)) (list-rest moves)))))

   (face-solved?
     (lambda (face)
       (let ((center (get-sticker face 4)))
         (all-vector? (lambda (s) (integer=? s center)) face))))

   (cube-solved?
     (lambda (cube)
       (and (face-solved? (struct-get cube 'U))
            (face-solved? (struct-get cube 'D))
            (face-solved? (struct-get cube 'F))
            (face-solved? (struct-get cube 'B))
            (face-solved? (struct-get cube 'L))
            (face-solved? (struct-get cube 'R)))))

   (count-mismatched
     (lambda (face)
       (count-mismatch-loop face (vector-nth face 4) 0 0)))

   (count-mismatch-loop
     (lambda (face center i acc)
       (if (integer>=? i 9)
           acc
           (count-mismatch-loop
             face
             center
             (integer+ i 1)
             (if (integer!=? (vector-nth face i) center)
                 (integer+ acc 1)
                 acc)))))

   (heuristic
     (lambda (cube)
       (let ((total (integer+
                      (count-mismatched (struct-get cube 'U))
                      (count-mismatched (struct-get cube 'D))
                      (count-mismatched (struct-get cube 'F))
                      (count-mismatched (struct-get cube 'B))
                      (count-mismatched (struct-get cube 'L))
                      (count-mismatched (struct-get cube 'R)))))
         (integer/ total 8))))

   ; Every move, in face-major order (all three turns of U, then D, and so on).
   (all-moves
     (list
       (move (face 'u) (turn 'cw)) (move (face 'u) (turn 'ccw)) (move (face 'u) (turn 'half))
       (move (face 'd) (turn 'cw)) (move (face 'd) (turn 'ccw)) (move (face 'd) (turn 'half))
       (move (face 'f) (turn 'cw)) (move (face 'f) (turn 'ccw)) (move (face 'f) (turn 'half))
       (move (face 'b) (turn 'cw)) (move (face 'b) (turn 'ccw)) (move (face 'b) (turn 'half))
       (move (face 'l) (turn 'cw)) (move (face 'l) (turn 'ccw)) (move (face 'l) (turn 'half))
       (move (face 'r) (turn 'cw)) (move (face 'r) (turn 'ccw)) (move (face 'r) (turn 'half))))

   (same-face?
     (lambda (m1 m2)
       (enum=? (struct-get m1 'face) (struct-get m2 'face))))

   ; The inverse of a move is the same face with the opposite turn: cw and ccw
   ; swap, and half is its own inverse.
   (inverse-move
     (lambda (m)
       (move (struct-get m 'face)
             (match (struct-get m 'turn)
               ((: turn 'cw) (turn 'ccw))
               ((: turn 'ccw) (turn 'cw))
               ((: turn 'half) (turn 'half))))))

   (should-prune?
     (lambda (move last-move)
       (or (same-face? move last-move)
           (struct=? move (inverse-move last-move)))))

   (get-candidates
     (lambda (last-move)
       (if (boolean? last-move)
           all-moves
           (filter-list (lambda (m) (boolean-not (should-prune? m last-move))) all-moves))))

   (search-moves
     (lambda (cube bound g last-move path moves best-threshold)
       (if (list-null? moves)
           (search-result #f (if (boolean? best-threshold) (integer+ bound 1) best-threshold))
           (let* ((move     (list-first moves))
                  (new-cube (apply-move cube move))
                  (new-path (list-concat path (list move)))
                  (result   (ida-search new-cube bound (integer+ g 1) move new-path)))
             (if (struct-get result 'found)
                 result
                 (search-moves cube bound g last-move path (list-rest moves)
                   (if (boolean? best-threshold)
                       (struct-get result 'value)
                       (integer-min best-threshold (struct-get result 'value)))))))))

   (ida-search
     (lambda (cube bound g last-move path)
       (let ((h (heuristic cube)))
         (if (cube-solved? cube)
             (search-result #t path)
             (if (integer>? (integer+ g h) bound)
                 (search-result #f (integer+ g h))
                 (search-moves cube bound g last-move path (get-candidates last-move) #f))))))

   (ida-star
     (lambda (cube max-depth)
       (letrec ((search-loop
                  (lambda (bound)
                    (if (integer>? bound max-depth)
                        (search-result #f "Max depth exceeded")
                        (let ((result (ida-search cube bound 0 #f (list))))
                          (if (struct-get result 'found)
                              result
                              (search-loop (struct-get result 'value))))))))
         (search-loop 0))))

   (sticker->str
     (lambda (s)
       (match s
         (0 "W") (1 "Y") (2 "G") (3 "B") (4 "O") (5 "R") (_ "?"))))

   (face-row->str
     (lambda (face row)
       (let ((start (integer* row 3)))
         (string-concat
           (sticker->str (get-sticker face start))
           (sticker->str (get-sticker face (integer+ start 1)))
           (sticker->str (get-sticker face (integer+ start 2)))))))

   (print-cube
     (lambda (cube)
       (let ((u (struct-get cube 'U))
             (d (struct-get cube 'D))
             (f (struct-get cube 'F))
             (b (struct-get cube 'B))
             (l (struct-get cube 'L))
             (r (struct-get cube 'R)))
         (string-concat
           "    " (face-row->str u 0) "\n"
           "    " (face-row->str u 1) "\n"
           "    " (face-row->str u 2) "\n"
           (face-row->str l 0) " " (face-row->str f 0) " " (face-row->str r 0) " " (face-row->str b 0) "\n"
           (face-row->str l 1) " " (face-row->str f 1) " " (face-row->str r 1) " " (face-row->str b 1) "\n"
           (face-row->str l 2) " " (face-row->str f 2) " " (face-row->str r 2) " " (face-row->str b 2) "\n"
           "    " (face-row->str d 0) "\n"
           "    " (face-row->str d 1) "\n"
           "    " (face-row->str d 2) "\n"))))

   ; Render a move in the standard notation: the face letter followed by "" for a
   ; clockwise turn, "'" for a counter-clockwise turn, or "2" for a half turn.
   (move->string
     (lambda (m)
       (string-concat
         (match (struct-get m 'face)
           ((: face 'u) "U") ((: face 'd) "D") ((: face 'f) "F")
           ((: face 'b) "B") ((: face 'l) "L") ((: face 'r) "R"))
         (match (struct-get m 'turn)
           ((: turn 'cw) "") ((: turn 'ccw) "'") ((: turn 'half) "2")))))

   (format-solution
     (lambda (result)
       (if (struct-get result 'found)
           (string-concat "Solution found! Moves: "
                          (list->string (map-list move->string (struct-get result 'value)) " "))
           (string-concat "No solution: " (struct-get result 'value)))))

   (make-cube
     (lambda (u d f b l r)
       (cube-repr u d f b l r))))

  (export face turn move solved-cube apply-move apply-moves cube-solved? heuristic
          ida-star print-cube move->string format-solution make-cube all-moves))
