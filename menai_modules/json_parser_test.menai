; Tests for json_parser.menai

(let ((json (import "json_parser"))
      (t (import "menai_test")))
  (let ((parse (json parse))
        (assert-equal (t assert-equal))
        (expect-pass (t test)))
    (let ((tests
      (list
        ; Tests for objects
        (list "objects"
          (list
            (expect-pass "empty object"
                         (lambda () (assert-equal (parse "{}") (dict))))
            (expect-pass "single key"
                         (lambda () (assert-equal (parse "{\"a\": 1}") (dict "a" 1))))
            (expect-pass "nested object"
                         (lambda () (assert-equal (parse "{\"a\": {\"b\": 2}}")
                                                  (dict "a" (dict "b" 2)))))))

        ; Tests for arrays
        (list "arrays"
          (list
            (expect-pass "empty array"
                         (lambda () (assert-equal (parse "[]") (list))))
            (expect-pass "integer array"
                         (lambda () (assert-equal (parse "[1, 2, 3]") (list 1 2 3))))
            (expect-pass "nested array"
                         (lambda () (assert-equal (parse "[[1, 2], [3, 4]]")
                                                  (list (list 1 2) (list 3 4)))))))

        ; Tests for strings
        (list "strings"
          (list
            (expect-pass "empty string"
                         (lambda () (assert-equal (parse "\"\"") "")))
            (expect-pass "simple string"
                         (lambda () (assert-equal (parse "\"hello\"") "hello")))
            (list "escapes"
              (list
                (expect-pass "newline"
                             (lambda () (assert-equal (parse "\"\\n\"") "\n")))
                (expect-pass "tab"
                             (lambda () (assert-equal (parse "\"\\t\"") "\t")))
                (expect-pass "unicode"
                             (lambda () (assert-equal (parse "\"\\u0041\"") "A")))))))

        ; Tests for numbers
        (list "numbers"
          (list
            (expect-pass "integer"
                         (lambda () (assert-equal (parse "42") 42)))
            (expect-pass "negative integer"
                         (lambda () (assert-equal (parse "-7") -7)))
            (expect-pass "float"
                         (lambda () (assert-equal (parse "3.14") 3.14)))))

        ; Tests for literals
        (list "literals"
          (list
            (expect-pass "true"
                         (lambda () (assert-equal (parse "true") #t)))
            (expect-pass "false"
                         (lambda () (assert-equal (parse "false") #f)))
            (expect-pass "null"
                         (lambda () (assert-equal (parse "null") #none))))))))

      (export tests))))
