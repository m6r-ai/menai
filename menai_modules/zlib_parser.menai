; zlib parser module — decompresses a zlib stream (RFC 1950).
;
; Exports: "decompress" — takes a bytes value containing a complete zlib stream
; (2-byte header, DEFLATE data, 4-byte Adler-32 trailer) and returns the
; decompressed bytes.
;
; A zlib stream is:
;   - CMF byte: bits 0-3 are the compression method (must be 8 = DEFLATE),
;     bits 4-7 are the window size exponent (CINFO).
;   - FLG byte: bits 0-4 are a check value, bit 5 is the preset-dictionary
;     flag, bits 6-7 are the compression level.
;   - the DEFLATE data (handed to inflate).
;   - a 4-byte big-endian Adler-32 checksum of the uncompressed data.
;
; The header check is that (CMF * 256 + FLG) is a multiple of 31.  The Adler-32
; trailer is verified against the decompressed data.
;
; Preset dictionaries (FDICT set) are not supported and raise an error.

(letrec
  ((inflate-lib (import "inflate"))
   (adler32
    (lambda (b)
      (let ((modulus 65521))
        (letrec ((loop (lambda (i a bb)
                         (if (integer>=? i (bytes-length b))
                             (integer-bit-or (integer-bit-shift-left bb 16) a)
                             (loop (integer+ i 1)
                                   (integer% (integer+ a (bytes-ref b i)) modulus)
                                   (integer% (integer+ bb a (bytes-ref b i)) modulus))))))
          (loop 0 1 0)))))

   (check-header
    (lambda (b)
      (let ((cmf (bytes-ref b 0))
            (flg (bytes-ref b 1)))
        (if (integer!=? (integer-bit-and cmf #x0f) 8)
            (error (string-concat
                     "Unsupported zlib stream: compression method "
                     (integer->string (integer-bit-and cmf #x0f))
                     " is not DEFLATE (8)"))
            (if (integer!=? (integer% (integer+ (integer* cmf 256) flg) 31) 0)
                (error "Malformed zlib stream: header check failed")
                (if (integer=? (integer-bit-and flg #x20) #x20)
                    (error "Unsupported zlib stream: preset dictionaries are not supported")
                    #t))))))

   (decompress
    (lambda (b)
      (if (bytes? b)
          (if (integer<? (bytes-length b) 6)
              (error "Not a zlib stream: too short")
              (if (check-header b)
                  (let ((inflate (:: inflate-lib inflate)))
                    (let ((data (inflate (bytes-slice b 2 (integer- (bytes-length b) 4)))))
                      (let ((expected (bytes-read-u32-be b (integer- (bytes-length b) 4)))
                            (actual (adler32 data)))
                        (if (integer=? expected actual)
                            data
                            (error (string-concat
                                     "zlib stream checksum mismatch: expected "
                                     (integer->string expected)
                                     " but computed "
                                     (integer->string actual)))))))
                  (error "Malformed zlib stream: header check failed")))
          (error "zlib_parser: decompress expects a bytes value")))))

  (export decompress))
