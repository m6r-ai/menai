; Tests for zip-entries.menai

(let ((zip-mod (import "zip-entries"))
      (t (import "menai_test")))
  (let ((entries (:: zip-mod entries))
        (assert-equal (:: t assert-equal))
        (expect-pass (:: t test))
        (expect-fail (:: t test-error)))
    (let ((tests (list
       (list "entries"
         (list
           (expect-pass "deflate archive entry count"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                            (assert-equal (dict-get (dict-get r "meta") "entry-count") 1))))
           (expect-pass "deflate archive entry name"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                            (assert-equal (dict-get (list-first (dict-get r "entries")) "name") "hello.txt"))))
           (expect-pass "deflate archive entry compression method"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                            (assert-equal (dict-get (list-first (dict-get r "entries")) "compression") 8))))
           (expect-pass "deflate archive entry uncompressed size"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                            (assert-equal (dict-get (list-first (dict-get r "entries")) "uncompressed-size") 11))))
           (expect-pass "stored archive entry name"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes "504b030414000000000007542f5df1080d9b040000000400000005000000612e74787441414141504b0102140314000000000007542f5df1080d9b0400000004000000050000000000000000000000800100000000612e747874504b0506000000000100010033000000270000000000"))))
                            (assert-equal (dict-get (list-first (dict-get r "entries")) "name") "a.txt"))))
           (expect-pass "stored archive entry compression method"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes "504b030414000000000007542f5df1080d9b040000000400000005000000612e74787441414141504b0102140314000000000007542f5df1080d9b0400000004000000050000000000000000000000800100000000612e747874504b0506000000000100010033000000270000000000"))))
                            (assert-equal (dict-get (list-first (dict-get r "entries")) "compression") 0))))
           (expect-pass "entries leaves content unset"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                            (assert-equal (dict-get (list-first (dict-get r "entries")) "content") #none))))
           (expect-pass "meta reports format"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes ""))))
                            (assert-equal (dict-get (dict-get r "meta") "format") "zip"))))
           (expect-pass "meta reports entry count"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes ""))))
                            (assert-equal (dict-get (dict-get r "meta") "entry-count") 2))))
           (expect-pass "meta reports no comment"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes ""))))
                            (assert-equal (dict-get (dict-get r "meta") "comment") #none))))
           (expect-pass "directory entry is flagged"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes ""))))
                            (assert-equal (dict-get (list-first (dict-get r "entries")) "is-directory") #t))))
           (expect-pass "file entry is not flagged as a directory"
                        (lambda ()
                          (let ((r (entries (string-hex->bytes ""))))
                            (assert-equal (dict-get (list-ref (dict-get r "entries") 1) "is-directory") #f))))))

       (list "errors"
         (list
           (expect-fail "rejects non-bytes argument"
                        (lambda ()
                          (entries "not bytes"))
                        "expects a bytes value")
           (expect-fail "rejects data that is not a ZIP file"
                        (lambda ()
                          (entries (string-hex->bytes "000000000000000000000000000000000000000000000000")))
                        "no end-of-central-directory")
           (expect-fail "rejects encrypted entries"
                        (lambda ()
                          (entries (string-hex->bytes "504b03041400000000008f542f5d63f3f3ad040000000400000005000000782e74787464617461504b010214031400010000008f542f5d63f3f3ad0400000004000000050000000000000000000000800100000000782e747874504b0506000000000100010033000000270000000000")))
                        "encrypted entries")
           (expect-fail "rejects Zip64 archives"
                        (lambda ()
                          (entries (string-hex->bytes "504b03041400000000008f542f5d63f3f3ad040000000400000005000000792e74787464617461504b010214031400000000008f542f5d63f3f3ad0400000004000000050000000000000000000000800100000000792e747874504b0506000000000100ffff33000000270000000000")))
                        "Zip64"))))))

      (export tests))))
