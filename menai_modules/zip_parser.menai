; ZIP parser module — reads the central directory of a ZIP archive.
;
; Exports:
;   "parse"   — takes a bytes value containing a ZIP file and returns a dict
;               describing its entries without decompressing them:
;
;     (dict
;       "entries" (list of entry dicts, in central-directory order)
;       "meta"    (dict "format" "zip" "entry-count" ... "comment" ...))
;
;   "extract" — takes a bytes value containing a ZIP file and returns the same
;               dict as "parse" but with each entry's "content" field filled in
;               with the decompressed bytes (or #none for entries that are not
;               extracted).
;
; Each entry dict is:
;
;   (dict
;     "name" <string>               ; entry name (UTF-8)
;     "compression" <integer>       ; 0 = stored, 8 = deflate
;     "crc32" <integer>
;     "compressed-size" <integer>
;     "uncompressed-size" <integer>
;     "data-offset" <integer>       ; absolute offset of the entry's data
;     "is-directory" <boolean>      ; #t when the name ends with "/"
;     "content" <bytes> or #none)
;
; The parser reads the End Of Central Directory record, then walks the central
; directory.  It does not scan local file headers from the front, because the
; central directory is the authoritative index (local headers may have zeroed
; sizes when the data-descriptor flag is set).
;
; Supported: stored (method 0) and deflate (method 8) entries.  Zip64 archives,
; encrypted entries, and any other compression method raise a runtime error.
; Filenames are decoded as UTF-8.

(letrec
  ((inflate-lib (import "inflate"))
   (signature-eocd (string-hex->bytes "504b0506"))
   (signature-central (string-hex->bytes "504b0102"))
   (signature-local (string-hex->bytes "504b0304"))

   ; Find the offset of the End Of Central Directory record.  The EOCD is at
   ; the end of the file, possibly followed by a comment of up to 65535 bytes,
   ; so we search backwards from the end for its signature.
   (find-eocd
    (lambda (b)
      (let ((len (bytes-length b)))
        (letrec ((loop (lambda (pos)
                         (if (integer<? pos 0)
                             (error "Not a ZIP file: no end-of-central-directory record found")
                             (if (bytes-prefix? (bytes-slice b pos (integer-min len (integer+ pos 4)))
                                                signature-eocd)
                                 pos
                                 (loop (integer- pos 1)))))))
          (loop (integer- len 22))))))

   ; Read the End Of Central Directory record at `eocd`.  Returns a dict with
   ; the entry count and the central directory's offset and size.
   (read-eocd
    (lambda (b eocd)
      (let ((total (bytes-read-u16-le b (integer+ eocd 10)))
            (cd-size (bytes-read-u32-le b (integer+ eocd 12)))
            (cd-offset (bytes-read-u32-le b (integer+ eocd 16)))
            (comment-length (bytes-read-u16-le b (integer+ eocd 20))))
        (if (or (integer=? cd-offset #xffffffff)
                (integer=? cd-size #xffffffff)
                (integer=? total #xffff))
            (error "Unsupported ZIP: Zip64 archives are not supported")
            (dict
              "entry-count" total
              "central-offset" cd-offset
              "central-size" cd-size
              "comment" (if (integer=? comment-length 0)
                            #none
                            (bytes->string (bytes-slice b (integer+ eocd 22)
                                                        (integer+ eocd 22 comment-length)))))))))

   ; Parse one central directory entry at `pos`.  Returns a dict with the entry
   ; fields and the offset immediately after the entry.
   (read-central-entry
    (lambda (b pos)
      (if (boolean-not (bytes-prefix? (bytes-slice b pos (integer+ pos 4)) signature-central))
          (error "Malformed ZIP: bad central directory entry signature")
          (let ((flags (bytes-read-u16-le b (integer+ pos 8)))
                (method (bytes-read-u16-le b (integer+ pos 10)))
                (crc (bytes-read-u32-le b (integer+ pos 16)))
                (compressed-size (bytes-read-u32-le b (integer+ pos 20)))
                (uncompressed-size (bytes-read-u32-le b (integer+ pos 24)))
                (name-length (bytes-read-u16-le b (integer+ pos 28)))
                (extra-length (bytes-read-u16-le b (integer+ pos 30)))
                (comment-length (bytes-read-u16-le b (integer+ pos 32)))
                (local-offset (bytes-read-u32-le b (integer+ pos 42))))
            (if (integer=? (integer-bit-and flags 1) 1)
                (error "Unsupported ZIP: encrypted entries are not supported")
                (let ((name-start (integer+ pos 46))
                      (name-end (integer+ pos 46 name-length)))
                  (let ((name (bytes->string (bytes-slice b name-start name-end))))
                    (list
                      (dict
                        "name" name
                        "compression" method
                        "crc32" crc
                        "compressed-size" compressed-size
                        "uncompressed-size" uncompressed-size
                        "local-offset" local-offset
                        "is-directory" (string-suffix? name "/"))
                      (integer+ name-end extra-length comment-length)))))))))

   ; Walk the central directory, collecting entries.  Returns a list of entry
   ; dicts in central-directory order.
   (read-central-directory
    (lambda (b offset count)
      (letrec ((loop (lambda (pos remaining acc)
                       (if (integer=? remaining 0)
                           (list-reverse acc)
                           (let ((result (read-central-entry b pos)))
                             (loop (list-ref result 1)
                                   (integer- remaining 1)
                                   (list-prepend acc (list-first result))))))))
        (loop offset count (list)))))

   ; Compute the absolute offset of an entry's data from its local file header.
   ; The local header repeats the filename and extra-field lengths, which may
   ; differ from the central directory's, so we read them from the local header.
   (data-offset-of
    (lambda (b local-offset)
      (if (boolean-not (bytes-prefix? (bytes-slice b local-offset (integer+ local-offset 4)) signature-local))
          (error "Malformed ZIP: bad local file header signature")
          (let ((name-length (bytes-read-u16-le b (integer+ local-offset 26)))
                (extra-length (bytes-read-u16-le b (integer+ local-offset 28))))
            (integer+ local-offset 30 name-length extra-length)))))

   ; Add a "data-offset" field to an entry dict.
   (with-data-offset
    (lambda (b entry)
      (dict-set entry "data-offset"
                (data-offset-of b (dict-get entry "local-offset")))))

   ; Decompress one entry's data, returning the bytes.  Only stored and deflate
   ; are supported.
   (entry-content
    (lambda (b entry inflate)
      (let ((method (dict-get entry "compression"))
            (start (dict-get entry "data-offset"))
            (size (dict-get entry "compressed-size")))
        (let ((raw (bytes-slice b start (integer+ start size))))
          (let ((content
                 (if (integer=? method 0)
                     raw
                     (if (integer=? method 8)
                         (inflate raw)
                         (error (string-concat
                                  "Unsupported ZIP: compression method "
                                  (integer->string method)
                                  " is not supported (only stored and deflate)"))))))
            (let ((expected (dict-get entry "crc32"))
                  (actual (bytes-crc32 content)))
              (if (integer=? expected actual)
                  content
                  (error (string-concat
                           "ZIP entry \""
                           (dict-get entry "name")
                           "\" checksum mismatch: expected "
                           (integer->string expected)
                           " but computed "
                           (integer->string actual))))))))))

   ; Build the top-level result dict from a list of entries.
   (build-result
    (lambda (entries comment)
      (dict
        "entries" entries
        "meta" (dict
                 "format" "zip"
                 "entry-count" (list-length entries)
                 "comment" comment))))

   ; Shared implementation of parse and extract.  When `want-content` is #t,
   ; each entry's "content" is filled in; otherwise it is #none.
   (parse-impl
    (lambda (b want-content)
      (if (bytes? b)
          (let ((eocd (find-eocd b)))
            (let ((header (read-eocd b eocd)))
              (let ((entries (map-list (lambda (e) (with-data-offset b e))
                                       (read-central-directory
                                         b
                                         (dict-get header "central-offset")
                                         (dict-get header "entry-count")))))
                (if want-content
                    (let ((inflate (:: inflate-lib inflate)))
                      (build-result
                        (map-list (lambda (e)
                                    (dict-set e "content"
                                              (if (dict-get e "is-directory")
                                                  #none
                                                  (entry-content b e inflate))))
                                  entries)
                        (dict-get header "comment")))
                    (build-result
                      (map-list (lambda (e) (dict-set e "content" #none)) entries)
                      (dict-get header "comment"))))))
          (error "zip_parser: expects a bytes value"))))

   (parse
    (lambda (b)
      (parse-impl b #f)))

   (extract
    (lambda (b)
      (parse-impl b #t))))

  (export parse extract))
