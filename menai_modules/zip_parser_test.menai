; Tests for zip_parser.menai

(let ((zip-mod (import "zip_parser"))
      (t (import "menai_test")))
  (let ((parse (dict-get zip-mod "parse"))
        (extract (dict-get zip-mod "extract"))
        (assert-equal (dict-get t "assert-equal"))
        (test (dict-get t "test"))
        (test-error (dict-get t "test-error")))
    (dict "tests"
      (list
        (list "parse"
          (list
            (test "deflate archive entry count"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                      (assert-equal (dict-get (dict-get r "meta") "entry-count") 1))))
            (test "deflate archive entry name"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                      (assert-equal (dict-get (list-first (dict-get r "entries")) "name") "hello.txt"))))
            (test "deflate archive entry compression method"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                      (assert-equal (dict-get (list-first (dict-get r "entries")) "compression") 8))))
            (test "deflate archive entry uncompressed size"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                      (assert-equal (dict-get (list-first (dict-get r "entries")) "uncompressed-size") 11))))
            (test "stored archive entry name"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "504b030414000000000007542f5df1080d9b040000000400000005000000612e74787441414141504b0102140314000000000007542f5df1080d9b0400000004000000050000000000000000000000800100000000612e747874504b0506000000000100010033000000270000000000"))))
                      (assert-equal (dict-get (list-first (dict-get r "entries")) "name") "a.txt"))))
            (test "stored archive entry compression method"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "504b030414000000000007542f5df1080d9b040000000400000005000000612e74787441414141504b0102140314000000000007542f5df1080d9b0400000004000000050000000000000000000000800100000000612e747874504b0506000000000100010033000000270000000000"))))
                      (assert-equal (dict-get (list-first (dict-get r "entries")) "compression") 0))))
            (test "parse leaves content unset"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                      (assert-equal (dict-get (list-first (dict-get r "entries")) "content") #none))))
            (test "meta reports format"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes ""))))
                      (assert-equal (dict-get (dict-get r "meta") "format") "zip"))))
            (test "meta reports entry count"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes ""))))
                      (assert-equal (dict-get (dict-get r "meta") "entry-count") 2))))
            (test "meta reports no comment"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes ""))))
                      (assert-equal (dict-get (dict-get r "meta") "comment") #none))))
            (test "directory entry is flagged"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes ""))))
                      (assert-equal (dict-get (list-first (dict-get r "entries")) "is-directory") #t))))
            (test "file entry is not flagged as a directory"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes ""))))
                      (assert-equal (dict-get (list-ref (dict-get r "entries") 1) "is-directory") #f))))))

        (list "extract"
          (list
            (test "deflate entry is decompressed"
                  (lambda ()
                    (let ((r (extract (string-hex->bytes "504b030414000000080007542f5d85114a0d0d0000000b0000000900000068656c6c6f2e747874cb48cdc9c95728cf2fca490100504b0102140314000000080007542f5d85114a0d0d0000000b00000009000000000000000000000080010000000068656c6c6f2e747874504b0506000000000100010037000000340000000000"))))
                      (assert-equal (bytes->string (dict-get (list-first (dict-get r "entries")) "content")) "hello world"))))
            (test "stored entry is returned verbatim"
                  (lambda ()
                    (let ((r (extract (string-hex->bytes "504b030414000000000007542f5df1080d9b040000000400000005000000612e74787441414141504b0102140314000000000007542f5df1080d9b0400000004000000050000000000000000000000800100000000612e747874504b0506000000000100010033000000270000000000"))))
                      (assert-equal (bytes->string (dict-get (list-first (dict-get r "entries")) "content")) "AAAA"))))
            (test "directory entry has no content"
                  (lambda ()
                    (let ((r (extract (string-hex->bytes ""))))
                      (assert-equal (dict-get (list-first (dict-get r "entries")) "content") #none))))
            (test "nested file content"
                  (lambda ()
                    (let ((r (extract (string-hex->bytes ""))))
                      (assert-equal (bytes->string (dict-get (list-ref (dict-get r "entries") 1) "content")) "nested content"))))))

        (list "errors"
          (list
            (test-error "rejects non-bytes argument"
                  (lambda ()
                    (parse "not bytes"))
                  "expects a bytes value")
            (test-error "rejects data that is not a ZIP file"
                  (lambda ()
                    (parse (string-hex->bytes "000000000000000000000000000000000000000000000000")))
                  "no end-of-central-directory")
            (test-error "rejects encrypted entries"
                  (lambda ()
                    (parse (string-hex->bytes "504b03041400000000008f542f5d63f3f3ad040000000400000005000000782e74787464617461504b010214031400010000008f542f5d63f3f3ad0400000004000000050000000000000000000000800100000000782e747874504b0506000000000100010033000000270000000000")))
                  "encrypted entries")
            (test-error "rejects Zip64 archives"
                  (lambda ()
                    (parse (string-hex->bytes "504b03041400000000008f542f5d63f3f3ad040000000400000005000000792e74787464617461504b010214031400000000008f542f5d63f3f3ad0400000004000000050000000000000000000000800100000000792e747874504b0506000000000100ffff33000000270000000000")))
                  "Zip64")))))))
