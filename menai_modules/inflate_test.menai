; Tests for inflate.menai

(let ((inflate-mod (import "inflate"))
      (t (import "menai_test")))
  (let ((inflate (:: inflate-mod inflate))
        (assert-equal (:: t assert-equal))
        (expect-pass (:: t test))
        (expect-fail (:: t test-error)))
     (let ((tests (list
        (list "stored blocks"
          (list
            (expect-pass "empty stream"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "010000ffff"))
                                         (string->bytes ""))))
            (expect-pass "single byte"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "010100feff41"))
                                         (string->bytes "A"))))
            (expect-pass "hello"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "010500faff68656c6c6f"))
                                         (string->bytes "hello"))))
            (expect-pass "abc"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "010300fcff616263"))
                                         (string->bytes "abc"))))
            (expect-pass "run of repeated bytes"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "010a00f5ff61616161616161616161"))
                                         (string->bytes "aaaaaaaaaa"))))
            (expect-pass "multiple stored blocks with an empty sync-flush block"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes
                                           "000500faff68656c6c6f000000ffff010500faff776f726c64"))
                                         (string->bytes "helloworld"))))))

        (list "fixed Huffman blocks"
          (list
            (expect-pass "single literal"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "730400"))
                                         (string->bytes "A"))))
            (expect-pass "literal run with back-reference"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "cb48cdc9c957c8409000"))
                                         (string->bytes "hello hello hello"))))
            (expect-pass "repeated pattern"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "4b4c4a4e042300"))
                                         (string->bytes "abcabcabc"))))
            (expect-pass "overlapping back-reference replicates a run"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "abaaa23d0000"))
                                         (string->bytes "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"))))
            (expect-pass "overlapping back-reference replicates a two-byte pattern"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes "4b4c4aa4390400"))
                                         (string->bytes "abababababababababababababababababababababababababababababababababababababababababababababababababab"))))
            (expect-pass "text with several back-references"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes
                                           "2bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a70300"))
                                         (string->bytes "the quick brown fox jumps over the lazy dog"))))))

        (list "dynamic Huffman blocks"
          (list
            (expect-pass "skewed alphabet"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes
                                           "0dcc090e80200c04c0b76eb70710a18209515faff38011a307d0455eed1a88b456d09c48ad59170fbd1290ad4123dd6759e329187b7a95ee82f1e050484b042af3b69770c87f21b94faa7d"))
                                         (string->bytes "becfgaambbzdmdgagoejhajfcaodioircldsoaabvdgceccffqhrnyhanvqfibmfbanyaldabjoagaicoxezcafabdgaaocvpcde"))))
            (expect-pass "zero runs exercise repeat codes"
                         (lambda ()
                           (assert-equal (inflate (string-hex->bytes
                                           ""))
                                         (string-hex->bytes
                                           ""))))))

        (list "errors"
          (list
            (expect-fail "rejects non-bytes argument"
                         (lambda ()
                           (inflate "not bytes"))
                         "expects a bytes value")
            (expect-fail "rejects truncated input"
                         (lambda ()
                           (inflate (string-hex->bytes "000500faff6865")))
                         "unexpected end of input")
            (expect-fail "rejects stored block with mismatched LEN and NLEN"
                         (lambda ()
                           (inflate (string-hex->bytes "010500000068656c6c6f")))
                         "LEN does not match NLEN")
            (expect-fail "rejects invalid block type"
                         (lambda ()
                           (inflate (string-hex->bytes "07")))
                         "invalid block type"))))))

      (export tests))))
