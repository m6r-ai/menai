; Tests for png_parser.menai

(let ((png-mod (import "png_parser"))
      (t (import "menai_test")))
  (let ((parse (dict-get png-mod "parse"))
        (assert-equal (dict-get t "assert-equal"))
        (test (dict-get t "test"))
        (test-error (dict-get t "test-error")))
    (dict "tests"
      (list
        (list "header"
          (list
            (test "header fields"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000001249444154789c63f8cfc0c000c20cff8100001fee05fb0bd9688b0000000049454e44ae426082"))))
                      (assert-equal (dict-get r "header") (dict "width" 2 "height" 2 "bit-depth" 8 "colour-type" 2 "compression" 0 "filter" 0 "interlace" 0)))))
            (test "meta reports format and channels"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000001249444154789c63f8cfc0c000c20cff8100001fee05fb0bd9688b0000000049454e44ae426082"))))
                      (assert-equal (dict-get r "meta") (dict "format" "png" "channels" 3)))))
            (test "rgba reports four channels"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d240000001a49444154789c6360646266616563e760e0e4e2e6e1e5e3170000036600896df92a510000000049454e44ae426082"))))
                      (assert-equal (dict-get r "meta") (dict "format" "png" "channels" 4)))))
          ))
        (list "pixels"
          (list
            (test "RGB pixels with no filter"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000001249444154789c63f8cfc0c000c20cff8100001fee05fb0bd9688b0000000049454e44ae426082"))))
                      (assert-equal (dict-get r "pixels") (vector (vector (vector 255 0 0) (vector 0 255 0)) (vector (vector 0 0 255) (vector 255 255 255)))))))
            (test "RGB pixels with Sub filter"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "89504e470d0a1a0a0000000d49484452000000030000000208020000001216f14d0000001d49444154789c6314b8fdfd7bdfd72faa698c82bf968bb60a7e88e807006d3d0a125189346b0000000049454e44ae426082"))))
                      (assert-equal (dict-get r "pixels") (vector (vector (vector 16 219 247) (vector 7 105 236) (vector 251 142 82)) (vector (vector 17 250 167) (vector 38 127 184) (vector 22 215 71)))))))
            (test "RGBA pixels include alpha"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d240000001a49444154789c6360646266616563e760e0e4e2e6e1e5e3170000036600896df92a510000000049454e44ae426082"))))
                      (assert-equal (dict-get r "pixels") (vector (vector (vector 1 2 3 4) (vector 5 6 7 8)) (vector (vector 9 10 11 12) (vector 13 14 15 16)))))))
            (test "RGB pixels with Paeth filter"
                  (lambda ()
                    (let ((r (parse (string-hex->bytes "89504e470d0a1a0a0000000d49484452000000040000000308020000003b9639910000003249444154789c012700d8ff044d85335ad1da2b7a1962707d04a5619f7880d004d838fbbbf5043783aae801b4c0b95167f402574a1278fd80e0a70000000049454e44ae426082"))))
                      (assert-equal (dict-get r "pixels") (vector (vector (vector 77 133 51) (vector 167 86 13) (vector 210 208 38) (vector 52 64 163)) (vector (vector 242 230 210) (vector 106 102 162) (vector 171 168 218) (vector 47 251 207)) (vector (vector 41 105 124) (vector 17 103 48) (vector 42 97 129) (vector 145 156 131)))))))
          ))
        (list "errors"
          (list
            (test-error "rejects non-bytes argument"
                  (lambda ()
                    (parse "not bytes"))
                  "expects a bytes value")
            (test-error "rejects a bad signature"
                  (lambda ()
                    (parse (string-hex->bytes "00000000000000006a756e6b")))
                  "missing PNG signature")
            (test-error "rejects unsupported bit depth"
                  (lambda ()
                    (parse (string-hex->bytes "89504e470d0a1a0a0000000d4948445200000002000000021002000000ad4446300000001249444154789c63f8cfc0c000c20cff8100001fee05fb0bd9688b0000000049454e44ae426082")))
                  "bit depth 16")
            (test-error "rejects unsupported colour type"
                  (lambda ()
                    (parse (string-hex->bytes "89504e470d0a1a0a0000000d494844520000000200000002080000000057dd52f80000000e49444154789c6310506030700000017600a1ec308af40000000049454e44ae426082")))
                  "colour type 0")
            (test-error "rejects interlaced images"
                  (lambda ()
                    (parse (string-hex->bytes "89504e470d0a1a0a0000000d49484452000000020000000208020000018ad3aae50000001249444154789c63f8cfc0c000c20cff8100001fee05fb0bd9688b0000000049454e44ae426082")))
                  "interlaced")))))))
