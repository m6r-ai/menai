; Tests for deflate.menai

(let ((deflate-mod (import "deflate"))
      (inflate-mod (import "inflate"))
      (t (import "menai_test")))
  (let ((deflate (:: deflate-mod deflate))
        (inflate (:: inflate-mod inflate))
        (assert-equal (:: t assert-equal))
        (expect-pass (:: t test))
        (expect-fail (:: t test-error)))
    (letrec
      ((round-trip
        (lambda (text mode)
          (let ((input (string->bytes text)))
            (bytes->string (inflate (deflate input mode))))))
       (round-trip-bytes
        (lambda (input mode)
          (bytes=? (inflate (deflate input mode)) input)))
       (repeat
        (lambda (unit count)
          (list->string (map-list (lambda (i) unit) (range 0 count))))))
       (let ((tests (list
          (list "round-trip through inflate"
            (list
              (expect-pass "empty input, all modes"
                           (lambda ()
                             (and (assert-equal (round-trip "" "stored") "")
                                  (and (assert-equal (round-trip "" "fixed") "")
                                       (and (assert-equal (round-trip "" "dynamic") "")
                                            (assert-equal (round-trip "" "auto") ""))))))
              (expect-pass "single byte, all modes"
                           (lambda ()
                             (and (assert-equal (round-trip "A" "stored") "A")
                                  (and (assert-equal (round-trip "A" "fixed") "A")
                                       (and (assert-equal (round-trip "A" "dynamic") "A")
                                            (assert-equal (round-trip "A" "auto") "A"))))))
              (expect-pass "short text, all modes"
                           (lambda ()
                             (and (assert-equal (round-trip "hello" "stored") "hello")
                                  (and (assert-equal (round-trip "hello" "fixed") "hello")
                                       (and (assert-equal (round-trip "hello" "dynamic") "hello")
                                            (assert-equal (round-trip "hello" "auto") "hello"))))))
              (expect-pass "repetitive text exercises back-references"
                           (lambda ()
                             (and (assert-equal (round-trip "hello hello hello" "stored") "hello hello hello")
                                  (and (assert-equal (round-trip "hello hello hello" "fixed") "hello hello hello")
                                       (and (assert-equal (round-trip "hello hello hello" "dynamic") "hello hello hello")
                                            (assert-equal (round-trip "hello hello hello" "auto") "hello hello hello"))))))
              (expect-pass "long run of a single byte"
                           (lambda ()
                             (let ((text (repeat "a" 500)))
                               (and (assert-equal (round-trip text "fixed") text)
                                    (assert-equal (round-trip text "dynamic") text)))))
              (expect-pass "repeating two-byte pattern"
                           (lambda ()
                             (let ((text (repeat "ab" 200)))
                               (and (assert-equal (round-trip text "fixed") text)
                                    (assert-equal (round-trip text "dynamic") text)))))
              (expect-pass "skewed alphabet favours dynamic coding"
                           (lambda ()
                             (let ((text (list->string
                                           (map-list (lambda (i) (if (integer=? (integer% i 10) 0) "b" "a"))
                                                     (range 0 300)))))
                               (and (assert-equal (round-trip text "dynamic") text)
                                    (assert-equal (round-trip text "auto") text)))))
              (expect-pass "all byte values round-trip"
                           (lambda ()
                             (let ((input (list->bytes (range 0 256))))
                               (and (assert-equal (round-trip-bytes input "stored") #t)
                                    (and (assert-equal (round-trip-bytes input "fixed") #t)
                                         (and (assert-equal (round-trip-bytes input "dynamic") #t)
                                              (assert-equal (round-trip-bytes input "auto") #t)))))))
              (expect-pass "auto round-trips a range of lengths"
                           (lambda ()
                             (and (assert-equal (round-trip "x" "auto") "x")
                                  (and (assert-equal (round-trip "xyz" "auto") "xyz")
                                       (and (assert-equal (round-trip "abcdefghijklmnop" "auto") "abcdefghijklmnop")
                                            (assert-equal (round-trip "the quick brown fox jumps over the lazy dog" "auto")
                                                          "the quick brown fox jumps over the lazy dog"))))))))

          (list "block type selection"
            (list
              (expect-pass "stored mode emits a stored block"
                           (lambda ()
                             (let ((stream (deflate (string->bytes "abc") "stored")))
                               (assert-equal (integer-bit-and (bytes-ref stream 0) 6) 0))))
              (expect-pass "fixed mode emits a fixed Huffman block"
                           (lambda ()
                             (let ((stream (deflate (string->bytes "abc") "fixed")))
                               (assert-equal (integer-bit-shift-right (integer-bit-and (bytes-ref stream 0) 6) 1) 1))))
              (expect-pass "dynamic mode emits a dynamic Huffman block"
                           (lambda ()
                             (let ((stream (deflate (string->bytes "abc") "dynamic")))
                               (assert-equal (integer-bit-shift-right (integer-bit-and (bytes-ref stream 0) 6) 1) 2))))
              (expect-pass "every mode sets the final-block bit"
                           (lambda ()
                             (and (assert-equal (integer-bit-and (bytes-ref (deflate (string->bytes "abc") "stored") 0) 1) 1)
                                  (and (assert-equal (integer-bit-and (bytes-ref (deflate (string->bytes "abc") "fixed") 0) 1) 1)
                                       (assert-equal (integer-bit-and (bytes-ref (deflate (string->bytes "abc") "dynamic") 0) 1) 1)))))
              (expect-pass "auto never exceeds the smallest single-mode output"
                           (lambda ()
                             (let ((input (string->bytes "hello hello hello hello hello")))
                               (let ((auto (bytes-length (deflate input "auto")))
                                     (stored (bytes-length (deflate input "stored")))
                                     (fixed (bytes-length (deflate input "fixed")))
                                     (dynamic (bytes-length (deflate input "dynamic"))))
                                 (assert-equal (integer<=? auto (integer-min stored (integer-min fixed dynamic))) #t)))))))

          (list "compression"
            (list
              (expect-pass "repetitive input compresses below its original size"
                           (lambda ()
                             (let ((input (string->bytes (repeat "a" 1000))))
                               (and (assert-equal (integer<? (bytes-length (deflate input "fixed")) 1000) #t)
                                    (assert-equal (integer<? (bytes-length (deflate input "dynamic")) 1000) #t)))))
              (expect-pass "stored output carries the original bytes verbatim"
                           (lambda ()
                             (let ((input (string->bytes "hello world")))
                               (let ((stream (deflate input "stored")))
                                 (assert-equal (bytes-index stream input) 5)))))))

          (list "errors"
            (list
              (expect-fail "rejects non-bytes argument"
                           (lambda ()
                             (deflate "not bytes"))
                           "expects a bytes value")
              (expect-fail "rejects unknown mode"
                           (lambda ()
                             (deflate (string->bytes "abc") "bogus"))
                           "unknown mode")
              (expect-fail "rejects non-string mode"
                           (lambda ()
                             (deflate (string->bytes "abc") 42))
                           "mode must be a string"))))))

      (export tests)))))
